---
// Importing necessary components
import Meta from '@components/Meta.astro';
import Navbar from '@components/sections/navbar&footer/Navbar.astro';
import FooterSection from '@components/sections/navbar&footer/FooterSection.astro';
import Analytics from '@vercel/analytics/astro';
import { SITE } from '@data/constants';
import '@styles/global.css';

// GA4 measurement ID is provided via PUBLIC_GA_MEASUREMENT_ID env var
const GA_MEASUREMENT_ID = import.meta.env.PUBLIC_GA_MEASUREMENT_ID ?? null;

// Setting expected props
const {
  title = SITE.title,
  meta,
  structuredData,
  post = null,
  preloadImage = null,
  lang = 'en',
  customDescription = null,
  customOgTitle = null,
  hideFooter = false,
  fullWidth = false,
  overlayNav = false,
} = Astro.props;

// Interface to type-check the properties
interface Props {
  title?: string;
  meta?: string;
  structuredData?: object;
  post?: any;
  preloadImage?: string | null;
  lang?: string;
  customDescription?: string | null;
  customOgTitle?: string | null;
  hideFooter?: boolean;
  fullWidth?: boolean;
  overlayNav?: boolean;
}
---

<html lang={lang} class="scrollbar-hide lenis lenis-smooth scroll-pt-16">
  <head>
    {/* Adding metadata to the HTML document */}
    <Meta
      meta={meta}
      structuredData={structuredData}
      customDescription={customDescription}
      customOgTitle={customOgTitle}
      post={post}
      preloadImage={preloadImage}
    />
    {
      /* Google Analytics 4 (optional) - inject when PUBLIC_GA_MEASUREMENT_ID is set */
    }
    {
      GA_MEASUREMENT_ID && (
        <>
          <script
            async
            src={`https://www.googletagmanager.com/gtag/js?id=${GA_MEASUREMENT_ID}`}
          />
          <script
            set:html={`window.dataLayer=window.dataLayer||[];function gtag(){dataLayer.push(arguments);}gtag('js', new Date());gtag('config','${GA_MEASUREMENT_ID}');`}
          />
        </>
      )
    }
    {/* Title is set in Meta component */}

    <script>
      import '@scripts/lenisSmoothScroll.js';
      import '@scripts/demoForms.js';
      import '@scripts/contactForm.js';
      import '@scripts/careerForm.js';
      import '@scripts/heroVideo.js';
    </script>
  </head>
  <body
    class="relative flex min-h-screen flex-col bg-[#E8F0FF] text-neutral-900 selection:bg-[#0039E6] selection:text-neutral-50"
  >
    <a
      href="#main-content"
      class="sr-only focus:not-sr-only focus:absolute focus:top-4 focus:left-4 focus:z-100 focus:rounded-lg focus:bg-[#1E3AFF] focus:px-4 focus:py-2 focus:text-neutral-50"
    >
      Skip to content
    </a>

    {
      /*
    Setting up the main structure of the page.
    The Navbar is placed at the top, with a slot for the main content and FooterSection at the bottom.
    */
    }
    <div
      class:list={[
        'relative z-10 w-full grow',
        !fullWidth && 'mx-auto max-w-(--breakpoint-2xl) px-4 sm:px-6 lg:px-8',
      ]}
    >
      <Navbar overlay={overlayNav} />
      <main id="main-content">
        <slot />
      </main>
    </div>
    {!hideFooter && <FooterSection />}
    <Analytics />
    <script>
      // https://preline.co
      import 'preline';
      const init = () =>
        (
          window as Window & { HSStaticMethods?: { autoInit?: () => void } }
        ).HSStaticMethods?.autoInit?.();
      if (document.readyState === 'loading')
        document.addEventListener('DOMContentLoaded', init);
      else init();
    </script>
    <style>
      /* CSS rules for the page scrollbar */
      .scrollbar-hide::-webkit-scrollbar {
        display: none;
      }

      .scrollbar-hide {
        -ms-overflow-style: none;
        scrollbar-width: none;
      }
    </style>
  </body>
</html>
