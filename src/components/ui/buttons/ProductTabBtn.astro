---
// Destructure the properties from Astro.props
const { id, dataTab, title, first } = Astro.props;

// Define TypeScript interface for the properties
interface Props {
  id: string;
  dataTab: string;
  title: string;
  first?: boolean;
}
// Define constants for styling classes
const BUTTON_CLASS =
  'flex w-full justify-center rounded-2xl border border-transparent p-3 outline-hidden ring-zinc-500 transition duration-300 hover:bg-[#E8F0FF] focus-visible:ring-3 md:p-5';

const HEADING_CLASS = 'block text-center font-bold';
const INACTIVE_HEADING_CLASS = 'text-neutral-800';
---

{/* Tab button element */}
<button
  type="button"
  class={`${BUTTON_CLASS} ${first ? 'active bg-[#E8F0FF] hover:border-transparent' : ''}`}
  id={id}
  data-target={dataTab}
  role="tab"
>
  {/* Tab text */}
  <span
    class={`${HEADING_CLASS} ${first ? 'text-[#1E3AFF]' : INACTIVE_HEADING_CLASS}`}
  >
    {title}
  </span>
</button>
