---
import Icon from '@components/ui/icons/Icon.astro';
const { title, url } = Astro.props;

interface Props {
  title?: string;
  url?: string;
}

const baseClasses =
  'group inline-flex items-center justify-center gap-x-3 rounded-xl px-4 py-3 text-center text-sm font-medium text-white ring-zinc-500 focus-visible:ring-3 transition duration-300 outline-hidden';
const borderClasses = 'border border-transparent';
const bgColorClasses = 'bg-[#1E3AFF]';
const hoverClasses = 'hover:bg-[#1632E0] hover:shadow-[0_20px_45px_-25px_rgba(30,58,255,0.75)]';
const fontSizeClasses = '2xl:text-base';
const ringClasses = '';
---

<a
  class={`${baseClasses} ${borderClasses} ${bgColorClasses} ${hoverClasses} ${fontSizeClasses} ${ringClasses}`}
  href={url}
  target="_blank"
  rel="noopener noreferrer"
>
  <Icon name="github" />
  {title}
</a>
