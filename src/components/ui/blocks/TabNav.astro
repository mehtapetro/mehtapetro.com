---
const { aria, dataTab, id, heading, content, first } = Astro.props;

interface Props {
  dataTab: string;
  id: string;
  aria: string;
  heading?: string;
  content?: string;
  first?: boolean;
}

const BUTTON_CLASS =
  'group w-full border-b border-[#D4E4FF] py-4 text-start outline-hidden transition-colors first:border-t focus-visible:ring-3 focus-visible:ring-[#C0D6FF] hs-tab-active:border-[#0039E6] sm:py-5';
---

<button
  type="button"
  class={`${first ? 'active ' : ''}${BUTTON_CLASS}`}
  id={id}
  data-hs-tab={dataTab}
  aria-controls={aria}
  aria-selected={first ? 'true' : 'false'}
  role="tab"
>
  <span class="flex gap-3 sm:gap-4">
    <span
      class="mt-0.5 flex h-9 w-9 shrink-0 items-center justify-center rounded-xl bg-[#E8F0FF] text-[#0039E6] transition-colors hs-tab-active:bg-[#0039E6] hs-tab-active:text-white sm:h-10 sm:w-10"
    >
      <slot />
    </span>
    <span class="min-w-0 grow">
      <span
        class="block text-base font-bold text-[#0A1F4D] hs-tab-active:text-[#0039E6] sm:text-lg"
        >{heading}</span
      >
      <span
        class="mt-1 hidden text-sm leading-relaxed text-[#4A5F8C] hs-tab-active:block sm:mt-1.5 sm:block sm:text-base"
        >{content}</span
      >
    </span>
  </span>
</button>
