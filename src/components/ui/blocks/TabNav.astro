---
const { aria, dataTab, id, heading, content, first } = Astro.props;

interface Props {
  dataTab: string;
  id: string;
  aria: string;
  heading?: string;
  content?: string;
  first?: boolean;
}

const BUTTON_CLASS =
  'group w-full border-l-2 border-l-transparent px-3 py-3.5 text-start transition-colors hover:bg-white/60 focus-visible:outline-2 focus-visible:-outline-offset-2 focus-visible:outline-[#0039E6] hs-tab-active:border-l-[#0039E6] hs-tab-active:bg-[#E8F0FF]/60 sm:px-4';
---

<button
  type="button"
  class={`${first ? 'active ' : ''}${BUTTON_CLASS}`}
  id={id}
  data-hs-tab={dataTab}
  aria-controls={aria}
  aria-selected={first ? 'true' : 'false'}
  role="tab"
>
  <span
    class="hs-tab-active:text-[#002285] block text-base leading-snug font-semibold text-[#0A1F4D] transition-colors group-hover:text-[#0039E6] sm:text-lg"
    >{heading}</span
  >
  <span
    class="hs-tab-active:block mt-1.5 hidden max-w-[48ch] text-sm leading-[1.65] text-pretty text-[#4A5F8C] lg:block"
    >{content}</span
  >
</button>
