---
// Import the Image component from astro:assets
import { Image } from 'astro:assets';

// Destructure the component properties from Astro.props
const { id, aria, src, alt, first } = Astro.props;

interface Props {
  id: string;
  aria: string;
  src?: any;
  alt: string;
  first?: boolean;
  second?: boolean;
  srcName?: string;
}

const firstClass = first ? '' : 'hidden';
const imageClass =
  'aspect-[16/10] w-full rounded-2xl object-cover sm:aspect-[4/3] lg:aspect-square';
---

<div id={id} role="tabpanel" class={firstClass} aria-labelledby={aria}>
  <Image
    src={src}
    alt={alt}
    class={imageClass}
    draggable={'false'}
    format={'avif'}
    widths={[640, 960, 1280]}
    sizes="(min-width: 1024px) 40vw, 90vw"
    loading="lazy"
    decoding="async"
  />
</div>
