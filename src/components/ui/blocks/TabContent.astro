---
// Import the Image component from astro:assets
import { Image } from 'astro:assets';

// Destructure the component properties from Astro.props
const { id, aria, src, alt, first } = Astro.props;

interface Props {
  id: string;
  aria: string;
  src?: any;
  alt: string;
  first?: boolean;
  second?: boolean;
  srcName?: string;
}

const firstClass = first ? '' : 'hidden';
const imageClass =
  'aspect-[16/10] w-full object-cover lg:h-full lg:aspect-auto';
---

<div
  id={id}
  role="tabpanel"
  class:list={[firstClass, 'product-preview lg:absolute lg:inset-0']}
  aria-labelledby={aria}
>
  <Image
    src={src}
    alt={alt}
    class={imageClass}
    draggable={'false'}
    format={'avif'}
    widths={[640, 960, 1280]}
    sizes="(min-width: 1024px) 55vw, 95vw"
    loading="lazy"
    decoding="async"
  />
</div>

<style>
  @media (prefers-reduced-motion: no-preference) {
    .product-preview:not(.hidden) {
      animation: preview-in 350ms ease-out both;
    }
  }

  @keyframes preview-in {
    from {
      opacity: 0.65;
    }
  }
</style>
