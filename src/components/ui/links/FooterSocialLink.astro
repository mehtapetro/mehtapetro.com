---
const { url, label } = Astro.props;
interface Props {
  url: string;
  label: string;
}
const linkClass =
  'inline-flex h-10 w-10 items-center justify-center rounded-full border border-white/18 bg-white/6 text-white/82 outline-hidden ring-zinc-500 transition-colors duration-300 hover:border-white/30 hover:bg-white/12 hover:text-white focus:outline-hidden focus-visible:ring-3 focus-visible:ring-zinc-500';
---

<a
  class={linkClass}
  href={url}
  target="_blank"
  rel="noopener noreferrer"
  aria-label={label}
>
  <slot />
</a>
