---
const { url, label } = Astro.props;
interface Props {
  url: string;
  label: string;
}
const linkClass =
  'inline-flex h-10 w-10 items-center justify-center rounded-xl border border-[#DCE8FF] bg-[#F8FAFF] text-[#4B5B85] outline-hidden ring-zinc-500 transition duration-300 hover:border-[#C7D9FF] hover:bg-[#EEF4FF] hover:text-[#1E3AFF] focus:outline-hidden focus-visible:ring-3 focus-visible:ring-zinc-500';
---

<a
  class={linkClass}
  href={url}
  target="_blank"
  rel="noopener noreferrer"
  aria-label={label}
>
  <slot />
</a>
