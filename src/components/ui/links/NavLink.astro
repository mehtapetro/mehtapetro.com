---
// Destructure the properties from Astro.props
const { url, name } = Astro.props;

// Define TypeScript interface for the properties
interface Props {
  url: string;
  name: string;
}
---

{
  /*
Re-usable link component for navigation bar. Highlights the active link
by comparing the current URL with the href of each link.
We assign an ID matching the URL for easy reference in our script.
If URL is '/' (home page), assign ID as 'home'
*/
}
<a
  href={url}
  data-nav-url={url}
  data-astro-prefetch
  class="rounded-lg text-base font-medium text-neutral-600 ring-zinc-500 outline-hidden transition duration-300 hover:text-[#1E3AFF] focus-visible:ring-3 md:py-3 md:text-sm 2xl:text-base"
>
  {name}
</a>

<script>
  document.addEventListener('DOMContentLoaded', function () {
    const currentPath = window.location.pathname;
    const navLinks = document.querySelectorAll('[data-nav-url]');

    navLinks.forEach(link => {
      const href = link.getAttribute('data-nav-url');
      if (!href) return;

      const isActive =
        href === '/'
          ? currentPath === '/'
          : currentPath === href || currentPath.startsWith(`${href}/`);

      if (isActive) {
        link.classList.remove('text-neutral-600', 'hover:text-[#1E3AFF]');
        link.classList.add('text-[#1E3AFF]');
        link.setAttribute('aria-current', 'page');
      }
    });
  });
</script>
