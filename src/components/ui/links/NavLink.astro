---
// Destructure the properties from Astro.props
const { url, name } = Astro.props;

// Define TypeScript interface for the properties
interface Props {
  url: string;
  name: string;
}
---

{
  /*
Re-usable link component for navigation bar. Highlights the active link
by comparing the current URL with the href of each link.
We assign an ID matching the URL for easy reference in our script.
If URL is '/' (home page), assign ID as 'home'
*/
}
<a
  href={url}
  data-nav-url={url}
  data-astro-prefetch
  class="inline-flex rounded-xl px-3 py-2 text-sm font-semibold text-[#4A5F8C] outline-hidden transition-colors duration-300 hover:bg-[#F5F9FF] hover:text-[#0039E6] focus-visible:outline-none md:px-4 md:py-2.5"
>
  {name}
</a>

<script>
  document.addEventListener('DOMContentLoaded', function () {
    const currentPath = window.location.pathname;
    const navLinks = document.querySelectorAll('[data-nav-url]');

    navLinks.forEach(link => {
      const href = link.getAttribute('data-nav-url');
      if (!href) return;

      const isActive =
        href === '/'
          ? currentPath === '/'
          : currentPath === href || currentPath.startsWith(`${href}/`);

      if (isActive) {
        link.classList.remove(
          'text-[#4A5F8C]',
          'hover:bg-[#F5F9FF]',
          'hover:text-[#0039E6]'
        );
        link.classList.add('bg-[#E8F0FF]', 'text-[#0039E6]');
        link.setAttribute('aria-current', 'page');
      }
    });
  });
</script>
