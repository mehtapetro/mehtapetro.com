---
import { Image } from 'astro:assets';
import type { ProductCatalogItem } from '@data/productCatalog';

const { item, categorySlug, locale = 'en' } = Astro.props;

interface Props {
  item: ProductCatalogItem;
  categorySlug: string;
  locale?: 'en' | 'fr';
}

const href =
  locale === 'fr'
    ? `/fr/products/${categorySlug}/${item.slug}/`
    : `/products/${categorySlug}/${item.slug}/`;
---

<a
  href={href}
  data-astro-prefetch
  class="group overflow-hidden rounded-[2rem] border border-[#DCE8FF] bg-white shadow-[0_24px_60px_-44px_rgba(16,36,95,0.22)] transition duration-300 hover:-translate-y-1 hover:border-[#BDD1FF] hover:shadow-[0_28px_72px_-44px_rgba(30,58,255,0.25)] focus-visible:ring-3 focus-visible:ring-[#1E3AFF]/30 outline-hidden"
>
  <div class="overflow-hidden border-b border-[#E5EEFF] bg-[#F8FAFF] p-3">
    <Image
      src={item.imgCard}
      alt={item.imgAlt}
      class="h-56 w-full rounded-[1.4rem] object-cover transition duration-500 group-hover:scale-[1.03]"
      format="avif"
    />
  </div>
  <div class="p-6">
    <p class="text-sm font-semibold tracking-[0.14em] text-[#1E3AFF] uppercase">
      {locale === 'fr' ? 'Produit' : 'Product'}
    </p>
    <h3 class="mt-2 text-xl font-bold text-[#10245F]">
      {item.title}
    </h3>
    <p class="mt-3 text-sm leading-7 text-[#5B6785]">
      {item.description}
    </p>
    <span class="mt-5 inline-flex items-center text-sm font-semibold text-[#1E3AFF] transition duration-300 group-hover:translate-x-1">
      {locale === 'fr' ? 'Voir les détails' : 'View details'} →
    </span>
  </div>
</a>
