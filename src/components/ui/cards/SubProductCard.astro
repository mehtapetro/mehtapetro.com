---
import { Image } from 'astro:assets';
import type { ProductCatalogItem } from '@data/productCatalog';

const { item, categorySlug } = Astro.props;

interface Props {
  item: ProductCatalogItem;
  categorySlug: string;
}

const href = `/products/${categorySlug}/${item.slug}/`;
---

<a
  href={href}
  data-astro-prefetch
  class="group overflow-hidden rounded-2xl border border-[#D4E4FF] bg-white shadow-lg outline-hidden transition-colors duration-300 hover:border-[#0039E6] hover:bg-[#FCFDFF] focus-visible:ring-3 focus-visible:ring-[#0039E6]/30"
>
  <div class="overflow-hidden border-b border-[#E5EEFF] bg-[#F5F9FF] p-3">
    <Image
      src={item.imgCard}
      alt={item.imgAlt}
      class="h-56 w-full rounded-xl object-cover"
      format="avif"
    />
  </div>
  <div class="p-6">
    <p class="text-xs font-semibold tracking-wide text-[#0039E6] uppercase">
      Product
    </p>
    <h3
      class="mt-2 text-xl font-bold text-[#0A1F4D] group-hover:text-[#0039E6]"
    >
      {item.title}
    </h3>
    <p class="mt-3 text-sm leading-relaxed text-[#4A5F8C]">
      {item.description}
    </p>
    <span
      class="mt-5 inline-flex text-sm font-semibold text-[#0039E6] transition duration-300 group-hover:text-[#0033CC]"
      >View details</span
    >
  </div>
</a>
