---
const { product, categorySlug } = Astro.props;
---

<a
  href={`/products/${categorySlug}/${product.slug}`}
  class="group overflow-hidden rounded-2xl border border-[#D4E4FF] bg-white shadow-lg transition-colors hover:border-[#0039E6]"
>
  <div class="relative overflow-hidden border-b border-[#E5EEFF] bg-[#F5F9FF]">
    {
      product.imageUrl ? (
        <img
          src={product.imageUrl}
          alt={product.name}
          class="h-40 w-full object-cover sm:h-52"
          loading="lazy"
        />
      ) : (
        <div class="h-40 w-full bg-neutral-100 sm:h-52" />
      )
    }
    <div
      class="absolute inset-0 bg-linear-to-t from-[#0A1F4D]/65 via-[#0A1F4D]/20 to-transparent"
    >
    </div>
  </div>

  <div class="p-4 sm:p-6">
    <p
      class="text-[11px] font-semibold tracking-wide text-[#0039E6] uppercase sm:text-xs"
    >
      Product
    </p>
    <h3
      class="mt-1 text-lg font-bold text-[#0A1F4D] group-hover:text-[#0039E6] sm:mt-2 sm:text-xl"
    >
      {product.name}
    </h3>
    {
      product.description && (
        <p class="mt-2 line-clamp-3 text-sm leading-relaxed text-[#4A5F8C] sm:mt-3">
          {product.description}
        </p>
      )
    }
    <div
      class="mt-4 text-sm font-semibold text-[#0039E6] group-hover:text-[#0033CC] sm:mt-5"
    >
      View details
    </div>
  </div>
</a>
