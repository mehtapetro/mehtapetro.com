---
const { product, categorySlug } = Astro.props;
---

<a
  href={`/products/${categorySlug}/${product.slug}`}
  class="group flex h-full flex-col overflow-hidden rounded-[1.25rem] border border-[#D4E4FF] bg-white shadow-sm transition duration-300 hover:border-[#0039E6] hover:shadow-md"
>
  <div class="overflow-hidden bg-[#F5F9FF] p-3">
    {
      product.imageUrl ? (
        <img
          src={product.imageUrl}
          alt={product.name}
          class="h-44 w-full rounded-[0.9rem] object-cover transition duration-500 group-hover:scale-[1.02]"
          loading="lazy"
        />
      ) : (
        <div class="flex h-44 w-full items-center justify-center rounded-[0.9rem] bg-gradient-to-br from-[#E8F1FF] to-[#C9DAFF] text-sm font-semibold text-[#0A1F4D]">
          Product image unavailable
        </div>
      )
    }
  </div>

  <div class="flex flex-1 flex-col p-4 sm:p-5 md:p-6">
    <p
      class="text-[11px] font-semibold tracking-[0.18em] text-[#0039E6] uppercase sm:text-xs"
    >
      Product
    </p>
    <h3
      class="mt-1 text-base font-bold text-[#0A1F4D] transition group-hover:text-[#0039E6] sm:mt-2 sm:text-lg"
    >
      {product.name}
    </h3>
    {
      product.description && (
        <p class="mt-2 line-clamp-3 text-sm leading-relaxed text-[#4A5F8C]">
          {product.description}
        </p>
      )
    }
    <div
      class="mt-4 inline-flex items-center gap-2 text-sm font-semibold text-[#0039E6] transition group-hover:text-[#0033CC] sm:mt-5"
    >
      View details
      <span aria-hidden="true">→</span>
    </div>
  </div>
</a>
