---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import { formatDate } from '@utils/utils';

const { blogEntry, recentBlogLocale = '' } = Astro.props;

interface Props {
  blogEntry: CollectionEntry<'blog'>;
  recentBlogLocale?: string;
}

const href =
  recentBlogLocale && recentBlogLocale !== 'en'
    ? `/${recentBlogLocale}/news/${blogEntry.id.replace(/^fr\//, '')}/`
    : `/news/${blogEntry.id.replace(/^en\//, '')}/`;
---

<a
  class="group block h-full overflow-hidden rounded-2xl border border-[#D4E4FF] bg-white shadow-lg transition duration-300 hover:border-[#0039E6] hover:shadow-[0_24px_60px_-46px_rgba(10,31,77,0.22)] active:scale-[0.995]"
  href={href}
  data-astro-prefetch
>
  <div class="relative overflow-hidden">
    <Image
      class="h-44 w-full object-cover transition duration-500 group-hover:scale-[1.02] sm:h-52 md:h-64 lg:h-72"
      src={blogEntry.data.cardImage}
      alt={blogEntry.data.cardImageAlt}
      draggable={false}
      format="avif"
    />
    <div
      class="absolute inset-0 bg-linear-to-t from-[#0A1F4D]/55 via-transparent to-transparent"
    >
    </div>
    <span
      class="absolute top-3 left-3 inline-flex rounded-full border border-white/20 bg-white/90 px-2.5 py-1 text-[0.65rem] font-semibold tracking-[0.14em] text-[#0039E6] uppercase backdrop-blur-sm sm:top-4 sm:left-4 sm:px-3 sm:text-xs"
    >
      Latest
    </span>
  </div>

  <div class="flex flex-col gap-3 p-5 sm:gap-4 sm:p-6 lg:p-8">
    <div
      class="flex flex-wrap items-center gap-x-2.5 gap-y-1 text-[0.7rem] font-medium text-[#4A5F8C] sm:gap-x-3 sm:text-xs"
    >
      <span>{formatDate(blogEntry.data.pubDate)}</span>
      <span aria-hidden="true">•</span>
      <span>{blogEntry.data.readTime} min read</span>
    </div>

    <div class="space-y-2 sm:space-y-3">
      <h2
        class="text-xl font-bold tracking-tight text-balance text-[#0A1F4D] transition-colors group-hover:text-[#0039E6] sm:text-2xl lg:text-3xl"
      >
        {blogEntry.data.title}
      </h2>
      <p class="text-sm leading-6 text-[#4A5F8C] sm:text-base sm:leading-7">
        {blogEntry.data.description}
      </p>
    </div>

    <div
      class="inline-flex min-h-11 items-center gap-2 text-sm font-semibold text-[#0039E6] transition group-hover:text-[#0033CC]"
    >
      Read full article
      <svg
        class="h-4 w-4 transition-transform group-hover:translate-x-0.5"
        xmlns="http://www.w3.org/2000/svg"
        fill="none"
        viewBox="0 0 24 24"
        stroke="currentColor"
        aria-hidden="true"
      >
        <path
          stroke-linecap="round"
          stroke-linejoin="round"
          stroke-width="2"
          d="M9 5l7 7-7 7"></path>
      </svg>
    </div>
  </div>
</a>
