---
import type { CollectionEntry } from 'astro:content';
import { formatDate } from '@utils/utils';

const { blogEntry, blogLocale = '' } = Astro.props;

interface Props {
  blogEntry: CollectionEntry<'blog'>;
  blogLocale?: string;
}
---

<a
  class="group block transform rounded-md border border-neutral-100 bg-white shadow-sm ring-offset-2 outline-hidden transition duration-150 hover:-translate-y-0.5 hover:shadow-md focus-visible:ring-2 focus-visible:ring-indigo-300"
  href={blogLocale && blogLocale !== 'en'
    ? `/${blogLocale}/news/${blogEntry.id.replace(/^fr\//, '')}/`
    : `/news/${blogEntry.id.replace(/^en\//, '')}/`}
  data-astro-prefetch
>
  <div class="p-3">
    <div class="flex items-center justify-between gap-3">
      <div class="min-w-0">
        <p class="text-xs text-neutral-500">
          {formatDate(blogEntry.data.pubDate)}
        </p>
        <h3 class="mt-1 truncate text-base font-medium text-neutral-900">
          {blogEntry.data.title}
        </h3>
        <p class="mt-1 line-clamp-2 text-sm text-neutral-600 md:line-clamp-3">
          {blogEntry.data.description}
        </p>
      </div>

      <div
        class="flex h-8 w-8 flex-shrink-0 items-center justify-center rounded-full bg-neutral-50 sm:h-7 sm:w-7"
      >
        <svg
          class="h-4 w-4 text-neutral-400 group-hover:text-neutral-600 sm:h-3.5 sm:w-3.5"
          xmlns="http://www.w3.org/2000/svg"
          fill="none"
          viewBox="0 0 24 24"
          stroke="currentColor"
          aria-hidden="true"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="2"
            d="M9 5l7 7-7 7"></path>
        </svg>
      </div>
    </div>
  </div>
</a>
