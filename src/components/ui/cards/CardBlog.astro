---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import { formatDate } from '@utils/utils';

const { blogEntry } = Astro.props;

interface Props {
  blogEntry: CollectionEntry<'blog'>;
}

const href = `/news/${blogEntry.id.replace(/^en\//, '')}/`;
---

<a
  class="group block overflow-hidden rounded-2xl border border-[#D4E4FF] bg-white transition duration-300 hover:border-[#0039E6] active:bg-[#F7FAFF] sm:flex sm:items-center sm:gap-5 sm:p-4"
  href={href}
  data-astro-prefetch
>
  <div class="shrink-0 overflow-hidden sm:rounded-xl">
    <Image
      class="aspect-[16/9] h-auto w-full object-cover transition duration-500 group-hover:scale-[1.02] sm:aspect-auto sm:h-24 sm:w-32"
      src={blogEntry.data.cardImage}
      alt={blogEntry.data.cardImageAlt}
      draggable={false}
      format="avif"
      widths={[400, 640, 960]}
      sizes="(min-width: 640px) 128px, 100vw"
    />
  </div>

  <div
    class="flex min-w-0 flex-1 flex-col justify-center gap-1.5 p-4 sm:gap-2 sm:p-0"
  >
    <div
      class="flex flex-wrap items-center gap-x-2 gap-y-0.5 text-[0.7rem] font-medium text-[#4A5F8C] sm:text-xs"
    >
      <span>{formatDate(blogEntry.data.pubDate)}</span>
      <span aria-hidden="true">•</span>
      <span>{blogEntry.data.readTime} min read</span>
    </div>

    <h3
      class="line-clamp-2 text-base font-bold tracking-tight text-[#0A1F4D] transition-colors group-hover:text-[#0039E6] sm:text-base"
    >
      {blogEntry.data.title}
    </h3>

    <p class="line-clamp-2 text-sm leading-6 text-[#4A5F8C]">
      {blogEntry.data.description}
    </p>

    <span
      class="mt-1 inline-flex items-center gap-1 text-sm font-semibold text-[#0039E6] sm:hidden"
    >
      Read article
      <svg
        class="h-4 w-4"
        xmlns="http://www.w3.org/2000/svg"
        fill="none"
        viewBox="0 0 24 24"
        stroke="currentColor"
        aria-hidden="true"
      >
        <path
          stroke-linecap="round"
          stroke-linejoin="round"
          stroke-width="2"
          d="M9 5l7 7-7 7"></path>
      </svg>
    </span>
  </div>

  <svg
    class="mt-1 mr-4 hidden h-4 w-4 shrink-0 self-center text-[#4A5F8C] transition group-hover:translate-x-0.5 group-hover:text-[#0039E6] sm:mt-0 sm:block"
    xmlns="http://www.w3.org/2000/svg"
    fill="none"
    viewBox="0 0 24 24"
    stroke="currentColor"
    aria-hidden="true"
  >
    <path
      stroke-linecap="round"
      stroke-linejoin="round"
      stroke-width="2"
      d="M9 5l7 7-7 7"></path>
  </svg>
</a>
