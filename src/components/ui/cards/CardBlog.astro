---
import type { CollectionEntry } from 'astro:content';
import { formatDate } from '@utils/utils';

const { blogEntry, blogLocale = '' } = Astro.props;

interface Props {
  blogEntry: CollectionEntry<'blog'>;
  blogLocale?: string;
}
---

<a
  class="group block rounded-md bg-white border border-neutral-100 shadow-sm hover:shadow-md transform hover:-translate-y-0.5 transition duration-150 outline-hidden focus-visible:ring-2 focus-visible:ring-indigo-300 ring-offset-2"
  href={blogLocale && blogLocale !== 'en'
    ? `/${blogLocale}/news/${blogEntry.id.replace(/^fr\//, '')}/`
    : `/news/${blogEntry.id.replace(/^en\//, '')}/`}
  data-astro-prefetch
>
  <div class="p-3">
    <div class="flex items-center justify-between gap-3">
      <div class="min-w-0">
        <p class="text-xs text-neutral-500">{formatDate(blogEntry.data.pubDate)}</p>
        <h3 class="mt-1 text-base font-medium text-neutral-900 truncate">{blogEntry.data.title}</h3>
        <p class="mt-1 text-sm text-neutral-600 line-clamp-2 md:line-clamp-3">{blogEntry.data.description}</p>
      </div>

      <div class="flex-shrink-0 flex items-center justify-center w-8 h-8 sm:w-7 sm:h-7 bg-neutral-50 rounded-full">
        <svg class="w-4 h-4 sm:w-3.5 sm:h-3.5 text-neutral-400 group-hover:text-neutral-600" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
        </svg>
      </div>
    </div>
  </div>
</a>
