---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import { formatDate } from '@utils/utils';

const { blogEntry, blogLocale = '' } = Astro.props;

interface Props {
  blogEntry: CollectionEntry<'blog'>;
  blogLocale?: string;
}

const href =
  blogLocale && blogLocale !== 'en'
    ? `/${blogLocale}/news/${blogEntry.id.replace(/^fr\//, '')}/`
    : `/news/${blogEntry.id.replace(/^en\//, '')}/`;
---

<a
  class="group flex gap-4 overflow-hidden rounded-xl border border-[#D4E4FF] bg-white p-4 shadow-sm transition duration-300 hover:border-[#0039E6] hover:shadow-md active:scale-[0.995] sm:items-center sm:gap-5 sm:p-5"
  href={href}
  data-astro-prefetch
>
  <div class="shrink-0 overflow-hidden rounded-lg">
    <Image
      class="h-20 w-24 object-cover transition duration-500 group-hover:scale-[1.03] sm:h-24 sm:w-32"
      src={blogEntry.data.cardImage}
      alt={blogEntry.data.cardImageAlt}
      draggable={false}
      format="avif"
    />
  </div>

  <div class="flex min-w-0 flex-1 flex-col justify-center gap-1.5 sm:gap-2">
    <div
      class="flex flex-wrap items-center gap-x-2 gap-y-0.5 text-[0.7rem] font-medium text-[#4A5F8C] sm:text-xs"
    >
      <span>{formatDate(blogEntry.data.pubDate)}</span>
      <span aria-hidden="true">•</span>
      <span>{blogEntry.data.readTime} min read</span>
    </div>

    <h3
      class="line-clamp-2 text-sm font-bold tracking-tight text-[#0A1F4D] transition-colors group-hover:text-[#0039E6] sm:text-base"
    >
      {blogEntry.data.title}
    </h3>

    <p
      class="line-clamp-2 text-xs leading-5 text-[#4A5F8C] sm:text-sm sm:leading-6"
    >
      {blogEntry.data.description}
    </p>
  </div>

  <svg
    class="mt-1 h-4 w-4 shrink-0 self-center text-[#4A5F8C] transition group-hover:translate-x-0.5 group-hover:text-[#0039E6] sm:mt-0"
    xmlns="http://www.w3.org/2000/svg"
    fill="none"
    viewBox="0 0 24 24"
    stroke="currentColor"
    aria-hidden="true"
  >
    <path
      stroke-linecap="round"
      stroke-linejoin="round"
      stroke-width="2"
      d="M9 5l7 7-7 7"></path>
  </svg>
</a>
