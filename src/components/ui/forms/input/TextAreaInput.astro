---
const {
  label,
  id,
  name,
  rows = 4,
  maxlength,
  showCharCount = false,
  class: className,
} = Astro.props;

interface Props {
  label: string;
  name: string;
  id: string;
  rows?: number;
  maxlength?: number;
  showCharCount?: boolean;
  class?: string;
}
---

<div>
  <label for={id} class="sr-only">{label}</label>
  <textarea
    id={id}
    name={name}
    rows={rows}
    maxlength={maxlength}
    required
    class:list={[
      'block w-full rounded-lg border border-neutral-200 bg-neutral-50 px-4 py-3 text-sm text-neutral-700 placeholder:text-neutral-500 focus:border-neutral-200 focus:ring-3 focus:ring-neutral-400 focus:outline-hidden disabled:pointer-events-none disabled:opacity-50 dark:border-neutral-600 dark:bg-neutral-700/30 dark:text-neutral-300 dark:placeholder:text-neutral-400 dark:focus:ring-1',
      className,
    ]}
    placeholder={label}></textarea>
  {
    showCharCount && maxlength ? (
      <p class="mt-1 text-right text-xs text-[#4A5F8C]" aria-live="polite">
        <span id={`${id}-char-count`}>0</span>/{maxlength} characters
      </p>
    ) : null
  }
</div>

{
  showCharCount && maxlength ? (
    <script define:vars={{ id }}>
      function initCharCount() {
        const textarea = document.getElementById(id);
        const counter = document.getElementById(`${id}-char-count`);
        if (!(textarea instanceof HTMLTextAreaElement) || !counter) return;

        const update = () => {
          counter.textContent = String(textarea.value.length);
        };

        if (textarea.dataset.charCountBound !== 'true') {
          textarea.dataset.charCountBound = 'true';
          textarea.addEventListener('input', update);
          textarea.form?.addEventListener('reset', () => {
            requestAnimationFrame(update);
          });
        }

        update();
      }

      initCharCount();
      document.addEventListener('astro:page-load', initCharCount);
    </script>
  ) : null
}
