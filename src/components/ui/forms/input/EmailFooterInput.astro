---
import { getMarketingLocale } from '@utils/locale';

const locale = getMarketingLocale(Astro.url.pathname, Astro.currentLocale);

const {
  label = locale === 'fr' ? 'E-mail' : 'Email',
  title = locale === 'fr' ? "S'abonner" : 'Subscribe',
  id = 'footer-input',
} = Astro.props;

interface Props {
  label?: string;
  title?: string;
  id?: string;
}

const placeholder = locale === 'fr' ? 'Entrez votre email' : 'Enter your email';
const successMessage =
  locale === 'fr'
    ? 'Merci ! (démo — branchez un service e-mail pour collecter de vrais abonnés.)'
    : 'Thanks! (Demo only — wire an email service to collect real subscribers.)';
---

<div
  class="mt-4 flex flex-col items-center gap-2 rounded-lg bg-neutral-200 p-2 sm:flex-row sm:gap-3 dark:bg-neutral-800"
>
  <div class="w-full">
    <label for={id} class="sr-only">{label}</label>
    <input
      type="email"
      id={id}
      name="email"
      required
      autocomplete="email"
      class="block w-full rounded-lg border-transparent bg-neutral-100 px-4 py-3 text-sm text-neutral-600 caret-[#1E3AFF] focus:border-[#1E3AFF] focus:ring-[#1E3AFF] disabled:pointer-events-none disabled:opacity-50"
      placeholder={placeholder}
    />
  </div>
  <button
    type="submit"
    class="inline-flex w-full items-center justify-center gap-x-2 rounded-lg border border-transparent bg-[#0039E6] p-3 text-sm font-bold whitespace-nowrap text-neutral-50 ring-zinc-500 outline-hidden transition duration-300 hover:bg-[#0033CC] focus-visible:ring-3 disabled:pointer-events-none disabled:opacity-50 sm:w-auto"
  >
    {title}
  </button>
</div>
<p
  class="mt-2 hidden text-sm text-neutral-600 dark:text-neutral-400"
  data-demo-status
  aria-live="polite"
  data-success-message={successMessage}
>
</p>
