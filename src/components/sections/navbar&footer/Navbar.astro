---
//Import relevant dependencies
import NavLink from '@components/ui/links/NavLink.astro';
import enStrings from '@utils/navigation.ts';
import BrandLogo from '@components/BrandLogo.astro';

const strings = enStrings;
const homeUrl = '/';
const { overlay = false } = Astro.props;

interface Props {
  overlay?: boolean;
}
---

{/* Main header component */}
<header
  class:list={[
    'inset-x-0 z-50 flex w-full flex-wrap text-sm md:flex-nowrap md:justify-start',
    overlay ? 'fixed top-0 pt-3 sm:pt-4' : 'sticky top-3 mb-5 md:top-4 md:mb-8',
  ]}
>
  <div class="mx-auto w-full max-w-[85rem] px-4 sm:px-6 lg:px-8">
    {/* Navigation container */}
    <nav
      class:list={[
        'relative w-full rounded-2xl px-4 py-3 md:flex md:items-center md:justify-between md:px-5 md:py-2 lg:px-6',
        overlay
          ? 'border border-white/30 bg-white/78 shadow-[0_24px_70px_-44px_rgba(8,17,38,0.9)] backdrop-blur-xl'
          : 'border border-[#C0D6FF]/80 bg-white/88 shadow-[0_18px_45px_-34px_rgba(0,57,230,0.35)] backdrop-blur-md',
      ]}
      aria-label="Global"
    >
      <div class="flex items-center justify-between">
        {/* Brand logo */}
        <a
          class="flex flex-none items-center gap-3 rounded-lg text-xl font-bold ring-zinc-500 outline-hidden focus-visible:ring-3"
          href={homeUrl}
          aria-label="Mehta Petro Refineries Limited"
        >
          <BrandLogo class="h-10 w-auto object-contain md:h-11" />
        </a>
        {/* Collapse toggle for smaller screens */}
        <div class="ml-auto md:hidden">
          <button
            type="button"
            class="hs-collapse-toggle flex h-10 w-10 items-center justify-center rounded-xl border border-[#D4E4FF] bg-white/80 text-[#0A1F4D] transition-colors duration-300 hover:border-[#0039E6] hover:text-[#0039E6] disabled:pointer-events-none disabled:opacity-50"
            data-hs-collapse="#navbar-collapse-with-animation"
            aria-controls="navbar-collapse-with-animation"
            aria-label="Toggle navigation"
          >
            <svg
              class="hs-collapse-open:hidden h-[1.25rem] w-[1.25rem] shrink-0"
              width="24"
              height="24"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
            >
              <line x1="3" x2="21" y1="6" y2="6"></line>
              <line x1="3" x2="21" y1="12" y2="12"></line>
              <line x1="3" x2="21" y1="18" y2="18"></line>
            </svg>
            <svg
              class="hs-collapse-open:block hidden h-[1.25rem] w-[1.25rem] shrink-0"
              width="24"
              height="24"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
            >
              <path d="M18 6 6 18"></path>
              <path d="m6 6 12 12"></path>
            </svg>
          </button>
        </div>
      </div>
      {/* Contains navigation links */}
      <div
        id="navbar-collapse-with-animation"
        class="hs-collapse hidden grow basis-full overflow-hidden transition-all duration-300 md:block"
      >
        {/* Navigation links container */}
        <div
          class="mt-4 flex flex-col items-center text-center gap-2 border-t border-[#E3EBFF] pt-4 md:mt-0 md:flex-row md:items-center md:justify-end md:gap-2 md:border-t-0 md:pt-0 md:ps-5 lg:gap-3"
        >
          {/* Navigation links */}
          {
            strings.navBarLinks.map(link => (
              <NavLink url={link.url} name={link.name} />
            ))
          }
        </div>
      </div>
    </nav>
  </div>
</header>
