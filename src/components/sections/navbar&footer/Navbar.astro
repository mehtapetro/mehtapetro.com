---
//Import relevant dependencies
import NavLink from '@components/ui/links/NavLink.astro';
import enStrings from '@utils/navigation.ts';
import BrandLogo from '@components/BrandLogo.astro';

const strings = enStrings;
const homeUrl = '/';
const { overlay = false } = Astro.props;

interface Props {
  overlay?: boolean;
}
---

{/* Main header component */}
<header
  class:list={[
    'inset-x-0 z-50 flex w-full flex-wrap text-sm md:flex-nowrap md:justify-start',
    overlay ? 'fixed top-0 pt-3 sm:pt-4' : 'sticky top-4 mb-6 md:mb-8',
  ]}
>
  <div class="mx-auto w-full max-w-(--breakpoint-2xl) px-4 sm:px-6 lg:px-8">
    {/* Navigation container */}
    <nav
      class:list={[
        'relative w-full rounded-[36px] px-4 py-3 md:flex md:items-center md:justify-between md:px-6 md:py-0 lg:px-8',
        overlay
          ? 'border border-white/35 bg-white/72 shadow-[0_28px_80px_-48px_rgba(8,17,38,0.95)] backdrop-blur-xl'
          : 'border border-[#C7D9FF]/70 bg-white/78 shadow-[0_20px_50px_-35px_rgba(30,58,255,0.65)] backdrop-blur-md',
      ]}
      aria-label="Global"
    >
      <div class="flex items-center justify-between">
        {/* Brand logo */}
        <a
          class="flex flex-none items-center gap-3 rounded-lg text-xl font-bold ring-zinc-500 outline-hidden focus-visible:ring-3"
          href={homeUrl}
          aria-label="Mehta Petro Refineries Limited"
        >
          <BrandLogo class="h-11 w-auto object-contain md:h-12" />
          <span
            class="hidden max-w-[18rem] text-base leading-[1.15] font-bold text-[#10245F] md:block lg:text-lg"
          >
            Mehta Petro-Refineries Limited
          </span>
        </a>
        {/* Collapse toggle for smaller screens */}
        <div class="mr-5 ml-auto md:hidden">
          <button
            type="button"
            class="hs-collapse-toggle flex h-8 w-8 items-center justify-center rounded-full text-sm font-bold text-neutral-600 transition duration-300 hover:bg-[#E7EFFF] hover:text-[#1E3AFF] disabled:pointer-events-none disabled:opacity-50"
            data-hs-collapse="#navbar-collapse-with-animation"
            aria-controls="navbar-collapse-with-animation"
            aria-label="Toggle navigation"
          >
            <svg
              class="hs-collapse-open:hidden h-[1.25rem] w-[1.25rem] shrink-0"
              width="24"
              height="24"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
            >
              <line x1="3" x2="21" y1="6" y2="6"></line>
              <line x1="3" x2="21" y1="12" y2="12"></line>
              <line x1="3" x2="21" y1="18" y2="18"></line>
            </svg>
            <svg
              class="hs-collapse-open:block hidden h-[1.25rem] w-[1.25rem] shrink-0"
              width="24"
              height="24"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
            >
              <path d="M18 6 6 18"></path>
              <path d="m6 6 12 12"></path>
            </svg>
          </button>
        </div>
      </div>
      {/* Contains navigation links */}
      <div
        id="navbar-collapse-with-animation"
        class="hs-collapse hidden grow basis-full overflow-hidden transition-all duration-300 md:block"
      >
        {/* Navigation links container */}
        <div
          class="mt-5 flex flex-col gap-x-0 gap-y-4 md:mt-0 md:flex-row md:items-center md:justify-end md:gap-x-4 md:gap-y-0 md:ps-7 lg:gap-x-7"
        >
          {/* Navigation links */}
          {
            strings.navBarLinks.map(link => (
              <NavLink url={link.url} name={link.name} />
            ))
          }
        </div>
      </div>
    </nav>
  </div>
</header>
