---
import FooterSocialLink from '@components/ui/links/FooterSocialLink.astro';
import Icon from '@components/ui/icons/Icon.astro';
import enStrings from '@utils/navigation.ts';
import footerLogo from '@images/mprl_logo_white.png';
import isoLogoUrl from '@images/iso/ISO.svg?url';
import isoCertificateUrl from '@images/iso/iso_certificate.pdf?url';

const strings = enStrings;
const companyEmail = 'info@mehtapetro.com';
---

<footer class="mt-20 w-full border-t border-[#1B46D8] bg-[#0A2FB8] text-white">
  <div class="mx-auto w-full max-w-[85rem] px-4 py-12 sm:px-6 lg:px-8 lg:py-16">
    <div class="grid gap-12 lg:grid-cols-[1.15fr_0.7fr_0.9fr_1.1fr] lg:gap-10">
      <div>
        <img
          src={footerLogo.src}
          alt="Mehta Petro-Refineries Limited"
          class="h-16 w-auto"
        />
        <p class="mt-3 text-sm font-semibold text-white/88">Mehta Petro-Refineries Limited</p>
        <p class="mt-5 max-w-md text-sm leading-relaxed text-white/74">
          Manufacturer and supplier of petrochemical solvents, specialty base oils,
          n-paraffins, olefins, and specialty chemicals since 1993.
        </p>
      </div>

      <div class="grid grid-cols-1 gap-6 md:grid-cols-2 lg:grid-cols-1">
        {strings.footerLinks.map(section => (
          <div>
            <details class="lg:hidden" data-section={section.section}>
              <summary class="flex items-center justify-between text-[11px] font-semibold tracking-[0.2em] text-white/54 uppercase py-2">
                <span>{section.section}</span>
                <svg class="h-4 w-4 text-white/70" viewBox="0 0 20 20" fill="none" aria-hidden>
                  <path d="M6 8l4 4 4-4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
                </svg>
              </summary>
              <ul class="mt-2 space-y-2 pl-0">
                {section.links.map(link => (
                  <li>
                    <a href={link.url} class="text-sm font-medium text-white/80 transition-colors hover:text-white block py-1">
                      {link.name}
                    </a>
                  </li>
                ))}
              </ul>
            </details>

            <div class="hidden lg:block">
              <h3 class="text-[11px] font-semibold tracking-[0.2em] text-white/54 uppercase">
                {section.section}
              </h3>
              <ul class="mt-4 space-y-2">
                {section.links.map(link => (
                  <li>
                    <a
                      href={link.url}
                      class="text-sm font-medium text-white/80 transition-colors hover:text-white"
                    >
                      {link.name}
                    </a>
                  </li>
                ))}
              </ul>
            </div>
          </div>
        ))}
      </div>

      <div>
        <details class="lg:hidden" data-section="Contact">
          <summary class="flex items-center justify-between text-[11px] font-semibold tracking-[0.2em] text-white/54 uppercase py-2">
            <span>Contact</span>
            <svg class="h-4 w-4 text-white/70" viewBox="0 0 20 20" fill="none" aria-hidden>
              <path d="M6 8l4 4 4-4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
            </svg>
          </summary>

          <div class="mt-3 space-y-5">
            <div>
              <p class="text-xs font-medium text-white/54 uppercase">Email</p>
              <a
                href={`mailto:${companyEmail}`}
                class="mt-2 inline-flex text-sm font-medium text-white/82 transition-colors hover:text-white"
              >
                {companyEmail}
              </a>
            </div>

            <div>
              <p class="text-xs font-medium text-white/54 uppercase">Phone</p>
              <div class="mt-3 grid grid-cols-2 gap-2 text-sm text-white/82">
                <a href="tel:+910224455909" class="transition-colors hover:text-white">022-44559090</a>
                <a href="tel:+912235218451" class="transition-colors hover:text-white">35218451</a>
                <a href="tel:+912235218543" class="transition-colors hover:text-white">35218543</a>
                <a href="tel:+912235219242" class="transition-colors hover:text-white">35219242</a>
                <a href="tel:+912235219404" class="transition-colors hover:text-white">35219404</a>
              </div>
            </div>
          </div>
        </details>

        <div class="hidden lg:block">
          <h3 class="text-[11px] font-semibold tracking-[0.2em] text-white/54 uppercase">
            Contact
          </h3>

          <div class="mt-5 space-y-5">
            <div>
              <p class="text-xs font-medium text-white/54 uppercase">Email</p>
              <a
                href={`mailto:${companyEmail}`}
                class="mt-2 inline-flex text-sm font-medium text-white/82 transition-colors hover:text-white"
              >
                {companyEmail}
              </a>
            </div>

            <div>
              <p class="text-xs font-medium text-white/54 uppercase">Phone</p>
              <div class="mt-3 grid grid-cols-1 gap-y-2 text-sm text-white/82 sm:grid-cols-2 lg:grid-cols-1 xl:grid-cols-2">
                <a href="tel:+910224455909" class="transition-colors hover:text-white">022-44559090</a>
                <a href="tel:+912235218451" class="transition-colors hover:text-white">35218451</a>
                <a href="tel:+912235218543" class="transition-colors hover:text-white">35218543</a>
                <a href="tel:+912235219242" class="transition-colors hover:text-white">35219242</a>
                <a href="tel:+912235219404" class="transition-colors hover:text-white">35219404</a>
              </div>
            </div>
          </div>
        </div>
      </div>

      <div>
        <h3 class="text-[11px] font-semibold tracking-[0.2em] text-white/54 uppercase">
          Corporate Office
        </h3>
        <p class="mt-5 max-w-md text-sm leading-relaxed text-white/74">
          509, HIVE 67, ICON Tower, Borsapada Road, Next to Raghuleela Mall,
          Kandivali (West), Mumbai 400067, India
        </p>

          <div class="mt-5 overflow-hidden rounded-2xl border border-white/12">
          <iframe
            class="h-36 sm:h-48 w-full"
            src="https://www.google.com/maps/embed?pb=!1m14!1m8!1m3!1d7535.136593831896!2d72.848887!3d19.214049!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x3be71ccfa59893e3%3A0x6aab7ca9656cdb12!2sMehta%20Petro%20Refineries%20Ltd!5e0!3m2!1sen!2sin!4v1785383107592!5m2!1sen!2sin"
            style="border:0;"
            allowfullscreen=""
            loading="lazy"
            referrerpolicy="strict-origin-when-cross-origin"
            title="Mehta Petro location map"
          ></iframe>
        </div>

        <div class="mt-5 flex items-center gap-3">
          <img
            src={isoLogoUrl}
            alt="ISO 9001:2015"
            class="h-14 w-auto shrink-0 rounded-md bg-white px-2 py-1"
            loading="lazy"
          />
          <div>
            <p class="text-xs font-medium text-white/54 uppercase">Certified</p>
            <p class="mt-1 text-sm font-semibold text-white/88">ISO 9001:2015</p>
            <a
              href={`${isoCertificateUrl}#page=1&zoom=page-fit`}
              target="_blank"
              rel="noopener noreferrer"
              class="mt-1 inline-flex text-sm text-white/76 transition-colors hover:text-white"
              aria-label="View ISO certificate PDF"
            >
              View Certificate
            </a>
          </div>
        </div>
      </div>
    </div>

    <div class="mt-10 border-t border-white/10 pt-6">
      <div class="flex flex-col gap-5 md:flex-row md:items-center md:justify-between">
        <div class="footer-follow">
          <p class="text-[11px] font-semibold tracking-[0.2em] text-white/54 uppercase">
            Follow Us
          </p>
          <div class="mt-3 flex items-center gap-3 footer-follow-icons md:justify-start">
            <FooterSocialLink url={strings.socialLinks.facebook} label="Facebook">
              <Icon name="facebookFooter" />
            </FooterSocialLink>
            <FooterSocialLink url={strings.socialLinks.youtube} label="YouTube">
              <Icon name="youtubeFooter" />
            </FooterSocialLink>
            <FooterSocialLink url={strings.socialLinks.instagram} label="Instagram">
              <Icon name="instagramFooter" />
            </FooterSocialLink>
            <FooterSocialLink url={strings.socialLinks.linkedin} label="LinkedIn">
              <Icon name="linkedinFooter" />
            </FooterSocialLink>
          </div>
        </div>

        <div class="text-center md:text-right">
          <p class="text-sm text-white/64">
            © <span id="current-year"></span> Mehta Petro-Refineries Limited. All rights reserved.
          </p>
          <p class="mt-2 text-sm text-white/64">
            Crafted by
            {` `}
            <a
              class="font-medium text-white/84 transition-colors hover:text-white"
              href="https://eightharsh.com/"
              target="_blank"
              rel="noopener noreferrer">eightharsh</a
            >.
          </p>
        </div>
      </div>
    </div>

    <script>
      const year = new Date().getFullYear();
      const element = document.getElementById('current-year');
      if (element) element.innerText = year.toString();
    </script>
    <style>
      /* Desktop keeps the original layout; mobile gets collapsible visuals and animation */
      details summary { cursor: pointer; }
      details summary svg { transition: transform 720ms cubic-bezier(.22,.9,.29,1); }
      details[open] summary svg { transform: rotate(180deg); }

      @media (max-width: 1023px) {
        /* Make the summary clearly look like a larger horizontal toggle bar on mobile */
        details {
          position: relative; /* container for animated divider */
          padding-bottom: 0.6rem; /* keep some distance below values and summary */
          transition: padding-bottom 360ms cubic-bezier(.22,.9,.29,1);
        }

        details summary {
          display: flex;
          align-items: center;
          justify-content: space-between;
          gap: 0.75rem;
          padding: 0.75rem 0;
          border-radius: 0;
          background: transparent;
          transition: background-color 220ms ease, box-shadow 220ms ease, transform 220ms ease;
          width: 100%;
          font-size: 0.875rem; /* match footer link size on mobile */
          font-weight: 600;
          color: rgba(255,255,255,0.95);
          -webkit-tap-highlight-color: transparent; /* remove tap highlight on mobile */
          -webkit-touch-callout: none;
          -webkit-user-select: none;
          -moz-user-select: none;
          user-select: none;
        }

        /* Divider lives at the bottom of the details container so it moves with expansion */
        details::after {
          content: '';
          position: absolute;
          left: 0;
          right: 0;
          height: 1px;
          background: rgba(255,255,255,0.12);
          bottom: 0;
          z-index: 0;
          pointer-events: none;
          transition: transform 420ms cubic-bezier(.22,.9,.29,1), opacity 260ms ease;
          transform: translateY(0);
        }

        /* When opened, give the divider extra space below the content */
        details[open] {
          padding-bottom: 1rem;
        }

        details[open]::after {
          transform: translateY(8px);
        }

        /* Remove focus outline / active highlight on mobile only */
        details summary:focus,
        details summary:active {
          outline: none;
          box-shadow: none;
          background: transparent;
        }

        /* Animate the list expanding/collapsing (butter-smooth) */
        details ul {
          max-height: 0;
          opacity: 0;
          overflow: hidden;
          will-change: max-height, opacity;
          transition: max-height 700ms cubic-bezier(.22,.9,.29,1), opacity 420ms ease;
          margin-top: 0.5rem;
          padding-left: 0.25rem;
        }

        details[open] ul {
          max-height: 1000px; /* large enough to reveal content */
          opacity: 1;
          transition: max-height 860ms cubic-bezier(.22,.9,.29,1), opacity 520ms ease 80ms;
        }

        /* Extra-smooth animation for Contact section */
        details[data-section="Contact"] ul {
          will-change: max-height, opacity;
          transition: max-height 900ms cubic-bezier(.22,.9,.29,1), opacity 620ms ease;
        }

        details[data-section="Contact"][open] ul {
          transition: max-height 1080ms cubic-bezier(.22,.9,.29,1), opacity 720ms ease 120ms;
        }

        /* Animate list items for a smoother feel */
        details ul li {
          transform: translateY(-8px);
          opacity: 0;
          will-change: transform, opacity;
          transition: transform 520ms cubic-bezier(.22,.9,.29,1), opacity 420ms ease;
        }

        details[open] ul li:nth-child(1) { transition-delay: 80ms; }
        details[open] ul li:nth-child(2) { transition-delay: 140ms; }
        details[open] ul li:nth-child(3) { transition-delay: 200ms; }
        details[open] ul li:nth-child(4) { transition-delay: 260ms; }
        details[open] ul li:nth-child(5) { transition-delay: 320ms; }
        details[open] ul li:nth-child(6) { transition-delay: 380ms; }

        details[open] ul li { transform: translateY(0); opacity: 1; }

        /* Ensure content appears above divider */
        details summary,
        details ul {
          position: relative;
          z-index: 1;
        }

        /* Remove hover transform/highlight on mobile to avoid sudden visual feedback */
        details summary:hover { background: transparent; transform: none; }

        /* Make the follow-us block centered on mobile (heading + icons) */
        .footer-follow { text-align: center; }
        .footer-follow-icons {
          width: 100%;
          justify-content: center;
          margin-left: 0;
          margin-right: 0;
        }

        /* Ensure icon children are spaced evenly and remain tappable */
        .footer-follow-icons > * { margin-left: 0.375rem; margin-right: 0.375rem; }
      }
    </style>
  </div>
</footer>
