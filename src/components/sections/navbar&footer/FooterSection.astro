---
import FooterSocialLink from '@components/ui/links/FooterSocialLink.astro';
import Icon from '@components/ui/icons/Icon.astro';
import enStrings from '@utils/navigation.ts';
import footerLogo from '@images/mprl_logo_white.png';
import isoLogoUrl from '@images/iso/ISO.svg?url';
import isoCertificateUrl from '@images/iso/iso_certificate.pdf?url';

const strings = enStrings;
const companyEmail = 'info@mehtapetro.com';

const phoneNumbers = [
  { label: '022-44559090', href: 'tel:+912244559090' },
  { label: '35218451', href: 'tel:+912235218451' },
  { label: '35218543', href: 'tel:+912235218543' },
  { label: '35219242', href: 'tel:+912235219242' },
  { label: '35219404', href: 'tel:+912235219404' },
];

const currentYear = new Date().getFullYear();
const officeDirectionsUrl = 'https://maps.app.goo.gl/hgSz19X7oDFZaYdZ6';
---

<footer
  class="mt-12 w-full border-t border-[#1B46D8] bg-[#0A2FB8] text-white sm:mt-16 md:mt-20"
>
  <div
    class="mx-auto w-full max-w-[85rem] px-4 py-8 pb-[max(2rem,env(safe-area-inset-bottom))] sm:px-6 sm:py-10 lg:px-8 lg:py-16"
  >
    <div
      class="grid grid-cols-1 gap-8 sm:grid-cols-2 sm:gap-x-8 sm:gap-y-10 lg:grid-cols-[1.15fr_0.7fr_0.9fr_1.1fr] lg:gap-10"
    >
      {/* Brand */}
      <div>
        <a
          href="/"
          class="inline-block outline-hidden focus-visible:ring-3 focus-visible:ring-white/40"
        >
          <img
            src={footerLogo.src}
            alt="Mehta Petro-Refineries Limited"
            width={footerLogo.width}
            height={footerLogo.height}
            class="h-12 w-auto sm:h-14 lg:h-16"
            loading="lazy"
            decoding="async"
          />
        </a>
        <p
          class="mt-3 text-lg leading-tight font-bold tracking-tight text-white/98 sm:mt-4 sm:text-xl lg:text-[22px]"
        >
          Mehta Petro-Refineries Limited
        </p>
        <div class="mt-2 max-w-xl space-y-1.5 sm:mt-3 sm:space-y-2">
          <p
            class="text-[11px] leading-snug font-semibold tracking-[0.14em] text-white/80 uppercase sm:text-xs sm:tracking-[0.15em]"
          >
            Performance Through Quality
          </p>
          <p class="text-sm leading-relaxed text-white/74 sm:text-[15px] lg:text-[16px]">
            Manufacturers of Petrochemicals & Specialty Base Oils
          </p>
          <p
            class="text-[11px] font-medium tracking-[0.18em] text-white/68 uppercase sm:text-xs"
          >
            Since 1993
          </p>
        </div>
      </div>

      {/* Navigation */}
      <div>
        {
          strings.footerLinks.map(section => (
            <div>
              <h3 class="text-[11px] font-semibold tracking-[0.2em] text-white/54 uppercase">
                {section.section}
              </h3>
              <ul class="mt-3 grid grid-cols-2 gap-x-3 gap-y-1 sm:mt-4 lg:grid-cols-1 lg:gap-y-2">
                {section.links.map(link => (
                  <li>
                    <a
                      href={link.url}
                      class="inline-flex min-h-10 items-center text-sm font-medium text-white/80 transition-colors hover:text-white"
                    >
                      {link.name}
                    </a>
                  </li>
                ))}
              </ul>
            </div>
          ))
        }
      </div>

      {/* Contact */}
      <div>
        <h3
          class="text-[11px] font-semibold tracking-[0.2em] text-white/54 uppercase"
        >
          Contact
        </h3>

        <div class="mt-3 space-y-4 sm:mt-4 lg:mt-5 lg:space-y-5">
          <div>
            <p class="text-xs font-medium text-white/54 uppercase">Email</p>
            <a
              href={`mailto:${companyEmail}`}
              class="mt-1.5 inline-flex min-h-10 items-center text-sm font-medium break-all text-white/82 transition-colors hover:text-white"
            >
              {companyEmail}
            </a>
          </div>

          <div>
            <p class="text-xs font-medium text-white/54 uppercase">Phone</p>
            <div
              class="mt-2 grid grid-cols-2 gap-x-3 gap-y-1 sm:mt-3 lg:grid-cols-1 xl:grid-cols-2"
            >
              {
                phoneNumbers.map(phone => (
                  <a
                    href={phone.href}
                    class="inline-flex min-h-9 items-center text-sm text-white/82 transition-colors hover:text-white sm:min-h-10"
                  >
                    {phone.label}
                  </a>
                ))
              }
            </div>
          </div>
        </div>
      </div>

      {/* Office + map */}
      <div>
        <h3
          class="text-[11px] font-semibold tracking-[0.2em] text-white/54 uppercase"
        >
          Corporate Office
        </h3>
        <p class="mt-3 max-w-md text-sm leading-relaxed text-white/74 lg:mt-5">
          509, HIVE 67, ICON Tower, Borsapada Road, Next to Raghuleela Mall,
          Kandivali (West), Mumbai 400067, India
        </p>

        {/* Compact directions until full desktop layout */}
        <a
          href={officeDirectionsUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="mt-4 inline-flex min-h-11 w-full items-center justify-center rounded-xl border border-white/18 bg-white/8 px-4 text-sm font-semibold text-white/90 transition-colors hover:border-white/30 hover:bg-white/12 hover:text-white lg:hidden"
        >
          Get directions
        </a>

        <div
          class="mt-4 hidden overflow-hidden rounded-xl border border-white/12 lg:mt-5 lg:block lg:rounded-2xl"
        >
          <iframe
            class="h-48 w-full"
            src="https://www.google.com/maps/embed?pb=!1m14!1m8!1m3!1d7535.136593831896!2d72.848887!3d19.214049!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x3be71ccfa59893e3%3A0x6aab7ca9656cdb12!2sMehta%20Petro%20Refineries%20Ltd!5e0!3m2!1sen!2sin!4v1785383107592!5m2!1sen!2sin"
            style="border:0;"
            allowfullscreen=""
            loading="lazy"
            referrerpolicy="strict-origin-when-cross-origin"
            title="Mehta Petro location map"></iframe>
        </div>

        <div class="mt-4 flex items-center gap-3 lg:mt-5">
          <img
            src={isoLogoUrl}
            alt="ISO 9001:2015"
            class="h-12 w-auto shrink-0 rounded-md bg-white px-2 py-1 sm:h-14"
            loading="lazy"
            decoding="async"
          />
          <div>
            <p class="text-xs font-medium text-white/54 uppercase">Certified</p>
            <p class="mt-0.5 text-sm font-semibold text-white/88 sm:mt-1">
              ISO 9001:2015
            </p>
            <a
              href={`${isoCertificateUrl}#page=1&zoom=page-fit`}
              target="_blank"
              rel="noopener noreferrer"
              class="mt-1 inline-flex min-h-9 items-center text-sm text-white/76 transition-colors hover:text-white"
              aria-label="View ISO certificate PDF"
            >
              View Certificate
            </a>
          </div>
        </div>
      </div>
    </div>

    <div class="mt-8 border-t border-white/10 pt-5 sm:mt-8 sm:pt-6 lg:mt-10">
      <div
        class="flex flex-col gap-5 sm:flex-row sm:items-center sm:justify-between"
      >
        <div class="footer-follow">
          <p
            class="text-[11px] font-semibold tracking-[0.2em] text-white/54 uppercase"
          >
            Follow Us
          </p>
          <div
            class="footer-follow-icons mt-3 flex flex-wrap items-center gap-3 sm:justify-start"
          >
            <FooterSocialLink
              url={strings.socialLinks.facebook}
              label="Facebook"
            >
              <Icon name="facebookFooter" />
            </FooterSocialLink>
            <FooterSocialLink
              url={strings.socialLinks.linkedin}
              label="LinkedIn"
            >
              <Icon name="linkedinFooter" />
            </FooterSocialLink>
            <FooterSocialLink url={strings.socialLinks.x} label="X">
              <Icon name="xFooter" />
            </FooterSocialLink>
            <FooterSocialLink
              url={strings.socialLinks.instagram}
              label="Instagram"
            >
              <Icon name="instagramFooter" />
            </FooterSocialLink>
            <FooterSocialLink url={strings.socialLinks.youtube} label="YouTube">
              <Icon name="youtubeFooter" />
            </FooterSocialLink>
          </div>
        </div>

        <div class="text-center sm:text-right">
          <p class="text-xs text-white/64 sm:text-sm">
            © {currentYear} Mehta Petro-Refineries Limited. All rights reserved.
          </p>
          <p class="mt-1.5 text-xs text-white/64 sm:mt-2 sm:text-sm">
            Crafted by
            {` `}
            <a
              class="font-medium text-white/84 transition-colors hover:text-white"
              href="https://eightharsh.com/"
              target="_blank"
              rel="noopener noreferrer">eightharsh</a
            >.
          </p>
        </div>
      </div>
    </div>

    <style>
      @media (max-width: 639px) {
        .footer-follow {
          text-align: center;
        }

        .footer-follow-icons {
          justify-content: center;
        }
      }
    </style>
  </div>
</footer>
