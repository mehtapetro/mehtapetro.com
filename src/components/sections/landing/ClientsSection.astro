---
import { getImage } from 'astro:assets';
import type { ImageMetadata } from 'astro';

const { title, subTitle, partners } = Astro.props;

interface Partner {
  src: ImageMetadata;
  alt?: string;
}

interface Props {
  title: string;
  subTitle?: string;
  partners: Partner[];
}

const isSvg = (src: ImageMetadata) => src.format === 'svg';

const resolvedPartners = await Promise.all(
  partners.map(async partner => {
    if (isSvg(partner.src)) {
      return { ...partner, mobileSrc: partner.src.src };
    }

    const mobile = await getImage({
      src: partner.src,
      width: 176,
      format: 'webp',
      quality: 70,
    });

    return { ...partner, mobileSrc: mobile.src };
  })
);
---

<section class="bg-white/60">
  <div
    class="mx-auto max-w-[85rem] px-4 py-10 sm:px-6 sm:py-14 lg:px-8 lg:py-20"
  >
    <div class="max-w-3xl">
      <h2
        class="text-2xl font-bold tracking-tight text-[#0A1F4D] sm:text-3xl md:text-4xl"
      >
        {title}
      </h2>
      {
        subTitle && (
          <p class="mt-3 text-sm leading-relaxed text-[#4A5F8C] sm:mt-4 sm:text-base md:text-lg">
            {subTitle}
          </p>
        )
      }
    </div>

    <div class="client-marquee mt-8 sm:mt-10">
      <div class="client-marquee__viewport">
        <div class="client-marquee__sequence">
          {
            resolvedPartners.map((partner, index) => (
              <div class="client-marquee__item">
                <picture>
                  <source
                    media="(max-width: 767px)"
                    srcset={partner.mobileSrc}
                  />
                  <img
                    src={partner.src.src}
                    width={partner.src.width}
                    height={partner.src.height}
                    alt={partner.alt || 'Client logo'}
                    class="client-marquee__image"
                    loading={index < 2 ? 'eager' : 'lazy'}
                    decoding="async"
                  />
                </picture>
              </div>
            ))
          }
        </div>
        <div class="client-marquee__sequence" aria-hidden="true">
          {
            resolvedPartners.map(partner => (
              <div class="client-marquee__item">
                <picture>
                  <source
                    media="(max-width: 767px)"
                    srcset={partner.mobileSrc}
                  />
                  <img
                    src={partner.src.src}
                    width={partner.src.width}
                    height={partner.src.height}
                    alt=""
                    class="client-marquee__image"
                    loading="lazy"
                    decoding="async"
                  />
                </picture>
              </div>
            ))
          }
        </div>
      </div>
    </div>
  </div>
</section>
