---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

const { title, subTitle, partners } = Astro.props;

interface Partner {
  src: ImageMetadata;
  alt?: string;
}

interface Props {
  title: string;
  subTitle?: string;
  partners: Partner[];
}

const isSvg = (src: ImageMetadata) => src.format === 'svg';
---

<section class="border-y border-[#C0D6FF]/70 bg-white">
  <div
    class="mx-auto max-w-[85rem] px-4 pt-10 pb-8 sm:px-6 sm:pt-14 sm:pb-10 lg:px-8 lg:pt-20 lg:pb-14"
  >
    <div class="max-w-3xl">
      <h2
        class="text-2xl font-bold tracking-tight text-[#0A1F4D] sm:text-3xl md:text-4xl"
      >
        {title}
      </h2>
      {
        subTitle && (
          <p class="mt-3 text-sm leading-relaxed text-[#4A5F8C] sm:mt-4 sm:text-base md:text-lg">
            {subTitle}
          </p>
        )
      }
    </div>

    <div class="client-marquee mt-8 sm:mt-10" aria-label="Client logos">
      <div class="client-marquee__viewport">
        <div class="client-marquee__sequence">
          {
            partners.map((partner, index) => (
              <div class="client-marquee__item">
                {isSvg(partner.src) ? (
                  <img
                    src={partner.src.src}
                    width={partner.src.width}
                    height={partner.src.height}
                    alt={partner.alt || 'Client logo'}
                    class="client-marquee__image"
                    loading={index < 4 ? 'eager' : 'lazy'}
                    decoding="async"
                  />
                ) : (
                  <Image
                    src={partner.src}
                    alt={partner.alt || 'Client logo'}
                    widths={[180, 260, 360]}
                    sizes="(min-width: 1024px) 180px, (min-width: 640px) 160px, 140px"
                    width={260}
                    format="webp"
                    quality={90}
                    class="client-marquee__image"
                    loading={index < 4 ? 'eager' : 'lazy'}
                    decoding="async"
                  />
                )}
              </div>
            ))
          }
        </div>
        <div class="client-marquee__sequence" aria-hidden="true">
          {
            partners.map(partner => (
              <div class="client-marquee__item">
                {isSvg(partner.src) ? (
                  <img
                    src={partner.src.src}
                    width={partner.src.width}
                    height={partner.src.height}
                    alt=""
                    class="client-marquee__image"
                    loading="lazy"
                    decoding="async"
                  />
                ) : (
                  <Image
                    src={partner.src}
                    alt=""
                    widths={[180, 260, 360]}
                    sizes="(min-width: 1024px) 180px, (min-width: 640px) 160px, 140px"
                    width={260}
                    format="webp"
                    quality={90}
                    class="client-marquee__image"
                    loading="lazy"
                    decoding="async"
                  />
                )}
              </div>
            ))
          }
        </div>
      </div>
    </div>
  </div>
</section>
