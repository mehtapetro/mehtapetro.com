---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

const { title, subTitle, partners } = Astro.props;

interface Partner {
  src: ImageMetadata;
  alt?: string;
}

interface Props {
  title: string;
  subTitle?: string;
  partners: Partner[];
}

const isSvg = (src: ImageMetadata) => src.format === 'svg';
---

<section class="bg-white" aria-labelledby="clients-title">
  <div class="home-container home-section-space">
    <div data-reveal class="mx-auto max-w-2xl text-center">
      <h2 id="clients-title" class="home-section-title">
        {title}
      </h2>
      {subTitle && <p class="home-section-copy mt-4">{subTitle}</p>}
    </div>

    <div
      class="client-marquee mt-6 py-2 sm:mt-8 sm:py-3"
      role="region"
      aria-label="Client logos"
      data-client-marquee
    >
      <div class="client-marquee__viewport">
        <div class="client-marquee__sequence">
          {
            partners.map((partner, index) => (
              <div class="client-marquee__item">
                {isSvg(partner.src) ? (
                  <img
                    src={partner.src.src}
                    width={partner.src.width}
                    height={partner.src.height}
                    alt={partner.alt || 'Client logo'}
                    class="client-marquee__image"
                    loading={index < 4 ? 'eager' : 'lazy'}
                    decoding="async"
                  />
                ) : (
                  <Image
                    src={partner.src}
                    alt={partner.alt || 'Client logo'}
                    widths={[180, 260, 360]}
                    sizes="(min-width: 1024px) 180px, (min-width: 640px) 160px, 140px"
                    width={260}
                    format="webp"
                    quality={90}
                    class="client-marquee__image"
                    loading={index < 4 ? 'eager' : 'lazy'}
                    decoding="async"
                  />
                )}
              </div>
            ))
          }
        </div>
        <div class="client-marquee__sequence" aria-hidden="true">
          {
            partners.map(partner => (
              <div class="client-marquee__item">
                {isSvg(partner.src) ? (
                  <img
                    src={partner.src.src}
                    width={partner.src.width}
                    height={partner.src.height}
                    alt=""
                    class="client-marquee__image"
                    loading="lazy"
                    decoding="async"
                  />
                ) : (
                  <Image
                    src={partner.src}
                    alt=""
                    widths={[180, 260, 360]}
                    sizes="(min-width: 1024px) 180px, (min-width: 640px) 160px, 140px"
                    width={260}
                    format="webp"
                    quality={90}
                    class="client-marquee__image"
                    loading="lazy"
                    decoding="async"
                  />
                )}
              </div>
            ))
          }
        </div>
      </div>
    </div>
  </div>
</section>
