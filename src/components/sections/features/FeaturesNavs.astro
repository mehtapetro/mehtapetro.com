---
import TabNav from '@components/ui/blocks/TabNav.astro';
import TabContent from '@components/ui/blocks/TabContent.astro';

const { title, subTitle, tabs } = Astro.props;

interface Tab {
  heading: string;
  content: string;
  src: any;
  alt: string;
  first?: boolean;
  second?: boolean;
  srcName?: string;
}

interface Props {
  title?: string;
  subTitle?: string;
  tabs: Tab[];
}
---

<section
  class="bg-[#F5F9FF]"
  aria-labelledby="product-categories-title"
  data-product-rotation
>
  <div
    class="home-container home-section-space grid gap-y-6 lg:grid-cols-12 lg:gap-x-12 xl:gap-x-16"
  >
    <div
      data-reveal
      class="max-w-xl lg:col-span-5 lg:col-start-1 lg:row-start-1"
    >
      <h2 id="product-categories-title" class="home-section-title max-w-[16ch]">
        {title}
      </h2>
      {
        subTitle && (
          <p class="home-section-copy mt-4 max-w-[44ch]">{subTitle}</p>
        )
      }
    </div>

    <div class="lg:col-span-5 lg:col-start-1 lg:row-start-2">
      <nav
        class="divide-y divide-[#D4E4FF] border-y border-[#D4E4FF]"
        aria-label="Product categories"
        role="tablist"
        aria-orientation="vertical"
      >
        {
          tabs.map((tab, index) => (
            <TabNav
              id={`tabs-with-card-item-${index + 1}`}
              dataTab={`#tabs-with-card-${index + 1}`}
              aria={`tabs-with-card-${index + 1}`}
              heading={tab.heading}
              content={tab.content}
              first={tab.first}
            />
          ))
        }
      </nav>
    </div>
    <!-- Keep the preview below the category controls on mobile. -->
    <div
      class="relative overflow-hidden rounded-2xl bg-[#E8F0FF] lg:col-span-7 lg:col-start-6 lg:row-span-3 lg:row-start-1"
    >
      {
        tabs.map((tab, index) => (
          <TabContent
            id={`tabs-with-card-${index + 1}`}
            aria={`tabs-with-card-item-${index + 1}`}
            src={tab.src}
            alt={tab.alt}
            first={tab.first}
            second={tab.second}
            srcName={tab.srcName}
          />
        ))
      }
    </div>
    <div
      class="flex flex-wrap items-center justify-between gap-x-4 gap-y-1 lg:col-span-5 lg:col-start-1 lg:row-start-3"
    >
      <a
        href="/products"
        class="inline-flex min-h-11 items-center border-b border-[#9FB7FF] font-semibold text-[#002285] transition-colors hover:border-[#0039E6] hover:text-[#0039E6] focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-[#0039E6]"
        >View all products</a
      >
      <button
        type="button"
        hidden
        data-product-rotation-toggle
        class="min-h-11 rounded-md px-2 text-sm font-medium text-[#4A5F8C] underline-offset-4 hover:text-[#002285] hover:underline focus-visible:outline-2 focus-visible:outline-[#0039E6]"
        >Pause rotation</button
      >
    </div>
  </div>
</section>

<script>
  import '@scripts/productCategoryRotation.js';
</script>
