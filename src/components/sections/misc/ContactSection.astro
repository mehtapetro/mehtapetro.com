---
import AuthBtn from '@components/ui/buttons/AuthBtn.astro';
import ContactIconBlock from '@components/ui/blocks/ContactIconBlock.astro';
import TextInput from '@components/ui/forms/input/TextInput.astro';
import EmailContactInput from '@components/ui/forms/input/EmailContactInput.astro';
import PhoneInput from '@components/ui/forms/input/PhoneInput.astro';
import TextAreaInput from '@components/ui/forms/input/TextAreaInput.astro';
import Icon from '@components/ui/icons/Icon.astro';
import { getMarketingLocale } from '@utils/locale';

const locale = getMarketingLocale(Astro.url.pathname, Astro.currentLocale);
const web3FormsAccessKey = 'e138342b-b691-410c-a7fb-3b3ce5a49ea6';
const siteOrigin = 'https://mehtapetro.vercel.app';
const contactPath = locale === 'fr' ? '/fr/contact' : '/contact';
const contactSource = `${siteOrigin}${contactPath}`;

const copy =
  locale === 'fr'
    ? {
        title: 'Contactez-nous',
        subTitle:
          "Vous avez des questions ou souhaitez discuter d'un projet ? Contactez-nous et laissons-nous élaborer la solution parfaite avec nos outils et services.",
        formTitle: 'Remplissez le formulaire ci-dessous',
        formSubTitle:
          'Nous vous répondrons dans un délai de 1 à 2 jours ouvrables.',
        sendAnother: 'Envoyer un autre message',
        firstName: 'Prénom',
        lastName: 'Nom',
        details: 'Détails',
        phoneNumber: 'Numéro de téléphone',
        countryCode: 'Indicatif pays',
        send: 'Envoyer un message',
        successMessage: 'Merci ! Votre message a bien été envoyé.',
        errorMessage:
          "Désolé, nous n'avons pas pu envoyer votre message pour le moment. Veuillez réessayer.",
        sendingMessage: 'Envoi en cours…',
        knowledgeHeading: 'Base de connaissances',
        knowledgeContent:
          'Parcourez tous nos articles de base de connaissances.',
        knowledgeLink: 'Visiter les guides et tutoriels',
        faqHeading: 'FAQ',
        faqContent:
          'Explorez notre FAQ pour des réponses rapides et claires aux questions courantes.',
        faqLink: 'Visiter la FAQ',
        officeHeading: 'Visitez notre bureau',
        officeContent: 'Mehta Petro-Refineries Limited',
        emailHeading: 'Contactez-nous par e-mail',
        emailContent: 'Préférez-vous le texte écrit ? Envoyez-nous un e-mail à',
      }
    : {
        title: 'Contact us',
        subTitle:
          "Have questions or want to discuss a project? Reach out, and let's craft the perfect solution with our tools and services.",
        formTitle: 'Fill in the form below',
        formSubTitle: "We'll get back to you in 1-2 business days.",
        sendAnother: 'Send another message',
        firstName: 'First Name',
        lastName: 'Last Name',
        details: 'Details',
        phoneNumber: 'Phone Number',
        countryCode: 'Country Code',
        send: 'Send Message',
        successMessage: 'Thanks! Your message has been sent.',
        errorMessage:
          'Sorry, we could not send your message right now. Please try again.',
        sendingMessage: 'Sending your message…',
        knowledgeHeading: 'Knowledgebase',
        knowledgeContent: 'Browse through all of our knowledgebase articles.',
        knowledgeLink: 'Visit guides & tutorials',
        faqHeading: 'FAQ',
        faqContent:
          'Explore our FAQ for quick, clear answers to common queries.',
        faqLink: 'Visit FAQ',
        officeHeading: 'Visit our office',
        officeContent: 'Mehta Petro-Refineries Limited',
        emailHeading: 'Contact us by email',
        emailContent: 'Prefer the written word? Drop us an email at',
      };
---

<section class="mx-auto max-w-[85rem] px-4 py-10 sm:px-6 lg:px-8 lg:py-14">
  <div class="mx-auto max-w-2xl lg:max-w-5xl">
    <div class="text-center">
      <h1
        class="text-2xl font-bold tracking-tight text-balance text-neutral-800 md:text-4xl md:leading-tight"
      >
        {copy.title}
      </h1>
      <p class="mt-1 text-pretty text-neutral-600">
        {copy.subTitle}
      </p>
    </div>

    <div class="mt-12 grid items-center gap-6 lg:grid-cols-2 lg:gap-16">
      <div class="flex flex-col rounded-[2rem] border border-white/70 bg-white/70 p-4 shadow-[0_30px_90px_-55px_rgba(30,58,255,0.28)] backdrop-blur-sm sm:p-6 lg:p-8">
        <h2 class="mb-8 text-xl font-bold text-[#10245F]">
          {copy.formTitle}
        </h2>
        <form
          id="contact-form"
          data-contact-form
          action="https://api.web3forms.com/submit"
          method="post"
          class="space-y-4"
          data-success-message={copy.successMessage}
          data-error-message={copy.errorMessage}
          data-sending-message={copy.sendingMessage}
          data-send-another-message={copy.sendAnother}
        >
          <div class="grid gap-4">
            <input type="hidden" name="access_key" value={web3FormsAccessKey} />
            <input type="hidden" name="subject" value="New website enquiry from Mehta Petro" />
            <input type="hidden" name="from_name" value="Mehta Petro Website" />
            <input type="hidden" name="source" value={contactSource} />
            <div class="hidden" aria-hidden="true">
              <label for="company-name">Company</label>
              <input
                id="company-name"
                type="text"
                name="company"
                tabindex="-1"
                autocomplete="off"
              />
            </div>
            <div class="grid grid-cols-1 gap-4 sm:grid-cols-2">
              <TextInput
                id="hs-firstname-contacts"
                label={copy.firstName}
                name="name"
              />
              <TextInput
                id="hs-lastname-contacts"
                label={copy.lastName}
                name="lastName"
                required={false}
              />
            </div>
            <EmailContactInput id="hs-email-contacts" />
            <PhoneInput
              id="hs-phone-number"
              countryId="hs-phone-country-code"
              label={copy.phoneNumber}
              countryLabel={copy.countryCode}
              defaultCountryCode="IN"
            />
            <TextAreaInput
              id="hs-about-contacts"
              label={copy.details}
              name="message"
            />
          </div>

          <div class="rounded-2xl border border-[#E4ECFF] bg-[#F8FAFF] px-4 py-3">
            <div class="flex flex-col gap-3 sm:flex-row sm:items-center sm:justify-between">
              <p class="text-sm text-neutral-600">
                {copy.formSubTitle}
              </p>
              <p
                class="hidden text-sm font-medium"
                data-form-status
                aria-live="polite"
              ></p>
            </div>
          </div>

          <div class="mt-4 grid">
            <AuthBtn title={copy.send} />
          </div>
        </form>
      </div>

      <div class="divide-y divide-[#DCE8FF]">
        <ContactIconBlock
          heading={copy.knowledgeHeading}
          content={copy.knowledgeContent}
          isLinkVisible={true}
          linkTitle={copy.knowledgeLink}
          linkURL="#"
          isArrowVisible={true}
          ><Icon name="question" />
        </ContactIconBlock>

        <ContactIconBlock
          heading={copy.faqHeading}
          content={copy.faqContent}
          isLinkVisible={true}
          linkTitle={copy.faqLink}
          linkURL="#"
          isArrowVisible={true}
          ><Icon name="chatBubble" />
        </ContactIconBlock>

        <ContactIconBlock
          heading={copy.officeHeading}
          content={copy.officeContent}
          isAddressVisible={true}
          addressContent="509, HIVE 67, ICON Tower, Borsapada Road, Next to Raghuleela Mall, Kandivali (West), Mumbai 400067, India."
          ><Icon name="mapPin" />
        </ContactIconBlock>

        <ContactIconBlock
          heading={copy.emailHeading}
          content={copy.emailContent}
          isLinkVisible={true}
          linkTitle="info@mehtapetro.com"
          linkURL="mailto:info@mehtapetro.com"
          ><Icon name="envelopeOpen" />
        </ContactIconBlock>
      </div>
    </div>
  </div>
</section>
