---
import AuthBtn from '@components/ui/buttons/AuthBtn.astro';
import TextInput from '@components/ui/forms/input/TextInput.astro';
import EmailContactInput from '@components/ui/forms/input/EmailContactInput.astro';
import PhoneInput from '@components/ui/forms/input/PhoneInput.astro';
import TextAreaInput from '@components/ui/forms/input/TextAreaInput.astro';
import { WEB3FORMS_ACCESS_KEY } from '@/data/web3forms';
import { SITE } from '@data/constants';

const web3FormsAccessKey = WEB3FORMS_ACCESS_KEY;
const contactSource = `${SITE.url}/contact`;

const copy = {
  title: 'Contact us',
  subTitle:
    'Have a product requirement or commercial question? Send us a message and our team will respond promptly.',
  formTitle: 'Send a message',
  firstName: 'First Name',
  lastName: 'Last Name',
  details: 'Message',
  phoneNumber: 'Phone Number',
  countryCode: 'Country Code',
  send: 'Send Message',
  successMessage:
    'Thank you for contacting us. Our team shall get in touch with you shortly.',
  errorMessage:
    'Sorry, we could not send your message right now. Please try again.',
  sendingMessage: 'Sending your message…',
  directionsLabel: 'Get directions',
};

const locations = [
  {
    heading: 'Corporate Office',
    label: 'Head office',
    content: 'Mehta Petro-Refineries Limited',
    address:
      '509, HIVE-67, Borasapada Road, Next to Raghuleela Mall, Near Poinsure Gymkhana, Kandivali (West), Mumbai - 400067, Maharashtra',
    directionsUrl: 'https://maps.app.goo.gl/hgSz19X7oDFZaYdZ6',
  },
  {
    heading: 'Factory I — Palghar',
    label: 'Manufacturing',
    content: 'Palghar Manufacturing Facility',
    address:
      'Plot No. 1, Dewan & Sons Udyog, Village - Mahim, Palghar - 401 404, Maharashtra',
    directionsUrl: 'https://maps.app.goo.gl/caGEQ7bkokJNAsXB9',
  },
  {
    heading: 'Factory II — Dahej',
    label: 'Manufacturing',
    content: 'Dahej Manufacturing Facility',
    address: 'D-2/CH-15, GIDC Dahej II, Dahej, Bharuch - 392 160, Gujarat',
    directionsUrl: 'https://maps.app.goo.gl/uBWSCEKzM2LzDmdZ8',
  },
];

const inquiryOptions = [
  { value: 'product', label: 'Product' },
  { value: 'career', label: 'Career' },
  { value: 'general', label: 'General' },
  { value: 'sales', label: 'Sales' },
  { value: 'support', label: 'Support' },
  { value: 'other', label: 'Other' },
];

const fieldClass =
  'block min-h-12 w-full rounded-xl border border-neutral-200 bg-neutral-50 px-4 py-3 text-base text-neutral-700 placeholder:text-neutral-500 focus:border-[#C0D6FF] focus:ring-3 focus:ring-[#C0D6FF]/60 focus:outline-hidden sm:min-h-11 sm:text-sm';
---

<section
  class="mx-auto max-w-[85rem] px-4 py-10 sm:px-6 sm:py-12 lg:px-8 lg:py-16"
>
  <div class="mx-auto max-w-5xl">
    <div class="max-w-3xl">
      <p
        class="text-xs font-semibold tracking-[0.18em] text-[#0039E6] uppercase"
      >
        Get in touch
      </p>
      <h1
        class="mt-3 text-3xl font-extrabold tracking-tight text-balance text-[#0A1F4D] sm:text-4xl md:text-5xl"
      >
        {copy.title}
      </h1>
      <p
        class="mt-3 text-sm leading-relaxed text-[#4A5F8C] sm:mt-4 sm:text-base md:text-lg"
      >
        {copy.subTitle}
      </p>
    </div>

    {/* Mobile quick actions */}
    <div class="mt-6 grid grid-cols-2 gap-3 lg:hidden">
      <a
        href="mailto:info@mehtapetro.com"
        class="inline-flex min-h-12 items-center justify-center gap-2 rounded-xl bg-[#0039E6] px-3 text-sm font-semibold text-white shadow-sm active:bg-[#0033CC]"
      >
        Email
      </a>
      <a
        href="tel:+912244559090"
        class="inline-flex min-h-12 items-center justify-center gap-2 rounded-xl border border-[#D4E4FF] bg-white px-3 text-sm font-semibold text-[#0039E6] shadow-sm active:bg-[#F5F9FF]"
      >
        Call
      </a>
    </div>

    <div
      class="mt-8 grid gap-10 sm:mt-10 lg:mt-12 lg:grid-cols-2 lg:items-start lg:gap-12"
    >
      {/* Form */}
      <div
        class="rounded-2xl border border-[#D4E4FF] bg-white shadow-[0_20px_50px_-40px_rgba(10,31,77,0.35)]"
      >
        <div
          class="rounded-t-2xl border-b border-[#E3EBFF] bg-linear-to-br from-[#F7FAFF] via-white to-white px-4 py-4 sm:px-6 sm:py-5"
        >
          <p
            class="text-[11px] font-semibold tracking-wider text-[#0039E6] uppercase sm:text-xs"
          >
            Enquiry form
          </p>
          <h2 class="mt-1.5 text-xl font-bold text-[#0A1F4D] sm:text-2xl">
            {copy.formTitle}
          </h2>
        </div>

        <form
          id="contact-form"
          data-contact-form
          action="https://api.web3forms.com/submit"
          method="post"
          class="flex flex-col gap-4 px-4 py-5 sm:gap-4 sm:px-6 sm:py-6"
          data-success-message={copy.successMessage}
          data-error-message={copy.errorMessage}
          data-sending-message={copy.sendingMessage}
        >
          <input type="hidden" name="access_key" value={web3FormsAccessKey} />
          <input
            type="hidden"
            name="subject"
            value="New website enquiry from Mehta Petro"
          />
          <input type="hidden" name="from_name" value="Mehta Petro Website" />
          <input type="hidden" name="source" value={contactSource} />
          <input
            type="checkbox"
            name="botcheck"
            class="hidden"
            style="display: none;"
            tabindex="-1"
            autocomplete="off"
          />

          <div class="grid grid-cols-1 gap-4 sm:grid-cols-2">
            <TextInput
              id="hs-firstname-contacts"
              label={copy.firstName}
              name="firstName"
            />
            <TextInput
              id="hs-lastname-contacts"
              label={copy.lastName}
              name="lastName"
              required={false}
            />
          </div>

          <EmailContactInput id="hs-email-contacts" />

          <PhoneInput
            id="hs-phone-number"
            countryId="hs-phone-country-code"
            label={copy.phoneNumber}
            countryLabel={copy.countryCode}
            defaultCountryCode="IN"
            minDigits={10}
            maxDigits={10}
          />

          <div>
            <label for="hs-inquiry-type" class="sr-only">Inquiry type</label>
            <select
              id="hs-inquiry-type"
              name="inquiryType"
              required
              class={fieldClass}
            >
              <option value="" disabled selected>Inquiry type</option>
              {
                inquiryOptions.map(opt => (
                  <option value={opt.value}>{opt.label}</option>
                ))
              }
            </select>
          </div>

          <TextAreaInput
            id="hs-about-contacts"
            label={copy.details}
            name="message"
            rows={4}
            maxlength={500}
            showCharCount={true}
            class="min-h-[6.5rem] resize-y sm:min-h-[8rem]"
          />

          <p
            class="hidden min-h-[1.25rem] text-sm leading-6"
            data-form-status
            aria-live="polite"
          >
          </p>

          <div
            class="sticky bottom-0 -mx-4 border-t border-[#E3EBFF] bg-white/95 px-4 pt-4 pb-[max(1rem,env(safe-area-inset-bottom))] backdrop-blur-sm sm:static sm:mx-0 sm:bg-transparent sm:px-0 sm:pb-0 sm:backdrop-blur-none"
          >
            <AuthBtn title={copy.send} />
          </div>
        </form>
      </div>

      {/* Info + locations */}
      <div class="flex flex-col gap-10">
        <div class="hidden lg:block">
          <p
            class="text-xs font-semibold tracking-[0.16em] text-[#0039E6] uppercase"
          >
            Reach us directly
          </p>
          <h2 class="mt-2 text-xl font-bold text-[#0A1F4D] sm:text-2xl">
            Quick contact
          </h2>

          <div class="mt-5 flex flex-col gap-3">
            <a
              href="mailto:info@mehtapetro.com"
              class="group flex min-h-14 items-center gap-3 rounded-xl border border-[#D4E4FF] bg-white p-4 transition-colors hover:border-[#0039E6]"
            >
              <div
                class="flex h-10 w-10 shrink-0 items-center justify-center rounded-lg bg-[#0039E6] text-white"
              >
                <svg
                  class="h-5 w-5"
                  fill="none"
                  viewBox="0 0 24 24"
                  stroke="currentColor"
                  aria-hidden="true"
                >
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="2"
                    d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"
                  ></path>
                </svg>
              </div>
              <div class="min-w-0">
                <p class="text-xs font-medium text-[#4A5F8C]">Email</p>
                <p class="truncate text-sm font-semibold text-[#0A1F4D]">
                  info@mehtapetro.com
                </p>
              </div>
            </a>

            <a
              href="tel:+912244559090"
              class="group flex min-h-14 items-center gap-3 rounded-xl border border-[#D4E4FF] bg-white p-4 transition-colors hover:border-[#0039E6]"
            >
              <div
                class="flex h-10 w-10 shrink-0 items-center justify-center rounded-lg bg-[#0039E6] text-white"
              >
                <svg
                  class="h-5 w-5"
                  fill="none"
                  viewBox="0 0 24 24"
                  stroke="currentColor"
                  aria-hidden="true"
                >
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="2"
                    d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"
                  ></path>
                </svg>
              </div>
              <div class="min-w-0">
                <p class="text-xs font-medium text-[#4A5F8C]">Phone</p>
                <p class="text-sm font-semibold text-[#0A1F4D]">
                  +91 22 44559090
                </p>
              </div>
            </a>
          </div>
        </div>

        <div>
          <p
            class="text-xs font-semibold tracking-[0.16em] text-[#0039E6] uppercase"
          >
            Visit us
          </p>
          <h2 class="mt-2 text-xl font-bold text-[#0A1F4D] sm:text-2xl">
            Our locations
          </h2>

          <div class="mt-5 divide-y divide-[#D4E4FF] border-y border-[#D4E4FF]">
            {
              locations.map(location => (
                <div class="py-5">
                  <p class="text-[11px] font-semibold tracking-wider text-[#0039E6] uppercase">
                    {location.label}
                  </p>
                  <h3 class="mt-1 text-base font-bold text-[#0A1F4D]">
                    {location.heading}
                  </h3>
                  <p class="mt-0.5 text-sm text-[#4A5F8C]">
                    {location.content}
                  </p>
                  <p class="mt-2 text-sm leading-relaxed text-[#4A5F8C]">
                    {location.address}
                  </p>
                  <a
                    href={location.directionsUrl}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="mt-3 inline-flex min-h-11 items-center text-sm font-semibold text-[#0039E6] transition-colors hover:text-[#0033CC]"
                  >
                    {copy.directionsLabel}
                  </a>
                </div>
              ))
            }
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
