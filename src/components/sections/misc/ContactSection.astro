---
import AuthBtn from '@components/ui/buttons/AuthBtn.astro';
import TextInput from '@components/ui/forms/input/TextInput.astro';
import EmailContactInput from '@components/ui/forms/input/EmailContactInput.astro';
import PhoneInput from '@components/ui/forms/input/PhoneInput.astro';
import TextAreaInput from '@components/ui/forms/input/TextAreaInput.astro';
import { WEB3FORMS_ACCESS_KEY } from '@/data/web3forms';
import { SITE } from '@data/constants';

const web3FormsAccessKey = WEB3FORMS_ACCESS_KEY;
const contactSource = `${SITE.url}/contact`;

const copy = {
  title: 'Contact us',
  subTitle:
    'Have a product requirement or commercial question? Send us a message and our team will respond promptly.',
  formTitle: 'Send a message',
  firstName: 'First Name',
  lastName: 'Last Name',
  details: 'Message',
  phoneNumber: 'Phone Number',
  countryCode: 'Country Code',
  send: 'Send Message',
  successMessage:
    'Thank you for contacting us. Our team shall get in touch with you shortly.',
  errorMessage:
    'Sorry, we could not send your message right now. Please try again.',
  sendingMessage: 'Sending your message…',
  directionsLabel: 'Get directions',
};

const locations = [
  {
    heading: 'Corporate Office',
    label: 'Head office',
    content: 'Mehta Petro-Refineries Limited',
    address:
      '509, HIVE 67, ICON Tower, Borsapada Road, Next to Raghuleela Mall, Kandivali (West), Mumbai 400067, India',
    directionsUrl: 'https://maps.app.goo.gl/hgSz19X7oDFZaYdZ6',
  },
  {
    heading: 'Factory I — Palghar',
    label: 'Manufacturing',
    content: 'Palghar Manufacturing Facility',
    address:
      'Plot No. 1, Dewan & Sons Udyog, Village - Mahim, Palghar - 401 404, Maharashtra',
    directionsUrl: 'https://maps.app.goo.gl/caGEQ7bkokJNAsXB9',
  },
  {
    heading: 'Factory II — Dahej',
    label: 'Manufacturing',
    content: 'Dahej Manufacturing Facility',
    address: 'D-2/CH-15, GIDC Dahej II, Dahej, Bharuch - 392 160, Gujarat',
    directionsUrl: 'https://maps.app.goo.gl/uBWSCEKzM2LzDmdZ8',
  },
];

const inquiryOptions = [
  { value: 'product', label: 'Product' },
  { value: 'career', label: 'Career' },
  { value: 'general', label: 'General' },
  { value: 'sales', label: 'Sales' },
  { value: 'support', label: 'Support' },
  { value: 'other', label: 'Other' },
];

const fieldClass =
  'block min-h-12 w-full rounded-xl border border-neutral-200 bg-white/70 px-4 py-3 text-base text-neutral-700 placeholder:text-neutral-500 focus:border-[#C0D6FF] focus:ring-3 focus:ring-[#C0D6FF]/60 focus:outline-hidden sm:min-h-11 sm:text-sm';
---

<!-- Intro -->
<section class="border-b border-[#C0D6FF]/70 bg-[#E8F0FF]">
  <div
    class="mx-auto max-w-[85rem] px-4 py-10 sm:px-6 sm:py-14 lg:px-8 lg:py-16"
  >
    <div data-reveal class="max-w-3xl">
      <p
        class="text-xs font-semibold tracking-[0.18em] text-[#0039E6] uppercase"
      >
        Get in touch
      </p>
      <h1
        class="mt-3 text-3xl font-extrabold tracking-tight text-balance text-[#0A1F4D] sm:text-4xl md:text-5xl"
      >
        {copy.title}
      </h1>
      <p
        class="mt-4 text-sm leading-relaxed text-[#4A5F8C] sm:mt-5 sm:text-base md:text-lg"
      >
        {copy.subTitle}
      </p>
    </div>

    <div class="mt-6 grid grid-cols-2 gap-3 sm:mt-8 lg:hidden">
      <a
        href="mailto:info@mehtapetro.com"
        class="inline-flex min-h-12 items-center justify-center gap-2 rounded-xl bg-[#0039E6] px-3 text-sm font-semibold text-white active:bg-[#0033CC]"
      >
        Email
      </a>
      <a
        href="tel:+912244559090"
        class="inline-flex min-h-12 items-center justify-center gap-2 rounded-xl border border-[#C0D6FF] bg-white/70 px-3 text-sm font-semibold text-[#0039E6] active:bg-white"
      >
        Call
      </a>
    </div>
  </div>
</section>

<!-- Form -->
<section class="bg-[#E8F0FF]">
  <div
    class="mx-auto max-w-[85rem] px-4 py-10 sm:px-6 sm:py-14 lg:px-8 lg:py-16"
  >
    <div class="mx-auto max-w-3xl">
      <div class="max-w-2xl">
        <p
          class="text-xs font-semibold tracking-[0.18em] text-[#0039E6] uppercase"
        >
          Enquiry form
        </p>
        <h2
          class="mt-3 text-2xl font-bold tracking-tight text-[#0A1F4D] sm:text-3xl"
        >
          {copy.formTitle}
        </h2>
        <p class="mt-3 text-sm leading-relaxed text-[#4A5F8C] sm:text-base">
          Tell us the product, volume, and location when you can — it helps us
          respond faster.
        </p>
      </div>

      <div
        class="mt-6 flex flex-col gap-3 border-y border-[#C0D6FF]/70 py-5 sm:mt-8 sm:flex-row sm:gap-4 sm:py-6"
      >
        <a
          href="mailto:info@mehtapetro.com"
          class="inline-flex min-h-11 flex-1 items-center justify-center rounded-xl border border-[#C0D6FF] bg-white/70 px-4 text-sm font-semibold text-[#0A1F4D] transition hover:border-[#0039E6] hover:bg-white"
        >
          info@mehtapetro.com
        </a>
        <a
          href="tel:+912244559090"
          class="inline-flex min-h-11 flex-1 items-center justify-center rounded-xl border border-[#C0D6FF] bg-white/70 px-4 text-sm font-semibold text-[#0A1F4D] transition hover:border-[#0039E6] hover:bg-white"
        >
          +91 22 44559090
        </a>
      </div>

      <form
        id="contact-form"
        data-contact-form
        action="https://api.web3forms.com/submit"
        method="post"
        class="mt-8 flex flex-col gap-4 sm:mt-10 sm:gap-5"
        data-success-message={copy.successMessage}
        data-error-message={copy.errorMessage}
        data-sending-message={copy.sendingMessage}
      >
        <input type="hidden" name="access_key" value={web3FormsAccessKey} />
        <input
          type="hidden"
          name="subject"
          value="New website enquiry from Mehta Petro"
        />
        <input type="hidden" name="from_name" value="Mehta Petro Website" />
        <input type="hidden" name="source" value={contactSource} />
        <input
          type="checkbox"
          name="botcheck"
          class="hidden"
          style="display: none;"
          tabindex="-1"
          autocomplete="off"
        />

        <div class="grid grid-cols-1 gap-4 sm:grid-cols-2">
          <TextInput
            id="hs-firstname-contacts"
            label={copy.firstName}
            name="firstName"
          />
          <TextInput
            id="hs-lastname-contacts"
            label={copy.lastName}
            name="lastName"
            required={false}
          />
        </div>

        <EmailContactInput id="hs-email-contacts" />

        <PhoneInput
          id="hs-phone-number"
          countryId="hs-phone-country-code"
          label={copy.phoneNumber}
          countryLabel={copy.countryCode}
          defaultCountryCode="IN"
          minDigits={10}
          maxDigits={10}
        />

        <div>
          <label for="hs-inquiry-type" class="sr-only">Inquiry type</label>
          <select
            id="hs-inquiry-type"
            name="inquiryType"
            required
            class={fieldClass}
          >
            <option value="" disabled selected>Inquiry type</option>
            {
              inquiryOptions.map(opt => (
                <option value={opt.value}>{opt.label}</option>
              ))
            }
          </select>
        </div>

        <TextAreaInput
          id="hs-about-contacts"
          label={copy.details}
          name="message"
          rows={4}
          maxlength={500}
          showCharCount={true}
          class="min-h-[6.5rem] resize-y sm:min-h-[8rem]"
        />

        <p
          class="hidden min-h-[1.25rem] text-sm leading-6"
          data-form-status
          aria-live="polite"
        >
        </p>

        <div
          class="sticky bottom-0 border-t border-[#C0D6FF]/70 bg-[#E8F0FF]/95 pt-4 pb-[max(1rem,env(safe-area-inset-bottom))] backdrop-blur-sm sm:static sm:border-t-0 sm:bg-transparent sm:pt-2 sm:pb-0 sm:backdrop-blur-none"
        >
          <AuthBtn title={copy.send} />
        </div>
      </form>
    </div>
  </div>
</section>

<!-- Locations -->
<section class="border-t border-[#C0D6FF]/70 bg-[#E8F0FF]">
  <div
    class="mx-auto max-w-[85rem] px-4 py-10 sm:px-6 sm:py-14 lg:px-8 lg:py-16"
  >
    <div data-reveal class="max-w-3xl">
      <p
        class="text-xs font-semibold tracking-[0.18em] text-[#0039E6] uppercase"
      >
        Visit us
      </p>
      <h2
        class="mt-3 text-2xl font-bold tracking-tight text-[#0A1F4D] sm:text-3xl"
      >
        Our locations
      </h2>
    </div>

    <div
      data-reveal-group
      class="mt-8 grid gap-0 border-y border-[#C0D6FF]/70 sm:mt-10 md:grid-cols-3"
    >
      {
        locations.map(location => (
          <div
            data-reveal
            class="border-[#C0D6FF]/70 px-0 py-6 md:border-r md:px-6 md:py-8 md:first:pl-0 md:last:border-r-0 md:last:pr-0"
          >
            <p class="text-[11px] font-semibold tracking-wider text-[#0039E6] uppercase">
              {location.label}
            </p>
            <h3 class="mt-2 text-base font-bold text-[#0A1F4D] sm:text-lg">
              {location.heading}
            </h3>
            <p class="mt-1 text-sm text-[#4A5F8C]">{location.content}</p>
            <p class="mt-3 text-sm leading-relaxed text-[#4A5F8C]">
              {location.address}
            </p>
            <a
              href={location.directionsUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="mt-4 inline-flex min-h-11 items-center text-sm font-semibold text-[#0039E6] transition-colors hover:text-[#0033CC]"
            >
              {copy.directionsLabel}
            </a>
          </div>
        ))
      }
    </div>
  </div>
</section>
