---
import AuthBtn from '@components/ui/buttons/AuthBtn.astro';
import TextInput from '@components/ui/forms/input/TextInput.astro';
import EmailContactInput from '@components/ui/forms/input/EmailContactInput.astro';
import PhoneInput from '@components/ui/forms/input/PhoneInput.astro';
import TextAreaInput from '@components/ui/forms/input/TextAreaInput.astro';
import Icon from '@components/ui/icons/Icon.astro';

const locale: string = 'en';
const web3FormsAccessKey = 'e138342b-b691-410c-a7fb-3b3ce5a49ea6';
const siteOrigin = 'https://mehtapetro.vercel.app';
const contactPath = '/contact';
const contactSource = `${siteOrigin}${contactPath}`;

const copy = {
  title: 'Contact us',
  subTitle:
    "Have questions or want to discuss a project? Reach out, and let's craft the perfect solution with our tools and services.",
  formTitle: 'Fill in the form below',
  firstName: 'First Name',
  lastName: 'Last Name',
  details: 'Details',
  phoneNumber: 'Phone Number',
  countryCode: 'Country Code',
  send: 'Send Message',
  successMessage:
    'Thank you for contacting us. Our team shall get in touch with you shortly.',
  errorMessage:
    'Sorry, we could not send your message right now. Please try again.',
  sendingMessage: 'Sending your message…',
  directionsLabel: 'Get directions',
  corporateHeading: 'Corporate Office Address',
  corporateContent: 'Mehta Petro-Refineries Limited',
  corporateAddress:
    '509, HIVE-67, Borasapada Road, Next to Raghuleela Mall, Near Poinsure Gymkhana, Kandivali (West), Mumbai - 400067. Maharashtra',
  factoryOneHeading: 'Factory I',
  factoryOneContent: 'Palghar Manufacturing Facility',
  factoryOneAddress:
    'Plot No. 1, Dewan & Sons Udyog, Village - Mahim, Palghar - 401 404, Maharashtra',
  factoryTwoHeading: 'Factory II',
  factoryTwoContent: 'Dahej Manufacturing Facility',
  factoryTwoAddress:
    'D-2/CH-15, GIDC Dahej II, Dahej, Bharuch - 392 160, Gujarat',
  emailHeading: 'Contact us by email',
  emailContent: 'Prefer the written word? Drop us an email at',
};

const locations = [
  {
    heading: copy.corporateHeading,
    label: 'Corporate office',
    content: copy.corporateContent,
    address: copy.corporateAddress,
    directionsUrl: 'https://maps.app.goo.gl/hgSz19X7oDFZaYdZ6',
  },
  {
    heading: copy.factoryOneHeading,
    label: 'Manufacturing site',
    content: copy.factoryOneContent,
    address: copy.factoryOneAddress,
    directionsUrl: 'https://maps.app.goo.gl/caGEQ7bkokJNAsXB9',
  },
  {
    heading: copy.factoryTwoHeading,
    label: 'Manufacturing site',
    content: copy.factoryTwoContent,
    address: copy.factoryTwoAddress,
    directionsUrl: 'https://maps.app.goo.gl/uBWSCEKzM2LzDmdZ8',
  },
];

const inquiryOptions = [
  { value: 'product', label: 'Product' },
  { value: 'career', label: 'Career' },
  { value: 'general', label: 'General' },
  { value: 'sales', label: 'Sales' },
  { value: 'support', label: 'Support' },
  { value: 'other', label: 'Other' },
];
---

<section class="mx-auto max-w-[85rem] px-4 py-10 sm:px-6 lg:px-8 lg:py-14">
  <div class="mx-auto max-w-5xl">

    {/* ── Page header ── */}
    <div class="text-center">
      <span class="inline-flex rounded-full border border-[#C0D6FF] bg-white px-4 py-1 text-xs font-semibold tracking-wider text-[#0039E6] uppercase">Get in touch</span>
      <h1 class="mt-5 text-4xl font-extrabold tracking-tight text-balance text-[#0A1F4D] md:text-5xl">
        {copy.title}
      </h1>
      <p class="mx-auto mt-4 max-w-2xl text-base sm:text-lg leading-relaxed text-[#4A5F8C]">
        {copy.subTitle}
      </p>
    </div>

    {/* ── Two-column grid ── */}
    <div class="mt-12 grid gap-8 lg:grid-cols-2 lg:items-stretch">

      {/* ── Form card ── */}
      <div class="flex flex-col rounded-2xl border border-[#D4E4FF] bg-white p-6 shadow-lg sm:p-8 overflow-hidden">
        <div class="mb-6 border-b border-[#E3EBFF] pb-4">
          <p class="text-sm font-semibold tracking-wider text-[#0039E6] uppercase">Send a message</p>
          <h2 class="mt-2 text-2xl font-bold text-[#0A1F4D]">
            {copy.formTitle}
          </h2>
        </div>

        <form
          id="contact-form"
          data-contact-form
          action="https://api.web3forms.com/submit"
          method="post"
          class="mt-7 space-y-4"
          data-success-message={copy.successMessage}
          data-error-message={copy.errorMessage}
          data-sending-message={copy.sendingMessage}
        >
          <input type="hidden" name="access_key" value={web3FormsAccessKey} />
          <input type="hidden" name="subject" value="New website enquiry from Mehta Petro" />
          <input type="hidden" name="from_name" value="Mehta Petro Website" />
          <input type="hidden" name="source" value={contactSource} />
          <input type="checkbox" name="botcheck" class="hidden" style="display: none;" tabindex="-1" autocomplete="off" />

          <div class="grid grid-cols-1 gap-4 sm:grid-cols-2">
            <TextInput id="hs-firstname-contacts" label={copy.firstName} name="firstName" />
            <TextInput id="hs-lastname-contacts" label={copy.lastName} name="lastName" required={false} />
          </div>
          <EmailContactInput id="hs-email-contacts" />
          <PhoneInput
            id="hs-phone-number"
            countryId="hs-phone-country-code"
            label={copy.phoneNumber}
            countryLabel={copy.countryCode}
            defaultCountryCode="IN"
          />

          <div class="mt-4">
            <label for="hs-inquiry-type" class="sr-only">{locale === 'fr' ? 'Type de demande' : 'Inquiry type'}</label>
            <select
              id="hs-inquiry-type"
              name="inquiryType"
              class="block w-full rounded-lg border border-neutral-200 bg-neutral-50 px-4 py-3 text-sm text-neutral-700 placeholder:text-neutral-500 focus:border-neutral-200 focus:ring-3 focus:ring-neutral-400 focus:outline-hidden disabled:pointer-events-none disabled:opacity-50"
            >
              <option value="" disabled selected>Inquiry type</option>
              {inquiryOptions.map(opt => (
                <option value={opt.value}>{opt.label}</option>
              ))}
            </select>
          </div>

          <TextAreaInput id="hs-about-contacts" label={copy.details} name="message" />

          <div class="pt-3">
            <AuthBtn title={copy.send} />
          </div>

          <p
            class="hidden min-h-[1.5rem] text-sm leading-6"
            data-form-status
            aria-live="polite"
          ></p>
        </form>
      </div>

      {/* ── Info card ── */}
      <div class="flex flex-col space-y-6">
        
        {/* Quick Contact */}
        <div class="rounded-2xl border border-[#D4E4FF] bg-white p-6 shadow-lg overflow-hidden">
          <h2 class="text-lg font-bold text-[#0A1F4D]">
            {locale === 'fr' ? 'Contact rapide' : 'Quick Contact'}
          </h2>
          
          <div class="mt-4 space-y-4">
            <a href="mailto:info@mehtapetro.com" class="group flex items-center gap-3 rounded-xl border border-[#D4E4FF] bg-[#F5F9FF] p-4 transition-all hover:border-[#0039E6] hover:bg-white hover:shadow-md overflow-hidden">
              <div class="flex h-10 w-10 shrink-0 items-center justify-center rounded-lg bg-[#0039E6] text-white">
                <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
                </svg>
              </div>
              <div>
                <p class="text-xs font-medium text-[#4A5F8C]">Email</p>
                <p class="text-sm font-semibold text-[#0A1F4D]">info@mehtapetro.com</p>
              </div>
            </a>
            
            <a href="tel:+910224455909" class="group flex items-center gap-3 rounded-xl border border-[#D4E4FF] bg-[#F5F9FF] p-4 transition-all hover:border-[#0039E6] hover:bg-white hover:shadow-md overflow-hidden">
              <div class="flex h-10 w-10 shrink-0 items-center justify-center rounded-lg bg-[#0039E6] text-white">
                <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
                </svg>
              </div>
              <div>
                <p class="text-xs font-medium text-[#4A5F8C]">Phone</p>
                <p class="text-sm font-semibold text-[#0A1F4D]">+91-022-44559090</p>
              </div>
            </a>
          </div>
        </div>

        {/* Locations */}
        <div class="rounded-2xl border border-[#D4E4FF] bg-white p-6 shadow-lg overflow-hidden">
          <h2 class="text-lg font-bold text-[#0A1F4D]">
            {locale === 'fr' ? 'Nos emplacements' : 'Our Locations'}
          </h2>
          
          <div class="mt-4 space-y-3">
          {
            locations.map((location, i) => (
              <div class="overflow-hidden rounded-xl border border-[#D4E4FF] bg-[#F5F9FF] p-0">
                <button
                  type="button"
                  class="w-full flex items-start gap-3 p-4 text-left transition-all hover:bg-white focus:outline-none overflow-hidden"
                  aria-expanded="false"
                  aria-controls={`loc-panel-${i}`}
                  data-accordion-button
                >
                  <div class="mt-0.5 flex h-8 w-8 shrink-0 items-center justify-center rounded-lg bg-[#0039E6] text-white">
                    <svg class="h-4 w-4" viewBox="0 0 24 24" fill="currentColor">
                      <path d="M12 2C8.13 2 5 5.13 5 9c0 5.25 7 13 7 13s7-7.75 7-13c0-3.87-3.13-7-7-7zm0 9.5c-1.38 0-2.5-1.12-2.5-2.5S10.62 6.5 12 6.5s2.5 1.12 2.5 2.5S13.38 11.5 12 11.5z" />
                    </svg>
                  </div>
                  <div class="flex-1 min-w-0">
                    <div class="flex items-center justify-between">
                      <p class="text-xs font-semibold text-[#0039E6] uppercase">
                        {location.label}
                      </p>
                      <svg data-chevron class="h-4 w-4 shrink-0 text-[#4A5F8C] transition-transform" viewBox="0 0 20 20" fill="none">
                        <path d="M6 8l4 4 4-4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
                      </svg>
                    </div>
                    <h3 class="mt-1 text-sm font-bold text-[#0A1F4D]">
                      {location.heading}
                    </h3>
                    <p class="mt-0.5 text-xs text-[#4A5F8C]">
                      {location.content}
                    </p>
                  </div>
                </button>

                <div id={`loc-panel-${i}`} class="max-h-0 overflow-hidden px-4" data-accordion-panel hidden style="opacity:0;padding-top:0;padding-bottom:0;transition:max-height 350ms cubic-bezier(.2,.8,.2,1),opacity 250ms ease,padding 250ms ease;">
                  <div class="border-t border-[#E3EBFF] pt-3 pb-4">
                    <p class="text-xs leading-relaxed text-[#4A5F8C]">
                      {location.address}
                    </p>
                    <a
                      href={location.directionsUrl}
                      target="_blank"
                      rel="noopener noreferrer"
                      class="mt-3 inline-flex items-center gap-1 text-xs font-semibold text-[#0039E6] transition hover:text-[#0033CC]"
                    >
                      <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 20l-5.447-2.724A1 1 0 013 16.382V5.618a1 1 0 011.447-.894L9 7m0 13l6-3m-6 3V7m6 10l4.553 2.276A1 1 0 0021 18.382V7.618a1 1 0 00-.553-.894L15 4m0 13V4m0 0L9 7" />
                      </svg>
                      {copy.directionsLabel}
                    </a>
                  </div>
                </div>
              </div>
            ))
          }
          </div>
        </div>
        
      </div>

    </div>

    <script>
          (function () {
            const buttons = Array.from(document.querySelectorAll('[data-accordion-button]')) as HTMLButtonElement[];
            if (!buttons.length) return;

            function closePanel(panel: HTMLElement, chevron: HTMLElement | null) {
              // prepare for collapse animation
              panel.style.maxHeight = panel.scrollHeight + 'px';
              requestAnimationFrame(() => {
                panel.style.maxHeight = '0px';
                (panel.style as any).opacity = '0';
                panel.style.paddingTop = '0px';
                panel.style.paddingBottom = '0px';
              });

              // hide after transition completes
              panel.addEventListener('transitionend', function handler(e) {
                // ensure the event is for max-height (some browsers report other properties)
                if ((e as TransitionEvent).propertyName === 'max-height' || (e as TransitionEvent).propertyName === 'opacity') {
                  panel.hidden = true;
                  panel.removeEventListener('transitionend', handler);
                }
              }, { once: true });

              if (chevron) (chevron.style as any).transform = 'rotate(0deg)';
              panel.setAttribute('data-open', 'false');
            }

            function openPanel(panel: HTMLElement, chevron: HTMLElement | null) {
              panel.hidden = false;
              // reset to collapsed state then expand
              panel.style.maxHeight = '0px';
              (panel.style as any).opacity = '0';
              panel.style.paddingTop = '0px';
              panel.style.paddingBottom = '0px';

              requestAnimationFrame(() => {
                panel.style.maxHeight = panel.scrollHeight + 'px';
                (panel.style as any).opacity = '1';
                panel.style.paddingTop = '0.75rem';
                panel.style.paddingBottom = '1.25rem';
              });

              if (chevron) (chevron.style as any).transform = 'rotate(180deg)';
              panel.setAttribute('data-open', 'true');
            }

            buttons.forEach((btn) => {
              const panelId = btn.getAttribute('aria-controls')!;
              const panel = document.getElementById(panelId) as HTMLElement | null;
              const chevron = btn.querySelector('[data-chevron]') as HTMLElement | null;

              btn.addEventListener('click', (event) => {
                event.preventDefault();
                const isExpanded = btn.getAttribute('aria-expanded') === 'true';

                // Close other panels
                buttons.forEach((otherBtn) => {
                  if (otherBtn === btn) return;
                  otherBtn.setAttribute('aria-expanded', 'false');
                  const otherPanelId = otherBtn.getAttribute('aria-controls')!;
                  const otherPanel = document.getElementById(otherPanelId) as HTMLElement | null;
                  const otherChevron = otherBtn.querySelector('[data-chevron]') as HTMLElement | null;
                  if (otherPanel && otherPanel.getAttribute('data-open') === 'true') {
                    closePanel(otherPanel, otherChevron);
                  }
                });

                if (panel) {
                  if (isExpanded) {
                    btn.setAttribute('aria-expanded', 'false');
                    closePanel(panel, chevron);
                  } else {
                    btn.setAttribute('aria-expanded', 'true');
                    openPanel(panel, chevron);
                  }
                }
              });

              // keyboard
              btn.addEventListener('keydown', (e: KeyboardEvent) => {
                if (e.key === 'Enter' || e.key === ' ') {
                  e.preventDefault();
                  btn.click();
                }
              });

              // initialize closed
              if (panel) {
                panel.hidden = true;
                panel.style.maxHeight = '0px';
                (panel.style as any).opacity = '0';
                panel.style.paddingTop = '0px';
                panel.style.paddingBottom = '0px';
                panel.setAttribute('data-open', 'false');
                // set same transition as inline style to be safe
                panel.style.transition = 'max-height 350ms cubic-bezier(.2,.8,.2,1), opacity 250ms ease, padding 250ms ease';
              }
            });
          })();
      </script>

  </div>
</section>
