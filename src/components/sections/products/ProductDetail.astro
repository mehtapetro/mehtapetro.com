---
import ProductTabBtn from '@components/ui/buttons/ProductTabBtn.astro';
import { Image } from 'astro:assets';
import type { ProductCatalogItem } from '@data/productCatalog';
import PhoneInput from '@components/ui/forms/input/PhoneInput.astro';

interface Props {
  categoryTitle: string;
  categorySlug: string;
  product: ProductCatalogItem;
  lang?: 'en' | 'fr';
}

const { categoryTitle, categorySlug, product, lang = 'en' } = Astro.props;

const copy =
  lang === 'fr'
    ? {
        back: 'Retour à la catégorie',
        overview: 'Description',
        specifications: 'Spécifications',
        blueprints: 'Plans',
        openInquiry: product.ctaTitle || 'Envoyer une demande',
        inquiryTitle: 'Envoyer une demande',
        inquirySubTitle: `Recevez une réponse rapide de notre équipe au sujet de ${product.title}.`,
        firstName: 'Prénom',
        lastName: 'Nom',
        email: 'E-mail',
        phone: 'Téléphone',
        countryCode: 'Indicatif pays',
        inquiryType: 'Type de demande',
        selectInquiryType: 'Type de demande',
        message: 'Message',
        send: 'Envoyer le message',
        close: 'Fermer',
        successMessage:
          'Merci de nous avoir contactés. Notre équipe vous répondra très prochainement.',
        errorMessage:
          "Désolé, nous n'avons pas pu envoyer votre message pour le moment. Veuillez réessayer.",
        sendingMessage: 'Envoi en cours…',
      }
    : {
        back: 'Back to category',
        overview: 'Description',
        specifications: 'Specifications',
        blueprints: 'Blueprints',
        openInquiry: product.ctaTitle || 'Send inquiry',
        inquiryTitle: 'Send inquiry',
        inquirySubTitle: `Get a quick response from our team about ${product.title}.`,
        firstName: 'First Name',
        lastName: 'Last Name',
        email: 'Email',
        phone: 'Phone Number',
        countryCode: 'Country Code',
        inquiryType: 'Inquiry type',
        selectInquiryType: 'Inquiry type',
        message: 'Message',
        send: 'Send Message',
        close: 'Close',
        successMessage:
          'Thank you for contacting us. Our team shall get in touch with you shortly.',
        errorMessage:
          'Sorry, we could not send your message right now. Please try again.',
        sendingMessage: 'Sending your message…',
      };

const categoryHref =
  lang === 'fr' ? `/fr/products/${categorySlug}/` : `/products/${categorySlug}/`;
const web3FormsAccessKey = '0e6f5e46-f620-429a-ab06-a8e61f81c419';
const formSource = Astro.url.pathname;
const inquiryOptions = lang === 'fr'
  ? [
      { value: 'product', label: 'Produit' },
      { value: 'career', label: 'Carrière' },
      { value: 'general', label: 'Général' },
      { value: 'sales', label: 'Ventes' },
      { value: 'support', label: 'Support' },
      { value: 'other', label: 'Autre' },
    ]
  : [
      { value: 'product', label: 'Product' },
      { value: 'career', label: 'Career' },
      { value: 'general', label: 'General' },
      { value: 'sales', label: 'Sales' },
      { value: 'support', label: 'Support' },
      { value: 'other', label: 'Other' },
    ];
---

<div
  id="overlay"
  class="pointer-events-none fixed inset-0 bg-neutral-200 dark:bg-neutral-800"
>
</div>

<section
  class="mx-auto flex max-w-[85rem] flex-col px-4 py-10 sm:px-6 lg:px-8 lg:py-14 2xl:max-w-full"
>
  <div>
    <a
      href={categoryHref}
      class="inline-flex rounded-lg text-sm font-semibold text-[#0039E6] transition duration-300 hover:text-[#0033CC]"
    >
      {copy.back}
    </a>
    <p
      id="fadeText"
      class="mt-5 mb-8 max-w-prose font-light text-pretty text-neutral-700 sm:text-xl dark:text-neutral-300"
    >
      {product.mainContent}
    </p>
  </div>
  <div
    class="flex flex-col items-center justify-between space-y-4 sm:flex-row sm:space-y-0"
  >
    <div id="fadeInUp">
      <p class="mb-3 text-sm font-semibold tracking-[0.14em] text-[#0039E6] uppercase">
        {categoryTitle}
      </p>
      <h1
        class="block text-4xl font-bold tracking-tighter text-neutral-800 sm:text-5xl md:text-6xl lg:text-7xl dark:text-neutral-200"
      >
        {product.title}
      </h1>
      <p class="text-lg text-neutral-600 dark:text-neutral-400">
        {product.description}
      </p>
    </div>
    <div class="overflow-hidden">
      <Image
        id="fadeInMoveRight"
        src={product.imgMain}
        class="w-[600px] will-change-transform"
        alt={product.imgAlt}
        format={'avif'}
        loading={'eager'}
      />
    </div>
  </div>
</section>

<div
  id="product-detail-body"
  class="mx-auto max-w-[85rem] px-4 pt-10 sm:px-6 lg:px-8 lg:pt-14"
>
  <nav
    class="mx-auto grid max-w-6xl gap-y-px sm:flex sm:gap-x-4 sm:gap-y-0"
    aria-label="Tabs"
    role="tablist"
  >
    <ProductTabBtn title={copy.overview} id="tabs-with-card-item-1" dataTab="#tabs-with-card-1" first={true} />
    <ProductTabBtn title={copy.specifications} id="tabs-with-card-item-2" dataTab="#tabs-with-card-2" />
    <ProductTabBtn title={copy.blueprints} id="tabs-with-card-item-3" dataTab="#tabs-with-card-3" />
  </nav>

  <div class="relative mt-12 md:mt-16">
    <div id="tabs-with-card-1" class="product-tab-panel" role="tabpanel">
      <div class="mx-auto max-w-[85rem] px-4 pb-10 sm:px-6 lg:px-8 lg:pb-14">
        <div class="grid gap-12 md:grid-cols-2">
          <div class="lg:w-3/4">
            <h2
              class="text-3xl font-bold tracking-tight text-balance text-neutral-800 md:leading-tight lg:text-4xl dark:text-neutral-200"
            >
              {product.longDescriptionTitle}
            </h2>
            <p class="mt-3 text-pretty text-neutral-600 dark:text-neutral-400">
              {product.longDescriptionSubTitle}
            </p>
            <p class="mt-5">
              <button
                type="button"
                data-product-inquiry-open
                class="group inline-flex items-center justify-center gap-x-2 rounded-xl border border-transparent bg-[#0039E6] px-5 py-3 text-sm font-bold text-neutral-50 shadow-[0_20px_45px_-25px_rgba(0,57,230,0.95)] ring-[#8FA7FF] transition duration-300 outline-hidden hover:bg-[#0033CC] focus-visible:ring-3 active:bg-[#0028A3] disabled:pointer-events-none disabled:opacity-50 2xl:text-base"
              >
                {copy.openInquiry}
              </button>
            </p>
          </div>

          <div class="space-y-6 lg:space-y-10">
            {
              product.descriptionList.map(list => (
                <div class="flex">
                  <div>
                    <h3 class="text-base font-bold text-neutral-800 sm:text-lg dark:text-neutral-200">
                      {list.title}
                    </h3>
                    <p class="mt-1 text-neutral-600 dark:text-neutral-400">
                      {list.subTitle}
                    </p>
                  </div>
                </div>
              ))
            }
          </div>
        </div>
      </div>
    </div>

    <div id="tabs-with-card-2" class="product-tab-panel hidden" role="tabpanel">
      <div class="mx-auto max-w-[85rem] px-4 pb-10 sm:px-6 lg:px-8 lg:pb-14">
        <div class="grid w-full grid-cols-1 gap-x-16 md:grid-cols-2">
          <div class="max-w-md space-y-6">
            {
              product.specificationsLeft.map(spec => (
                <div>
                  <h3 class="block font-bold text-neutral-800 dark:text-neutral-200">
                    {spec.title}
                  </h3>
                  <p class="text-neutral-600 dark:text-neutral-400">
                    {spec.subTitle}
                  </p>
                </div>
              ))
            }
          </div>
          {
            product.specificationsRight ? (
              <div class="mt-6 max-w-md space-y-6 md:mt-0 md:ml-auto">
                {product.specificationsRight.map(spec => (
                  <div>
                    <h3 class="block font-bold text-neutral-800 dark:text-neutral-200">
                      {spec.title}
                    </h3>
                    <p class="text-neutral-600 dark:text-neutral-400">
                      {spec.subTitle}
                    </p>
                  </div>
                ))}
              </div>
            ) : product.tableData ? (
              <div class="mt-6 space-y-6 md:mt-0 md:ml-auto">
                <div class="flex flex-col">
                  <div class="-m-1.5 overflow-x-auto">
                    <div class="inline-block min-w-full p-1.5 align-middle">
                      <div class="overflow-hidden">
                        <table class="min-w-full divide-y divide-neutral-300 dark:divide-neutral-700">
                          <thead>
                            <tr>
                              {product.tableData[0]?.feature.map(header => (
                                <th
                                  scope="col"
                                  class="px-6 py-3 text-start text-xs font-medium text-neutral-500 uppercase dark:text-neutral-500"
                                >
                                  {header}
                                </th>
                              ))}
                            </tr>
                          </thead>
                          <tbody class="divide-y divide-neutral-300 dark:divide-neutral-700">
                            {product.tableData.map(row =>
                              row.description.map(rowData => (
                                <tr>
                                  {rowData.map(cellValue => (
                                    <td class="px-6 py-4 text-sm font-medium whitespace-nowrap text-neutral-600 dark:text-neutral-400">
                                      {cellValue}
                                    </td>
                                  ))}
                                </tr>
                              ))
                            )}
                          </tbody>
                        </table>
                      </div>
                    </div>
                  </div>
                </div>
              </div>
            ) : null
          }
        </div>
      </div>
    </div>

    <div id="tabs-with-card-3" class="product-tab-panel hidden" role="tabpanel">
      <div class="mx-auto mb-20 flex w-full md:mb-28 2xl:w-4/5">
        <div
          class="relative top-12 left-12 z-10 overflow-hidden rounded-xl shadow-lg md:top-16 md:left-12 md:-ml-12 lg:ml-0"
        >
          {
            product.blueprints.first && (
              <Image
                src={product.blueprints.first}
                class="h-full w-full object-cover object-center"
                alt="Blueprint Illustration"
                format={'avif'}
              />
            )
          }
        </div>

        <div class="relative right-12 overflow-hidden rounded-xl shadow-xl">
          {
            product.blueprints.second && (
              <Image
                src={product.blueprints.second}
                class="h-full w-full object-cover object-center"
                alt="Blueprint Illustration"
                format={'avif'}
              />
            )
          }
        </div>
      </div>
    </div>
  </div>
</div>

<div
  id="product-inquiry-modal"
  class="fixed inset-0 z-120 hidden items-center justify-center p-4"
  aria-hidden="true"
>
  <button
    type="button"
    data-product-inquiry-close
    class="absolute inset-0 bg-[#0A1F4D]/55 backdrop-blur-[1px]"
    aria-label={copy.close}
  ></button>
  <div class="relative z-10 w-full max-w-2xl rounded-2xl border border-[#D4E4FF] bg-white p-6 shadow-[0_30px_80px_-40px_rgba(10,31,77,0.45)] sm:p-8">
    <div class="flex items-start justify-between gap-4">
      <div>
        <h2 class="text-2xl font-bold text-[#0A1F4D]">{copy.inquiryTitle}</h2>
        <p class="mt-2 text-sm leading-6 text-[#4A5F8C]">{copy.inquirySubTitle}</p>
      </div>
      <button
        type="button"
        data-product-inquiry-close
        class="inline-flex h-10 w-10 items-center justify-center rounded-full border border-[#D4E4FF] text-[#4A5F8C] transition duration-300 hover:border-[#B8CEFF] hover:text-[#0039E6]"
        aria-label={copy.close}
      >
        ✕
      </button>
    </div>

    <form
      class="mt-6 space-y-4"
      data-contact-form
      action="https://api.web3forms.com/submit"
      method="post"
      data-success-message={copy.successMessage}
      data-error-message={copy.errorMessage}
      data-sending-message={copy.sendingMessage}
    >
      <input type="hidden" name="access_key" value={web3FormsAccessKey} />
      <input type="hidden" name="subject" value="New product enquiry from Mehta Petro website" />
      <input type="hidden" name="from_name" value="Mehta Petro Product Inquiry" />
      <input type="hidden" name="source" value={formSource} />
      <input type="hidden" name="product_name" value={product.title} />
      <input type="checkbox" name="botcheck" class="hidden" style="display: none;" tabindex="-1" autocomplete="off" />

      <div class="grid grid-cols-1 gap-4 sm:grid-cols-2">
        <div>
          <label for="product-inquiry-first-name" class="sr-only">{copy.firstName}</label>
          <input
            id="product-inquiry-first-name"
            name="firstName"
            type="text"
            required
            class="block w-full rounded-lg border border-neutral-200 bg-neutral-50 px-4 py-3 text-sm text-neutral-700 placeholder:text-neutral-500 focus:border-neutral-200 focus:ring-3 focus:ring-neutral-400 focus:outline-hidden"
            placeholder={copy.firstName}
          />
        </div>
        <div>
          <label for="product-inquiry-last-name" class="sr-only">{copy.lastName}</label>
          <input
            id="product-inquiry-last-name"
            name="lastName"
            type="text"
            class="block w-full rounded-lg border border-neutral-200 bg-neutral-50 px-4 py-3 text-sm text-neutral-700 placeholder:text-neutral-500 focus:border-neutral-200 focus:ring-3 focus:ring-neutral-400 focus:outline-hidden"
            placeholder={copy.lastName}
          />
        </div>
      </div>

      <div class="grid grid-cols-1 gap-4">
        <div>
          <label for="product-inquiry-email" class="sr-only">{copy.email}</label>
          <input
            id="product-inquiry-email"
            name="email"
            type="email"
            required
            class="block w-full rounded-lg border border-neutral-200 bg-neutral-50 px-4 py-3 text-sm text-neutral-700 placeholder:text-neutral-500 focus:border-neutral-200 focus:ring-3 focus:ring-neutral-400 focus:outline-hidden"
            placeholder={copy.email}
          />
        </div>
      </div>
      <PhoneInput
        id="product-inquiry-phone"
        countryId="product-inquiry-country-code"
        label={copy.phone}
        countryLabel={copy.countryCode}
        defaultCountryCode="IN"
      />

      <div>
        <label for="product-inquiry-type" class="sr-only">{copy.inquiryType}</label>
        <select
          id="product-inquiry-type"
          name="inquiryType"
          required
          class="block w-full rounded-lg border border-neutral-200 bg-neutral-50 px-4 py-3 text-sm text-neutral-700 focus:border-neutral-200 focus:ring-3 focus:ring-neutral-400 focus:outline-hidden"
        >
          <option value="" disabled selected>{copy.selectInquiryType}</option>
          {inquiryOptions.map(option => (
            <option value={option.value}>{option.label}</option>
          ))}
        </select>
      </div>

      <div>
        <label for="product-inquiry-message" class="sr-only">{copy.message}</label>
        <textarea
          id="product-inquiry-message"
          name="message"
          rows="4"
          required
          class="block w-full rounded-lg border border-neutral-200 bg-neutral-50 px-4 py-3 text-sm text-neutral-700 placeholder:text-neutral-500 focus:border-neutral-200 focus:ring-3 focus:ring-neutral-400 focus:outline-hidden"
          placeholder={copy.message}
        ></textarea>
      </div>

      <div class="pt-1">
        <button
          type="submit"
          class="inline-flex items-center justify-center rounded-xl bg-[#0039E6] px-5 py-3 text-sm font-bold text-white shadow-[0_20px_45px_-25px_rgba(0,57,230,0.95)] transition duration-300 hover:bg-[#0033CC] active:bg-[#0028A3]"
        >
          {copy.send}
        </button>
      </div>

      <p class="hidden min-h-[1.5rem] text-sm leading-6" data-form-status aria-live="polite"></p>
    </form>
  </div>
</div>

<script>
  import { gsap } from 'gsap';

  const prefersReducedMotion = window.matchMedia(
    '(prefers-reduced-motion: reduce)'
  ).matches;

  if (prefersReducedMotion) {
    gsap.set(
      ['#fadeText', '#fadeInUp', '#fadeInMoveRight', '#product-detail-body'],
      { clearProps: 'all' }
    );
    gsap.set('#overlay', { autoAlpha: 0, display: 'none' });
  } else {
    gsap.set('#fadeText', { autoAlpha: 0, y: 20 });
    gsap.set('#fadeInUp', { autoAlpha: 0, y: 28 });
    gsap.set('#fadeInMoveRight', { autoAlpha: 0, x: 56, scale: 0.97 });
    gsap.set('#product-detail-body', { autoAlpha: 0, y: 24 });

    const revealContent = () => {
      gsap.set(
        ['#fadeText', '#fadeInUp', '#fadeInMoveRight', '#product-detail-body'],
        { autoAlpha: 1, x: 0, y: 0, scale: 1 }
      );
      gsap.set('#overlay', { autoAlpha: 0, display: 'none' });
    };

    const safetyId = window.setTimeout(revealContent, 2200);

    gsap
      .timeline({
        defaults: { ease: 'power3.out' },
        onComplete: () => {
          window.clearTimeout(safetyId);
          gsap.set('#overlay', { display: 'none' });
        },
      })
      .to(
        '#overlay',
        {
          autoAlpha: 0,
          duration: 0.65,
          ease: 'power2.inOut',
        },
        0.08
      )
      .to(
        '#fadeText',
        {
          autoAlpha: 1,
          y: 0,
          duration: 0.85,
        },
        0.12
      )
      .to(
        '#fadeInUp',
        {
          autoAlpha: 1,
          y: 0,
          duration: 0.95,
        },
        0.22
      )
      .to(
        '#fadeInMoveRight',
        {
          autoAlpha: 1,
          x: 0,
          scale: 1,
          duration: 1.05,
        },
        0.18
      )
      .to(
        '#product-detail-body',
        {
          autoAlpha: 1,
          y: 0,
          duration: 0.8,
        },
        0.42
      );
  }

  function changeHeadingStyle(
    button: Element,
    addClasses: string[],
    removeClasses: string[]
  ) {
    const heading = button.querySelector('span');
    if (heading) {
      heading.classList.remove(...removeClasses);
      heading.classList.add(...addClasses);
    }
  }

  function setButtonInactive(btn: Element, activeButton: Element) {
    if (btn === activeButton) return;

    btn.classList.remove('active', 'bg-[#E8F0FF]', 'hover:border-transparent');

    changeHeadingStyle(btn, ['text-neutral-800'], ['text-[#0039E6]']);
  }

  function setButtonActive(button: Element) {
    button.classList.add('active', 'bg-[#E8F0FF]', 'hover:border-transparent');

    changeHeadingStyle(button, ['text-[#0039E6]'], ['text-neutral-800']);
  }

  let activePanel = document.querySelector(
    '.product-tab-panel:not(.hidden)'
  ) as HTMLElement | null;
  let isSwitching = false;

  function clearPanelMotion(panel: HTMLElement) {
    panel.style.transition = '';
    panel.style.opacity = '';
    panel.style.transform = '';
  }

  function switchPanel(nextPanel: HTMLElement) {
    if (!nextPanel || nextPanel === activePanel || isSwitching) return;

    if (prefersReducedMotion || !activePanel) {
      activePanel?.classList.add('hidden');
      nextPanel.classList.remove('hidden');
      clearPanelMotion(nextPanel);
      activePanel = nextPanel;
      return;
    }

    isSwitching = true;
    const previousPanel = activePanel;

    previousPanel.style.transition =
      'opacity 220ms cubic-bezier(0.4, 0, 1, 1), transform 220ms cubic-bezier(0.4, 0, 1, 1)';
    previousPanel.style.opacity = '0';
    previousPanel.style.transform = 'translateY(10px)';

    window.setTimeout(() => {
      previousPanel.classList.add('hidden');
      clearPanelMotion(previousPanel);

      nextPanel.classList.remove('hidden');
      nextPanel.style.opacity = '0';
      nextPanel.style.transform = 'translateY(16px)';
      void nextPanel.offsetWidth;

      nextPanel.style.transition =
        'opacity 400ms cubic-bezier(0.22, 1, 0.36, 1), transform 400ms cubic-bezier(0.22, 1, 0.36, 1)';
      nextPanel.style.opacity = '1';
      nextPanel.style.transform = 'translateY(0)';

      window.setTimeout(() => {
        clearPanelMotion(nextPanel);
        activePanel = nextPanel;
        isSwitching = false;
      }, 420);
    }, 230);
  }

  const tabButtons = document.querySelectorAll('[data-target]');

  if (tabButtons.length > 0) {
    changeHeadingStyle(tabButtons[0], ['text-[#1E3AFF]'], []);
  }

  tabButtons.forEach(button => {
    button.addEventListener('click', () => {
      const tabId = button.getAttribute('data-target');
      if (!tabId) return;

      const nextPanel = document.querySelector(tabId) as HTMLElement | null;
      if (!nextPanel || nextPanel === activePanel || isSwitching) return;

      tabButtons.forEach(btn => setButtonInactive(btn, button));
      setButtonActive(button);
      switchPanel(nextPanel);
    });
  });

  const inquiryModal = document.getElementById('product-inquiry-modal');
  const inquiryOpenButtons = document.querySelectorAll('[data-product-inquiry-open]');
  const inquiryCloseButtons = document.querySelectorAll('[data-product-inquiry-close]');

  const closeInquiryModal = () => {
    if (!(inquiryModal instanceof HTMLElement)) return;
    inquiryModal.classList.add('hidden');
    inquiryModal.classList.remove('flex');
    inquiryModal.setAttribute('aria-hidden', 'true');
    document.body.classList.remove('overflow-hidden');
  };

  const openInquiryModal = () => {
    if (!(inquiryModal instanceof HTMLElement)) return;
    inquiryModal.classList.remove('hidden');
    inquiryModal.classList.add('flex');
    inquiryModal.setAttribute('aria-hidden', 'false');
    document.body.classList.add('overflow-hidden');
  };

  inquiryOpenButtons.forEach(button => {
    button.addEventListener('click', openInquiryModal);
  });

  inquiryCloseButtons.forEach(button => {
    button.addEventListener('click', closeInquiryModal);
  });

  document.addEventListener('keydown', event => {
    if (event.key === 'Escape') closeInquiryModal();
  });
</script>
