---
import { Image } from 'astro:assets';
import PrimaryCTA from '@components/ui/buttons/PrimaryCTA.astro';
import SubProductCard from '@components/ui/cards/SubProductCard.astro';
import type { CollectionEntry } from 'astro:content';
import type { ProductCatalogItem } from '@data/productCatalog';

const { category, items, lang = 'en' } = Astro.props;

interface Props {
  category: CollectionEntry<'products'>;
  items: ProductCatalogItem[];
  lang?: 'en' | 'fr';
}

const copy =
  lang === 'fr'
    ? {
        eyebrow: 'Catégorie de produits',
        title: 'Découvrez la gamme',
        subTitle: 'Choisissez un produit ci-dessous pour explorer les détails, les spécifications, et les applications.',
        cta: 'Contacter notre équipe',
      }
    : {
        eyebrow: 'Product category',
        title: 'Explore the range',
        subTitle: 'Choose a product below to explore details, specifications, and application fit.',
        cta: 'Contact our team',
      };
---

<section class="mx-auto max-w-[85rem] px-4 py-10 sm:px-6 lg:px-8 lg:py-14">
  <div class="grid items-center gap-10 lg:grid-cols-[minmax(0,1.05fr)_minmax(0,0.95fr)] lg:gap-14">
    <div>
      <span class="inline-flex rounded-full border border-[#C7D9FF] bg-white px-4 py-1 text-xs font-semibold tracking-[0.18em] text-[#1E3AFF] uppercase">
        {copy.eyebrow}
      </span>
      <h1 class="mt-5 text-4xl font-extrabold tracking-tight text-balance text-[#10245F] md:text-5xl">
        {category.data.description}
      </h1>
      <p class="mt-3 text-lg font-semibold text-[#1E3AFF]">
        {category.data.title}
      </p>
      <p class="mt-5 max-w-2xl text-lg leading-8 text-[#5B6785]">
        {category.data.main.content}
      </p>
      <div class="mt-7 inline-flex">
        <PrimaryCTA title={copy.cta} url={lang === 'fr' ? '/fr/contact' : '/contact'} />
      </div>
    </div>

    <div class="overflow-hidden rounded-[2rem] border border-[#DCE8FF] bg-white p-3 shadow-[0_28px_70px_-48px_rgba(16,36,95,0.35)]">
      <Image
        src={category.data.main.imgMain}
        alt={category.data.main.imgAlt}
        class="h-full w-full rounded-[1.5rem] object-cover"
        format="avif"
      />
    </div>
  </div>
</section>

<section class="mx-auto max-w-[85rem] px-4 pb-10 sm:px-6 lg:px-8 lg:pb-14">
  <div class="rounded-[2rem] border border-[#DCE8FF] bg-white p-6 shadow-[0_24px_60px_-46px_rgba(16,36,95,0.22)] sm:p-8 lg:p-10">
    <div class="max-w-3xl">
      <p class="text-sm font-semibold tracking-[0.18em] text-[#1E3AFF] uppercase">
        {copy.eyebrow}
      </p>
      <h2 class="mt-3 text-3xl font-bold text-[#10245F] md:text-4xl">
        {copy.title}
      </h2>
      <p class="mt-4 text-base leading-8 text-[#5B6785]">
        {copy.subTitle}
      </p>
    </div>

    <div class="mt-10 grid gap-6 lg:grid-cols-3">
      {items.map(item => <SubProductCard item={item} categorySlug={category.id.replace(/^(en|fr)\//, '')} locale={lang} />)}
    </div>
  </div>
</section>
