---
import { Image } from 'astro:assets';
import SubProductCard from '@components/ui/cards/SubProductCard.astro';
import type { CollectionEntry } from 'astro:content';
import type { ProductCatalogItem } from '@data/productCatalog';
import PhoneInput from '@components/ui/forms/input/PhoneInput.astro';
import { WEB3FORMS_ACCESS_KEY } from '@/data/web3forms';

const { category, items, lang = 'en' } = Astro.props;

interface Props {
  category: CollectionEntry<'products'>;
  items: ProductCatalogItem[];
  lang?: 'en' | 'fr';
}

const copy =
  lang === 'fr'
    ? {
        eyebrow: 'Catégorie de produits',
        title: 'Découvrez la gamme',
        subTitle:
          'Choisissez un produit ci-dessous pour explorer les détails, les spécifications, et les applications.',
        cta: 'Contacter notre équipe',
        inquiryTitle: 'Contacter notre équipe',
        inquirySubTitle: `Envoyez-nous votre demande pour ${category.data.description}.`,
        firstName: 'Prénom',
        lastName: 'Nom',
        email: 'E-mail',
        phone: 'Téléphone',
        countryCode: 'Indicatif pays',
        inquiryType: 'Type de demande',
        message: 'Message',
        send: 'Envoyer le message',
        close: 'Fermer',
        successMessage:
          'Merci de nous avoir contactés. Notre équipe vous répondra très prochainement.',
        errorMessage:
          "Désolé, nous n'avons pas pu envoyer votre message pour le moment. Veuillez réessayer.",
        sendingMessage: 'Envoi en cours…',
      }
    : {
        eyebrow: 'Product category',
        title: 'Explore the range',
        subTitle:
          'Choose a product below to explore details, specifications, and application fit.',
        cta: 'Contact our team',
        inquiryTitle: 'Contact our team',
        inquirySubTitle: `Send us your enquiry for ${category.data.description}.`,
        firstName: 'First Name',
        lastName: 'Last Name',
        email: 'Email',
        phone: 'Phone Number',
        countryCode: 'Country Code',
        inquiryType: 'Inquiry type',
        message: 'Message',
        send: 'Send Message',
        close: 'Close',
        successMessage:
          'Thank you for contacting us. Our team shall get in touch with you shortly.',
        errorMessage:
          'Sorry, we could not send your message right now. Please try again.',
        sendingMessage: 'Sending your message…',
      };

const web3FormsAccessKey = WEB3FORMS_ACCESS_KEY;
const inquiryOptions =
  lang === 'fr'
    ? [
        { value: 'product', label: 'Produit' },
        { value: 'career', label: 'Carrière' },
        { value: 'general', label: 'Général' },
        { value: 'sales', label: 'Ventes' },
        { value: 'support', label: 'Support' },
        { value: 'other', label: 'Autre' },
      ]
    : [
        { value: 'product', label: 'Product' },
        { value: 'career', label: 'Career' },
        { value: 'general', label: 'General' },
        { value: 'sales', label: 'Sales' },
        { value: 'support', label: 'Support' },
        { value: 'other', label: 'Other' },
      ];
---

<section class="mx-auto max-w-[85rem] px-4 py-10 sm:px-6 lg:px-8 lg:py-14">
  <div
    class="grid items-center gap-10 lg:grid-cols-[minmax(0,1.05fr)_minmax(0,0.95fr)] lg:gap-14"
  >
    <div>
      <span
        class="inline-flex rounded-full border border-[#C0D6FF] bg-white px-4 py-1 text-xs font-semibold tracking-[0.18em] text-[#0039E6] uppercase"
      >
        {copy.eyebrow}
      </span>
      <h1
        class="mt-5 text-4xl font-extrabold tracking-tight text-balance text-[#0A1F4D] md:text-5xl"
      >
        {category.data.description}
      </h1>
      <p class="mt-3 text-lg font-semibold text-[#0039E6]">
        {category.data.title}
      </p>
      <p class="mt-5 max-w-2xl text-lg leading-8 text-[#4A5F8C]">
        {category.data.main.content}
      </p>
      <div class="mt-7 inline-flex">
        <button
          type="button"
          data-product-inquiry-open
          aria-controls="category-inquiry-modal"
          class="group inline-flex items-center justify-center gap-x-2 rounded-xl border border-transparent bg-[#0039E6] px-5 py-3 text-sm font-bold text-neutral-50 shadow-[0_20px_45px_-25px_rgba(0,57,230,0.95)] ring-[#8FA7FF] outline-hidden transition duration-300 hover:bg-[#0033CC] focus-visible:ring-3 active:bg-[#0028A3] disabled:pointer-events-none disabled:opacity-50 2xl:text-base"
        >
          {copy.cta}
        </button>
      </div>
    </div>

    <div
      class="overflow-hidden rounded-[2rem] border border-[#D4E4FF] bg-white p-3 shadow-[0_28px_70px_-48px_rgba(10,31,77,0.35)]"
    >
      <Image
        src={category.data.main.imgMain}
        alt={category.data.main.imgAlt}
        class="h-full w-full rounded-[1.5rem] object-cover"
        format="avif"
      />
    </div>
  </div>
</section>

<section class="mx-auto max-w-[85rem] px-4 pb-10 sm:px-6 lg:px-8 lg:pb-14">
  <div
    class="rounded-[2rem] border border-[#D4E4FF] bg-white p-6 shadow-[0_24px_60px_-46px_rgba(10,31,77,0.22)] sm:p-8 lg:p-10"
  >
    <div class="max-w-3xl">
      <p
        class="text-sm font-semibold tracking-[0.18em] text-[#0039E6] uppercase"
      >
        {copy.eyebrow}
      </p>
      <h2 class="mt-3 text-3xl font-bold text-[#0A1F4D] md:text-4xl">
        {copy.title}
      </h2>
      <p class="mt-4 text-base leading-8 text-[#4A5F8C]">
        {copy.subTitle}
      </p>
    </div>

    <div class="mt-10 grid gap-6 lg:grid-cols-3">
      {
        items.map(item => (
          <SubProductCard
            item={item}
            categorySlug={category.id.replace(/^(en|fr)\//, '')}
          />
        ))
      }
    </div>
  </div>
</section>

<div
  id="category-inquiry-modal"
  data-product-inquiry-modal
  class="fixed inset-0 z-120 hidden items-center justify-center p-4"
  aria-hidden="true"
>
  <button
    type="button"
    data-product-inquiry-close
    class="absolute inset-0 bg-[#0A1F4D]/55 backdrop-blur-[1px]"
    aria-label={copy.close}></button>
  <div
    class="relative z-10 w-full max-w-2xl rounded-2xl border border-[#D4E4FF] bg-white p-6 shadow-[0_30px_80px_-40px_rgba(10,31,77,0.45)] sm:p-8"
  >
    <div class="flex items-start justify-between gap-4">
      <div>
        <h2 class="text-2xl font-bold text-[#0A1F4D]">{copy.inquiryTitle}</h2>
        <p class="mt-2 text-sm leading-6 text-[#4A5F8C]">
          {copy.inquirySubTitle}
        </p>
      </div>
      <button
        type="button"
        data-product-inquiry-close
        class="inline-flex h-10 w-10 items-center justify-center rounded-full border border-[#D4E4FF] text-[#4A5F8C] transition duration-300 hover:border-[#B8CEFF] hover:text-[#0039E6]"
        aria-label={copy.close}
      >
        ✕
      </button>
    </div>

    <form
      class="mt-6 space-y-4"
      data-contact-form
      action="https://api.web3forms.com/submit"
      method="post"
      data-success-message={copy.successMessage}
      data-error-message={copy.errorMessage}
      data-sending-message={copy.sendingMessage}
    >
      <input type="hidden" name="access_key" value={web3FormsAccessKey} />
      <input
        type="hidden"
        name="subject"
        value="New product category enquiry from Mehta Petro website"
      />
      <input
        type="hidden"
        name="from_name"
        value="Mehta Petro Product Category Inquiry"
      />
      <input type="hidden" name="source" value={Astro.url.pathname} />
      <input
        type="hidden"
        name="category_name"
        value={category.data.description}
      />
      <input
        type="checkbox"
        name="botcheck"
        class="hidden"
        style="display: none;"
        tabindex="-1"
        autocomplete="off"
      />

      <div class="grid grid-cols-1 gap-4 sm:grid-cols-2">
        <input
          name="firstName"
          type="text"
          required
          class="block w-full rounded-lg border border-neutral-200 bg-neutral-50 px-4 py-3 text-sm text-neutral-700 placeholder:text-neutral-500 focus:border-neutral-200 focus:ring-3 focus:ring-neutral-400 focus:outline-hidden"
          placeholder={copy.firstName}
        />
        <input
          name="lastName"
          type="text"
          class="block w-full rounded-lg border border-neutral-200 bg-neutral-50 px-4 py-3 text-sm text-neutral-700 placeholder:text-neutral-500 focus:border-neutral-200 focus:ring-3 focus:ring-neutral-400 focus:outline-hidden"
          placeholder={copy.lastName}
        />
      </div>

      <div class="grid grid-cols-1 gap-4">
        <input
          name="email"
          type="email"
          required
          class="block w-full rounded-lg border border-neutral-200 bg-neutral-50 px-4 py-3 text-sm text-neutral-700 placeholder:text-neutral-500 focus:border-neutral-200 focus:ring-3 focus:ring-neutral-400 focus:outline-hidden"
          placeholder={copy.email}
        />
      </div>
      <PhoneInput
        id="category-inquiry-phone"
        countryId="category-inquiry-country-code"
        label={copy.phone}
        countryLabel={copy.countryCode}
        defaultCountryCode="IN"
      />

      <select
        name="inquiryType"
        required
        class="block w-full rounded-lg border border-neutral-200 bg-neutral-50 px-4 py-3 text-sm text-neutral-700 focus:border-neutral-200 focus:ring-3 focus:ring-neutral-400 focus:outline-hidden"
      >
        <option value="" disabled selected>{copy.inquiryType}</option>
        {
          inquiryOptions.map(option => (
            <option value={option.value}>{option.label}</option>
          ))
        }
      </select>

      <textarea
        name="message"
        rows="4"
        required
        class="block w-full rounded-lg border border-neutral-200 bg-neutral-50 px-4 py-3 text-sm text-neutral-700 placeholder:text-neutral-500 focus:border-neutral-200 focus:ring-3 focus:ring-neutral-400 focus:outline-hidden"
        placeholder={copy.message}></textarea>

      <button
        type="submit"
        class="inline-flex items-center justify-center rounded-xl bg-[#0039E6] px-5 py-3 text-sm font-bold text-white shadow-[0_20px_45px_-25px_rgba(0,57,230,0.95)] transition duration-300 hover:bg-[#0033CC] active:bg-[#0028A3]"
      >
        {copy.send}
      </button>

      <p
        class="hidden min-h-[1.5rem] text-sm leading-6"
        data-form-status
        aria-live="polite"
      >
      </p>
    </form>
  </div>
</div>
