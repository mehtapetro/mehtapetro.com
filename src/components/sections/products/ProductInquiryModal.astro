---
import PhoneInput from '@components/ui/forms/input/PhoneInput.astro';
import { WEB3FORMS_ACCESS_KEY } from '@/data/web3forms';

const web3FormsAccessKey = WEB3FORMS_ACCESS_KEY;

const {
  modalId,
  title = 'Contact our team',
  subtitle,
  subject,
  fromName,
  source,
  productName,
  categoryName,
  phoneInputId,
} = Astro.props;

interface Props {
  modalId: string;
  title?: string;
  subtitle: string;
  subject: string;
  fromName: string;
  source: string;
  productName?: string;
  categoryName?: string;
  phoneInputId?: string;
}

const resolvedPhoneInputId = phoneInputId || `${modalId}-phone`;
const inquiryOptions = [
  { value: 'product', label: 'Product' },
  { value: 'sales', label: 'Sales' },
  { value: 'support', label: 'Technical support' },
  { value: 'general', label: 'General' },
  { value: 'other', label: 'Other' },
];

const fieldClass =
  'block min-h-11 w-full rounded-xl border border-neutral-200 bg-neutral-50 px-4 py-3 text-base text-neutral-700 placeholder:text-neutral-500 focus:border-[#C0D6FF] focus:ring-3 focus:ring-[#C0D6FF]/60 focus:outline-hidden sm:text-sm';
---

<div
  id={modalId}
  data-product-inquiry-modal
  class="fixed inset-0 z-120 hidden items-end justify-center p-0 sm:items-center sm:p-4"
  role="dialog"
  aria-modal="true"
  aria-labelledby={`${modalId}-title`}
  aria-hidden="true"
>
  <button
    type="button"
    data-product-inquiry-close
    class="absolute inset-0 bg-[#0A1F4D]/55 backdrop-blur-[1px]"
    aria-label="Close inquiry form"></button>
  <div
    class="relative z-10 flex max-h-[92dvh] w-full max-w-2xl flex-col overflow-hidden rounded-t-2xl border border-[#D4E4FF] bg-white shadow-[0_30px_80px_-40px_rgba(10,31,77,0.45)] sm:max-h-[90vh] sm:rounded-2xl"
  >
    <div
      class="flex shrink-0 items-start justify-between gap-3 border-b border-[#E3EBFF] bg-linear-to-br from-[#F7FAFF] via-white to-white px-4 py-4 sm:gap-4 sm:px-6 sm:py-5 md:px-8"
    >
      <div class="min-w-0">
        <h2
          id={`${modalId}-title`}
          class="text-xl font-bold text-[#0A1F4D] sm:text-2xl"
        >
          {title}
        </h2>
        <p class="mt-1 text-sm leading-6 text-[#4A5F8C] sm:mt-2">{subtitle}</p>
      </div>
      <button
        type="button"
        data-product-inquiry-close
        class="inline-flex h-10 w-10 shrink-0 items-center justify-center rounded-full border border-[#D4E4FF] text-[#4A5F8C] transition duration-300 hover:border-[#B8CEFF] hover:text-[#0039E6]"
        aria-label="Close inquiry form"
      >
        <svg
          class="h-4 w-4"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          aria-hidden="true"
        >
          <path stroke-linecap="round" d="M6 6l12 12M18 6L6 18"></path>
        </svg>
      </button>
    </div>

    <form
      class="flex min-h-0 flex-1 flex-col gap-3 overflow-y-auto overscroll-contain px-4 py-4 pb-[max(1rem,env(safe-area-inset-bottom))] sm:gap-4 sm:px-6 sm:py-5 md:px-8 md:py-6"
      data-contact-form
      action="https://api.web3forms.com/submit"
      method="post"
      data-success-message="Thank you for contacting us. Our team shall get in touch with you shortly."
      data-error-message="Sorry, we could not send your message right now. Please try again."
      data-sending-message="Sending your message…"
    >
      <input type="hidden" name="access_key" value={web3FormsAccessKey} />
      <input type="hidden" name="subject" value={subject} />
      <input type="hidden" name="from_name" value={fromName} />
      <input type="hidden" name="source" value={source} />
      {
        productName && (
          <input type="hidden" name="product_name" value={productName} />
        )
      }
      {
        categoryName && (
          <input type="hidden" name="category_name" value={categoryName} />
        )
      }
      <input
        type="checkbox"
        name="botcheck"
        class="hidden"
        style="display: none;"
        tabindex="-1"
        autocomplete="off"
      />

      <div class="grid grid-cols-1 gap-3 sm:grid-cols-2 sm:gap-4">
        <div>
          <label for={`${modalId}-first-name`} class="sr-only">First name</label>
          <input
            id={`${modalId}-first-name`}
            name="firstName"
            type="text"
            required
            autocomplete="given-name"
            class={fieldClass}
            placeholder="First name"
          />
        </div>
        <div>
          <label for={`${modalId}-last-name`} class="sr-only">Last name</label>
          <input
            id={`${modalId}-last-name`}
            name="lastName"
            type="text"
            autocomplete="family-name"
            class={fieldClass}
            placeholder="Last name"
          />
        </div>
      </div>

      <div>
        <label for={`${modalId}-email`} class="sr-only">Email</label>
        <input
          id={`${modalId}-email`}
          name="email"
          type="email"
          required
          autocomplete="email"
          class={fieldClass}
          placeholder="Email address"
        />
      </div>

      <PhoneInput
        id={resolvedPhoneInputId}
        countryId={`${resolvedPhoneInputId}-country-code`}
        label="Phone number"
        countryLabel="Country code"
        defaultCountryCode="IN"
        required={true}
        minDigits={10}
        maxDigits={10}
      />

      <div>
        <label for={`${modalId}-inquiry-type`} class="sr-only"
          >Inquiry type</label
        >
        <select
          id={`${modalId}-inquiry-type`}
          name="inquiryType"
          required
          class={fieldClass}
        >
          <option value="" disabled selected>Inquiry type</option>
          {
            inquiryOptions.map(option => (
              <option value={option.value}>{option.label}</option>
            ))
          }
        </select>
      </div>

      <div>
        <label for={`${modalId}-message`} class="sr-only">Message</label>
        <textarea
          id={`${modalId}-message`}
          name="message"
          rows="4"
          required
          class={`${fieldClass} min-h-[6rem] resize-y`}
          placeholder="Tell us about your requirement"></textarea>
      </div>

      <p
        class="hidden min-h-[1.5rem] text-sm leading-6"
        data-form-status
        aria-live="polite"
      >
      </p>

      <div
        class="mt-1 flex flex-col gap-3 border-t border-[#E3EBFF] pt-4 sm:flex-row sm:items-center sm:justify-end"
      >
        <button
          type="submit"
          class="inline-flex min-h-11 w-full items-center justify-center rounded-xl bg-[#0039E6] px-5 py-3 text-sm font-bold text-white shadow-[0_20px_45px_-25px_rgba(0,57,230,0.95)] transition duration-300 hover:bg-[#0033CC] active:bg-[#0028A3] sm:w-auto"
        >
          Send message
        </button>
      </div>
    </form>
  </div>
</div>
