---
// Import SecondaryCTA component for use in this module
import SecondaryCTA from '@components/ui/buttons/SecondaryCTA.astro';
import Icon from '@components/ui/icons/Icon.astro';

// Define props from Astro
const { pricing } = Astro.props;

// Define TypeScript type for products.
type Product = {
  name: string;
  description: string;
  price: string;
  cents: string;
  billingFrequency: string;
  features: Array<string>;
  purchaseBtnTitle: string;
  purchaseLink: string;
};

interface PricingSectionProps {
  title: string;
  subTitle: string;
  badge: string;
  thirdOption: string;
  btnText: string;
  pricing: {
    title: string;
    subTitle: string;
    starterKit: Product;
    professionalToolbox: Product;
  };
}
---

<section
  class="mx-auto max-w-[85rem] px-4 py-10 sm:px-6 lg:px-8 lg:py-14 2xl:max-w-full"
>
  {/* Section heading and sub-heading */}
  <div class="mx-auto mb-10 max-w-2xl text-center lg:mb-14">
    <h2
      class="text-2xl font-bold tracking-tight text-balance text-neutral-800 md:text-4xl md:leading-tight"
    >
      {pricing.title}
    </h2>
    <p class="mt-1 text-pretty text-neutral-600">
      {pricing.subTitle}
    </p>
  </div>
  {/* Contains two main product blocks */}
  <div class="flex flex-wrap items-center justify-center gap-4 sm:gap-0">
    {/* Starter Kit product details */}
    <div
      class="w-full rounded-2xl border border-[#DCE8FF] bg-white p-6 shadow-[0_24px_60px_-42px_rgba(30,58,255,0.2)] sm:w-1/2 sm:rounded-r-none sm:p-8 lg:w-1/3"
    >
      <div class="mb-4">
        <h3 class="text-2xl font-bold text-[#10245F] sm:text-3xl">
          {pricing.starterKit.name}
        </h3>
        <p class="text-[#5B6785]">{pricing.starterKit.description}</p>
      </div>

      <div class="mb-4">
        <span class="text-4xl font-bold text-[#10245F]"
          >{pricing.starterKit.price}</span
        >
        <span class="text-lg font-bold text-[#3F5288]"
          >{pricing.starterKit.cents}</span
        >
        <span class="ms-3 text-sm text-[#5B6785]"
          >{pricing.starterKit.billingFrequency}</span
        >
      </div>
      {
        /* Features list - automatically created by mapping over `features` array */
      }
      <ul class="mb-6 space-y-2 text-[#5B6785]">
        {
          pricing.starterKit.features.map((feature: string) => (
            <li class="flex items-center gap-1.5">
              <Icon name="checkCircle" />

              <span>{feature}</span>
            </li>
          ))
        }
      </ul>
      {/* CTA for purchasing the product */}
      <a
        href={pricing.starterKit.purchaseLink}
        class="block rounded-xl bg-[#1E3AFF] px-8 py-3 text-center text-sm font-bold text-white ring-[#AFC2FF] outline-hidden transition duration-100 hover:bg-[#1632E0] focus-visible:ring-3 active:bg-[#122AB8] md:text-base"
        >{pricing.starterKit.purchaseBtnTitle}</a
      >
    </div>
    {/* Professional Toolbox product details */}
    <div
      class="w-full rounded-2xl bg-linear-to-br from-[#1E3AFF] to-[#6C87F5] p-6 shadow-[0_32px_70px_-42px_rgba(30,58,255,0.7)] sm:w-1/2 sm:p-8"
    >
      <div
        class="mb-4 flex flex-col items-start justify-between gap-4 lg:flex-row"
      >
        <div>
          <h3 class="text-2xl font-bold text-neutral-100 sm:text-3xl">
            {pricing.professionalToolbox.name}
          </h3>
          <p class="text-[#DCE8FF]">
            {pricing.professionalToolbox.description}
          </p>
        </div>

        <span
          class="order-first inline-block rounded-full bg-white/18 px-3 py-1 text-center text-xs font-bold tracking-wider text-white uppercase lg:order-none"
          >{pricing.badge}</span
        >
      </div>

      <div class="mb-4">
        <span class="text-6xl font-bold text-neutral-100"
          >{pricing.professionalToolbox.price}</span
        >
        <span class="text-lg font-bold text-[#EEF4FF]"
          >{pricing.professionalToolbox.cents}</span
        >
        <span class="ms-3 text-[#DCE8FF]"
          >{pricing.professionalToolbox.billingFrequency}</span
        >
      </div>
      {
        /* Features list - automatically created by mapping over `features` array */
      }
      <ul class="mb-6 space-y-2 text-[#EEF4FF]">
        {
          pricing.professionalToolbox.features.map((feature: string) => (
            <li class="flex items-center gap-1.5">
              <Icon name="checkCircle" />

              <span>{feature}</span>
            </li>
          ))
        }
      </ul>
      {/* CTA for purchasing the product */}
      <a
        href={pricing.professionalToolbox.purchaseLink}
        class="block rounded-xl bg-white px-8 py-3 text-center text-sm font-bold text-[#10245F] ring-[#AFC2FF] outline-hidden transition duration-300 hover:bg-[#F8FAFF] focus-visible:ring-3 active:bg-[#EEF4FF] md:text-base"
        >{pricing.professionalToolbox.purchaseBtnTitle}</a
      >
    </div>
  </div>
  {/* Call to action for Enterprise Solutions */}
  <div class="mt-8 flex items-center justify-center gap-x-3 md:mt-12">
    <p class="text-sm text-neutral-600">
      {pricing.thirdOption}
    </p>

    <SecondaryCTA title={pricing.btnText} url="#" />
  </div>
</section>
