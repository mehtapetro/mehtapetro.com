---
import MainLayout from '@/layouts/MainLayout.astro';
import { getImage } from 'astro:assets';
import { SITE } from '@data/constants';
import ClientsSection from '@components/sections/landing/ClientsSection.astro';
import FAQ from '@components/sections/misc/FAQ.astro';
import introVideo from '@images/intro-hero.mp4?url';
import introPoster from '@images/intro-poster.jpg';
import faqs from '@data/faqs.json';
import isoLogo from '@images/iso/ISO.svg';
import mprlLogo from '@images/mprl_logo.png';
import { clientLogos } from '@/data_files/clientLogos';
import { getAllCategories, getProductsForCategory } from '@/lib/productFs';

const pageTitle =
  'Mehta Petro-Refineries Limited | Performance Through Quality';
const metaDescription = SITE.description;
const ogTitle = pageTitle;

const featuredCategories = getAllCategories()
  .map(category => ({
    ...category,
    productCount: getProductsForCategory(category.slug).length,
  }))
  .sort((a, b) => b.productCount - a.productCount)
  .slice(0, 6);

// Mobile-only optimized poster (desktop uses original introPoster)
const heroPosterMobile = await getImage({
  src: introPoster,
  width: 768,
  height: 1024,
  format: 'webp',
  quality: 65,
  fit: 'cover',
});

const heroLogoMobile = await getImage({
  src: mprlLogo,
  width: 192,
  format: 'webp',
  quality: 80,
});
---

<MainLayout
  title={pageTitle}
  customDescription={metaDescription}
  customOgTitle={ogTitle}
  structuredData={{
    '@context': 'https://schema.org',
    '@graph': [
      {
        '@type': 'Organization',
        '@id': `${SITE.url}/#organization`,
        name: SITE.legalName,
        alternateName: SITE.title,
        url: SITE.url,
        logo: `${SITE.url}/favicon.ico`,
        description: SITE.description,
        foundingDate: '1993',
        slogan: SITE.tagline,
      },
      {
        '@type': 'WebSite',
        '@id': `${SITE.url}/#website`,
        url: SITE.url,
        name: SITE.legalName,
        description: SITE.description,
        publisher: { '@id': `${SITE.url}/#organization` },
        inLanguage: 'en-US',
      },
      {
        '@type': 'WebPage',
        '@id': `${SITE.url}/`,
        url: SITE.url,
        name: pageTitle,
        description: metaDescription,
        isPartOf: { '@id': `${SITE.url}/#website` },
        about: { '@id': `${SITE.url}/#organization` },
        inLanguage: 'en-US',
      },
    ],
  }}
  preloadImages={[{ href: heroPosterMobile.src, media: '(max-width: 767px)' }]}
  fullWidth
  overlayNav
>
  <!-- Hero Section -->
  <section
    class="relative flex min-h-[100svh] flex-col overflow-hidden bg-[#07142F]"
  >
    {/* Mobile: real <img> so LCP is the poster, not the h1 */}
    <img
      class="pointer-events-none absolute inset-0 h-full w-full object-cover md:hidden"
      src={heroPosterMobile.src}
      width={heroPosterMobile.attributes.width}
      height={heroPosterMobile.attributes.height}
      alt=""
      fetchpriority="high"
      decoding="async"
      data-hero-mobile-poster
    />
    {/* Desktop: original poster as CSS background (unchanged) */}
    <div
      class="absolute inset-0 hidden bg-cover bg-center md:block"
      style={`background-image: url(${introPoster.src})`}
      aria-hidden="true"
    >
    </div>
    <video
      class="pointer-events-none absolute inset-0 hidden h-full w-full object-cover opacity-0 md:block"
      muted
      loop
      playsinline
      preload="none"
      disablepictureinpicture
      aria-label="Mehta Petro-Refineries Limited facility"
      data-hero-video
      data-hero-src={introVideo}></video>

    <div
      class="pointer-events-none absolute inset-0 bg-[#061022]/45"
      aria-hidden="true"
    >
    </div>

    <div
      class="relative z-10 mx-auto flex min-h-[100svh] w-full max-w-[85rem] flex-1 flex-col justify-center px-4 pt-[max(5.5rem,env(safe-area-inset-top))] pb-[max(2rem,env(safe-area-inset-bottom))] sm:px-6 sm:pt-28 sm:pb-24 lg:px-8"
    >
      <div class="w-full max-w-6xl -translate-y-3 sm:-translate-y-4">
        <div class="mb-5 sm:mb-8">
          <picture>
            <source
              media="(max-width: 767px)"
              srcset={heroLogoMobile.src}
              type="image/webp"
            />
            <img
              src={mprlLogo.src}
              alt="Mehta Petro-Refineries Limited"
              width={mprlLogo.width}
              height={mprlLogo.height}
              class="h-12 w-auto sm:h-20 md:h-24"
              decoding="async"
              loading="eager"
            />
          </picture>
        </div>

        <h1
          class="w-full max-w-6xl text-[1.85rem] leading-tight font-extrabold tracking-tight text-balance text-white sm:text-5xl sm:leading-tight md:text-6xl lg:text-[4.35rem] lg:leading-none lg:whitespace-nowrap"
        >
          Mehta Petro-Refineries Limited
        </h1>

        <h2
          class="mt-4 text-sm font-semibold tracking-[0.16em] text-[#8EC5FF] uppercase sm:mt-6 sm:text-xl sm:tracking-[0.2em]"
        >
          Performance Through Quality
        </h2>

        <p
          class="mt-2 max-w-2xl text-sm leading-relaxed text-white/86 sm:text-base"
        >
          Manufacturers of Petrochemicals & Specialty Base Oils
        </p>

        <p
          class="mt-1.5 text-xs font-semibold tracking-[0.18em] text-white/90 uppercase sm:mt-2 sm:text-base sm:tracking-[0.2em]"
        >
          Since 1993
        </p>

        <div class="mt-7 flex flex-col gap-3 sm:mt-9 sm:flex-row sm:gap-4">
          <a
            href="/contact"
            class="inline-flex min-h-12 items-center justify-center rounded-xl bg-[#0039E6] px-6 py-3.5 text-base font-semibold text-white shadow-lg transition-colors hover:bg-[#0033CC] sm:min-h-0 sm:px-7 sm:py-4"
          >
            Get in Touch
          </a>
          <a
            href="/products"
            class="inline-flex min-h-12 items-center justify-center rounded-xl border border-white/24 bg-white/12 px-6 py-3.5 text-base font-semibold text-white backdrop-blur-md transition-colors hover:bg-white/18 sm:min-h-0 sm:px-7 sm:py-4"
          >
            View Our Products
          </a>
        </div>

        <div
          class="mt-6 hidden flex-wrap gap-3 text-sm text-white/90 sm:mt-8 sm:flex"
        >
          <span
            class="rounded-full border border-white/18 bg-white/10 px-4 py-2 backdrop-blur-sm"
            >Aromatic & aliphatic solvents</span
          >
          <span
            class="rounded-full border border-white/18 bg-white/10 px-4 py-2 backdrop-blur-sm"
            >Base oils & glycols</span
          >
          <span
            class="rounded-full border border-white/18 bg-white/10 px-4 py-2 backdrop-blur-sm"
            >Drilling fluids & additives</span
          >
        </div>
      </div>
    </div>

    <div
      class="pointer-events-none absolute inset-x-0 bottom-0 h-20 bg-linear-to-t from-[#E8F0FF] to-transparent sm:h-24"
    >
    </div>
  </section>

  <!-- Proof points -->
  <section class="bg-[#E8F0FF]">
    <div
      class="mx-auto max-w-[85rem] px-4 py-10 sm:px-6 sm:py-14 lg:px-8 lg:py-20"
    >
      <div data-reveal class="max-w-3xl">
        <p
          class="text-xs font-semibold tracking-[0.18em] text-[#0039E6] uppercase"
        >
          Proof
        </p>
        <h2
          class="mt-3 text-2xl font-bold tracking-tight text-[#0A1F4D] sm:text-3xl md:text-4xl"
        >
          Built on Experience & Quality
        </h2>
        <p
          class="mt-4 text-sm leading-relaxed text-[#4A5F8C] sm:mt-5 sm:text-base md:text-lg"
        >
          Decades of manufacturing expertise, two modern facilities, and
          certified quality systems supporting reliable industrial supply.
        </p>
      </div>

      <div
        data-reveal-group
        class="mt-8 divide-y divide-[#C0D6FF]/70 border-y border-[#C0D6FF]/70 sm:mt-12 sm:grid sm:grid-cols-3 sm:gap-0 sm:divide-x sm:divide-y-0 sm:divide-[#C0D6FF]/70 sm:py-10"
      >
        <div
          data-reveal
          class="py-6 sm:px-8 sm:py-0 first:sm:pl-0 last:sm:pr-0"
        >
          <p
            class="text-4xl font-extrabold tracking-tight text-[#0039E6] sm:text-5xl"
          >
            <span data-count-to="33" data-count-suffix="+">0+</span>
          </p>
          <p class="mt-2 text-base font-bold text-[#0A1F4D] sm:mt-3">
            Years of Experience
          </p>
          <p class="mt-1 text-sm text-[#4A5F8C]">
            Serving industrial customers since 1993.
          </p>
        </div>

        <div
          data-reveal
          class="py-6 sm:px-8 sm:py-0 first:sm:pl-0 last:sm:pr-0"
        >
          <p
            class="text-4xl font-extrabold tracking-tight text-[#0039E6] sm:text-5xl"
          >
            <span data-count-to="2">0</span>
          </p>
          <p class="mt-2 text-base font-bold text-[#0A1F4D] sm:mt-3">
            Manufacturing Facilities
          </p>
          <p class="mt-1 text-sm text-[#4A5F8C]">
            Palghar and Dahej supporting reliable production.
          </p>
        </div>

        <div
          data-reveal
          class="py-6 sm:px-8 sm:py-0 first:sm:pl-0 last:sm:pr-0"
        >
          <div class="flex h-11 items-center sm:h-14">
            <img
              src={isoLogo.src}
              alt="ISO 9001:2015 Certified"
              class="h-11 w-auto sm:h-14"
              loading="lazy"
              decoding="async"
            />
          </div>
          <p class="mt-2 text-base font-bold text-[#0A1F4D] sm:mt-3">
            ISO 9001:2015 Certified
          </p>
          <p class="mt-1 text-sm text-[#4A5F8C]">
            Quality systems for consistent industrial supply.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- Clients -->
  <ClientsSection
    title="Trusted by Industry Leaders"
    subTitle="We're proud to partner with manufacturers and processors who demand reliability."
    partners={clientLogos}
  />

  <!-- Product categories -->
  <section class="bg-[#E8F0FF]">
    <div
      class="mx-auto max-w-[85rem] px-4 py-10 sm:px-6 sm:py-14 lg:px-8 lg:py-20"
    >
      <div data-reveal class="max-w-3xl">
        <p
          class="text-xs font-semibold tracking-[0.18em] text-[#0039E6] uppercase"
        >
          Products
        </p>
        <h2
          class="mt-3 text-2xl font-bold tracking-tight text-[#0A1F4D] sm:text-3xl md:text-4xl"
        >
          Product Categories We Supply
        </h2>
        <p
          class="mt-4 text-sm leading-relaxed text-[#4A5F8C] sm:mt-5 sm:text-base md:text-lg"
        >
          Specialty solvents, base oils, n-paraffins, olefins, and tailored
          supply for industrial buyers.
        </p>
      </div>

      <div
        data-reveal-group
        class="mt-8 grid gap-4 sm:mt-12 sm:grid-cols-2 sm:gap-6 xl:grid-cols-3"
      >
        {
          featuredCategories.map(category => (
            <a
              data-reveal
              href={`/products/${category.slug}/`}
              class="group overflow-hidden rounded-2xl border border-[#D4E4FF] bg-white shadow-lg transition-colors hover:border-[#0039E6]"
            >
              <div class="relative overflow-hidden border-b border-[#E5EEFF] bg-[#F5F9FF]">
                {category.coverUrl ? (
                  <img
                    src={category.coverUrl}
                    alt={category.name}
                    class="h-40 w-full object-cover sm:h-52"
                    loading="lazy"
                    decoding="async"
                  />
                ) : (
                  <div class="h-40 w-full bg-neutral-100 sm:h-52" />
                )}
                <div class="absolute inset-0 bg-linear-to-t from-[#0A1F4D]/65 via-[#0A1F4D]/20 to-transparent" />
                <div class="absolute right-4 bottom-4 rounded-full bg-white/92 px-3 py-1 text-xs font-semibold text-[#0A1F4D] backdrop-blur-sm">
                  {category.productCount} products
                </div>
              </div>

              <div class="p-4 sm:p-6">
                <h3 class="text-lg font-bold text-[#0A1F4D] group-hover:text-[#0039E6] sm:text-xl">
                  {category.name}
                </h3>
                <p class="mt-2 line-clamp-2 text-sm leading-relaxed text-[#4A5F8C] sm:mt-3">
                  {category.description}
                </p>
                <div class="mt-4 text-sm font-semibold text-[#0039E6] group-hover:text-[#0033CC] sm:mt-5">
                  Explore products
                </div>
              </div>
            </a>
          ))
        }
      </div>

      <div class="mt-8 text-center sm:mt-12">
        <a
          href="/products/"
          class="inline-flex min-h-11 items-center justify-center rounded-xl border border-[#C0D6FF] bg-white px-6 py-3 text-sm font-semibold text-[#0039E6] transition duration-300 hover:border-[#0039E6] hover:bg-[#F5F9FF]"
        >
          View all product categories
        </a>
      </div>
    </div>
  </section>

  <!-- FAQ -->
  <FAQ title="Common Questions" faqs={faqs} />
</MainLayout>
