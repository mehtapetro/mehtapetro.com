---
import MainLayout from '@/layouts/MainLayout.astro';
import { SITE } from '@data/constants';
import ClientsSection from '@components/sections/landing/ClientsSection.astro';
import FeaturesNavs from '@components/sections/features/FeaturesNavs.astro';
import FAQ from '@components/sections/misc/FAQ.astro';
import introVideo from '@images/intro-hero.mp4?url';
import introPoster from '@images/intro-poster.jpg';
import faqs from '@data/faqs.json';
import construction from '@images/nparaffinshome.jpg';
import tools from '@images/researching-laboratory.jpg';
import dashboard from '@images/solvemntshome.jpg';
import isoLogo from '@images/iso/ISO.svg';
import mprlLogo from '@images/mprl_logo.png';
import { clientLogos } from '@/data_files/clientLogos';

const pageTitle = `${SITE.title}`;
const metaDescription = SITE.description_short;
---

<MainLayout title={pageTitle} customDescription={metaDescription} preloadImage={introPoster.src} fullWidth overlayNav>
  <!-- Hero Section -->
  <section class="relative h-screen min-h-[720px] overflow-hidden bg-[#07142F]">
    <video
      class="absolute inset-0 h-full w-full object-cover"
      src={introVideo}
      poster={introPoster.src}
      muted
      loop
      playsinline
      preload="metadata"
      disablepictureinpicture
      aria-label="Mehta Petro-Refineries Limited facility"></video>

    <script is:inline>
      // Defer video playback until user interaction to reduce initial payload and LCP impact
      (function () {
        const vid = document.querySelector('video[aria-label="Mehta Petro-Refineries Limited facility"]');
        if (!vid || !(vid instanceof HTMLVideoElement)) return;
        function tryPlay() {
          try {
            vid.play();
          } catch (e) {
            // ignore play errors
          }
          window.removeEventListener('scroll', tryPlay);
          window.removeEventListener('pointerdown', tryPlay);
        }
        window.addEventListener('scroll', tryPlay, { once: true });
        window.addEventListener('pointerdown', tryPlay, { once: true });
      })();
    </script>

    <div
      class="absolute inset-0 bg-linear-to-br from-[#061022]/45 via-[#091126]/28 to-[#0C1C4C]/38"
    >
    </div>
    <div
      class="absolute inset-0 bg-[radial-gradient(circle_at_top_left,rgba(255,255,255,0.18),transparent_34%),radial-gradient(circle_at_bottom_right,rgba(0,57,230,0.28),transparent_28%)]"
    >
    </div>

    <div
      class="relative z-10 mx-auto flex h-full w-full max-w-[85rem] items-center px-4 sm:px-6 lg:px-8"
    >
      <div class="w-full pt-28 pb-16 sm:pt-32 sm:pb-20 lg:pt-24 lg:pb-16">
        <div class="w-full max-w-6xl">
          <div class="mb-8 sm:mb-10">
            <img
              src={mprlLogo.src}
              alt="Mehta Petro-Refineries Limited"
              class="h-18 w-auto sm:h-20 md:h-24"
            />
          </div>

          <h1
            class="w-full max-w-6xl text-4xl font-extrabold tracking-tight text-balance text-white sm:text-5xl md:text-6xl lg:text-[4.35rem] lg:leading-none lg:whitespace-nowrap"
          >
            Mehta Petro-Refineries Limited
          </h1>

          <p
            class="mt-6 max-w-2xl text-base leading-relaxed text-white/86 sm:text-lg"
          >
            Reliable supply of solvents, base oils, glycols, and specialty
            chemicals backed by clear specifications and responsive support.
          </p>

          <div class="mt-9 flex flex-col gap-4 sm:flex-row">
            <a
              href="/contact"
              class="inline-flex items-center justify-center rounded-xl bg-[#0039E6] px-7 py-4 text-base font-semibold text-white shadow-lg transition-colors hover:bg-[#0033CC]"
            >
              Get in Touch
            </a>
            <a
              href="/products"
              class="inline-flex items-center justify-center rounded-xl border border-white/24 bg-white/12 px-7 py-4 text-base font-semibold text-white backdrop-blur-md transition-colors hover:bg-white/18"
            >
              View Our Products
            </a>
          </div>

          <div class="mt-8 flex flex-wrap gap-3 text-sm text-white/90">
            <span
              class="rounded-full border border-white/18 bg-white/10 px-4 py-2 backdrop-blur-sm"
              >Aromatic & aliphatic solvents</span
            >
            <span
              class="rounded-full border border-white/18 bg-white/10 px-4 py-2 backdrop-blur-sm"
              >Base oils & glycols</span
            >
            <span
              class="rounded-full border border-white/18 bg-white/10 px-4 py-2 backdrop-blur-sm"
              >Drilling fluids & additives</span
            >
          </div>
        </div>
      </div>
    </div>

    <div
      class="pointer-events-none absolute inset-x-0 bottom-0 h-24 bg-linear-to-t from-[#E8F0FF] to-transparent"
    >
    </div>
  </section>

  <!-- Overview Section -->
  <section class="mx-auto max-w-[85rem] px-4 py-10 sm:px-6 lg:px-8 lg:py-14">
    <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
      <div class="rounded-2xl border border-[#D4E4FF] bg-white p-8 shadow-lg">
        <div class="text-5xl font-extrabold text-[#0039E6] sm:text-6xl">
          33+
        </div>
        <h3 class="mt-4 text-lg font-bold text-[#0A1F4D]">
          Years of Experience
        </h3>
        <p class="mt-2 text-sm leading-relaxed text-[#4A5F8C]">
          Serving industrial customers since 1993.
        </p>
      </div>

      <div class="rounded-2xl border border-[#D4E4FF] bg-white p-8 shadow-lg">
        <div class="text-5xl font-extrabold text-[#0039E6] sm:text-6xl">2</div>
        <h3 class="mt-4 text-lg font-bold text-[#0A1F4D]">
          Manufacturing Facilities
        </h3>
        <p class="mt-2 text-sm leading-relaxed text-[#4A5F8C]">
          Facilities in Palghar and Dahej supporting reliable production.
        </p>
      </div>

      <div
        class="rounded-2xl border border-[#D4E4FF] bg-white p-8 shadow-lg sm:col-span-2 lg:col-span-1"
      >
        <div class="flex h-16 items-center">
          <img
            src={isoLogo.src}
            alt="ISO 9001:2015 Certified"
            class="h-16 w-auto"
          />
        </div>
        <h3 class="mt-4 text-lg font-bold text-[#0A1F4D]">
          ISO 9001:2015 Certified
        </h3>
        <p class="mt-2 text-sm leading-relaxed text-[#4A5F8C]">
          Quality systems aligned with consistent industrial supply.
        </p>
      </div>
    </div>
  </section>

  <!-- Clients Section -->
  <ClientsSection
    title="Trusted by Industry Leaders"
    subTitle="We're proud to partner with manufacturers and processors who demand reliability."
    partners={clientLogos}
  />

  <!-- Core Message -->
  <section class="mx-auto max-w-[85rem] px-4 py-16 sm:px-6 lg:px-8 lg:py-24">
    <div class="grid gap-12 lg:grid-cols-2 lg:gap-16">
      <!-- Left Content -->
      <div>
        <div
          class="inline-flex items-center gap-2 rounded-full bg-[#E8F0FF] px-4 py-2"
        >
          <span class="text-sm font-semibold text-[#0039E6]">Our Approach</span>
        </div>

        <h2
          class="mt-6 text-3xl font-extrabold tracking-tight text-[#0A1F4D] sm:text-4xl lg:text-5xl"
        >
          Built for dependable industrial supply.
        </h2>

        <p class="mt-6 text-base leading-relaxed text-[#4A5F8C] sm:text-lg">
          We help industrial buyers source the right material with clear
          documentation, responsive communication, and supply support that fits
          day-to-day operations.
        </p>

        <div class="mt-8 space-y-4">
          <div class="flex items-start gap-4">
            <div
              class="mt-1 flex h-10 w-10 shrink-0 items-center justify-center rounded-lg bg-[#E8F0FF]"
            >
              <svg
                class="h-5 w-5 text-[#0039E6]"
                fill="none"
                viewBox="0 0 24 24"
                stroke="currentColor"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="2"
                  d="M5 13l4 4L19 7"></path>
              </svg>
            </div>
            <div>
              <h4 class="font-semibold text-[#0A1F4D]">Same-Day Quotes</h4>
              <p class="mt-1 text-sm text-[#4A5F8C]">
                Get pricing and availability fast
              </p>
            </div>
          </div>

          <div class="flex items-start gap-4">
            <div
              class="mt-1 flex h-10 w-10 shrink-0 items-center justify-center rounded-lg bg-[#E8F0FF]"
            >
              <svg
                class="h-5 w-5 text-[#0039E6]"
                fill="none"
                viewBox="0 0 24 24"
                stroke="currentColor"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="2"
                  d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"
                ></path>
              </svg>
            </div>
            <div>
              <h4 class="font-semibold text-[#0A1F4D]">
                Complete Documentation
              </h4>
              <p class="mt-1 text-sm text-[#4A5F8C]">
                COAs, MSDSs, and specs upfront
              </p>
            </div>
          </div>

          <div class="flex items-start gap-4">
            <div
              class="mt-1 flex h-10 w-10 shrink-0 items-center justify-center rounded-lg bg-[#E8F0FF]"
            >
              <svg
                class="h-5 w-5 text-[#0039E6]"
                fill="none"
                viewBox="0 0 24 24"
                stroke="currentColor"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="2"
                  d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"></path>
              </svg>
            </div>
            <div>
              <h4 class="font-semibold text-[#0A1F4D]">On-Time Delivery</h4>
              <p class="mt-1 text-sm text-[#4A5F8C]">
                Your schedule is our priority
              </p>
            </div>
          </div>
        </div>

        <a
          href="/contact"
          class="mt-8 inline-flex items-center font-semibold text-[#0039E6] transition-colors hover:text-[#0033CC]"
        >
          Talk to our team
        </a>
      </div>

      <!-- Right Support Grid -->
      <div class="grid grid-cols-1 gap-4 sm:grid-cols-2 sm:gap-6">
        <div class="rounded-xl border border-[#D4E4FF] bg-white p-6">
          <div class="text-sm font-semibold text-[#0039E6]">Since 1993</div>
          <div class="mt-2 text-base font-bold text-[#0A1F4D]">
            Long-term manufacturing experience
          </div>
        </div>

        <div class="rounded-xl border border-[#D4E4FF] bg-white p-6">
          <div class="text-sm font-semibold text-[#0039E6]">
            Product support
          </div>
          <div class="mt-2 text-base font-bold text-[#0A1F4D]">
            Clear specs and documentation
          </div>
        </div>

        <div class="rounded-xl border border-[#D4E4FF] bg-white p-6">
          <div class="text-sm font-semibold text-[#0039E6]">Supply network</div>
          <div class="mt-2 text-base font-bold text-[#0A1F4D]">
            Palghar and Dahej facilities
          </div>
        </div>

        <div class="rounded-xl border border-[#D4E4FF] bg-white p-6">
          <div class="text-sm font-semibold text-[#0039E6]">
            Industrial focus
          </div>
          <div class="mt-2 text-base font-bold text-[#0A1F4D]">
            B2B sourcing with responsive coordination
          </div>
        </div>

        <div
          class="rounded-xl border border-[#D4E4FF] bg-[#0039E6] p-6 text-white sm:col-span-2"
        >
          <div class="text-sm font-semibold text-white/85">
            Need a custom requirement?
          </div>
          <div class="mt-2 text-base font-bold">
            We can help with product selection, packaging, and supply planning.
          </div>
          <a
            href="/contact"
            class="mt-4 inline-flex items-center rounded-lg bg-white px-5 py-2.5 text-sm font-semibold text-[#0039E6] transition hover:bg-[#F5F9FF]"
          >
            Discuss Your Needs
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- Product Solutions -->
  <FeaturesNavs
    title=`<span class="text-[#0039E6]">Product Categories</span> We Supply`
    tabs={[
      {
        heading: 'Specialty Solvents & Base Oils',
        content:
          'High-purity solvents and base oils for industrial applications. Consistent specs, full documentation, and bulk quantities available.',
        svg: 'tools',
        src: tools,
        alt: 'Chemical products and laboratory',
        srcName: 'researching-laboratory.jpg',
        first: true,
      },
      {
        heading: 'N-Paraffins & Olefins',
        content:
          'Reliable supply of n-paraffins and olefins for manufacturing. Batch-tested quality with complete traceability.',
        svg: 'dashboard',
        src: dashboard,
        alt: 'Chemical processing and quality control',
        srcName: 'solvemntshome.jpg',
        second: true,
      },
      {
        heading: 'Custom Requirements',
        content:
          'Need something specific? We work with clients on custom formulations, packaging, and delivery schedules.',
        svg: 'house',
        src: construction,
        alt: 'Custom chemical solutions',
        srcName: 'nparaffinshome.jpg',
      },
    ]}
  />

  <!-- FAQ -->
  <FAQ title="Common<br />Questions" faqs={faqs} />
</MainLayout>
