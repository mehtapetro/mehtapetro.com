---
import MainLayout from '@/layouts/MainLayout.astro';
import ClientsSection from '@components/sections/landing/ClientsSection.astro';
import FeaturesGeneral from '@components/sections/features/FeaturesGeneral.astro';
import FeaturesNavs from '@components/sections/features/FeaturesNavs.astro';
import FAQ from '@components/sections/misc/FAQ.astro';
import introVideo from '@images/intro.mp4?url';
import faqs from '@data/faqs.json';
import features from '@data/features.json';
import construction from '@images/construction-image.avif';
import tools from '@images/automated-tools.avif';
import dashboard from '@images/dashboard-image.avif';
import { clientLogos } from '@/data_files/clientLogos';
---

<MainLayout fullWidth overlayNav>
  <section class="relative min-h-screen overflow-hidden bg-[#091126]">
    <video
      class="absolute inset-0 h-full w-full object-cover"
      src={introVideo}
      autoplay
      muted
      loop
      playsinline
      preload="auto"
      aria-label="Mehta Petro-Refineries Limited introduction video"></video>

    <div
      class="absolute inset-0 bg-linear-to-br from-[#061022]/76 via-[#091126]/52 to-[#0C1C4C]/72"
    >
    </div>
    <div
      class="absolute inset-0 bg-[radial-gradient(circle_at_top_left,rgba(255,255,255,0.18),transparent_30%),radial-gradient(circle_at_bottom_right,rgba(30,58,255,0.28),transparent_24%)]"
    >
    </div>

    <div
      class="relative z-10 mx-auto flex min-h-screen w-full max-w-[85rem] items-center px-4 sm:px-6 lg:px-8"
    >
      <div
        class="grid w-full gap-10 pt-32 pb-14 sm:pt-36 sm:pb-16 lg:grid-cols-[minmax(0,1.15fr)_minmax(20rem,0.85fr)] lg:items-end lg:gap-12 lg:pt-40 lg:pb-18"
      >
        <div class="max-w-4xl text-white">
          <span
            class="inline-flex rounded-full border border-white/20 bg-white/12 px-4 py-1.5 text-xs font-semibold tracking-[0.18em] uppercase backdrop-blur-sm"
          >
            Since 1993 • Serving Society through Science
          </span>

          <h1
            class="mt-6 max-w-5xl text-4xl font-extrabold tracking-tight text-balance sm:text-5xl lg:text-7xl lg:leading-[1.05]"
          >
            Mehta Petro-Refineries Limited
          </h1>

          <p
            class="mt-5 max-w-3xl text-base leading-8 text-white/84 sm:text-lg"
          >
            Trusted industrial supply for petrochemical solvents, specialty base
            oils, n-paraffins, olefins, and performance-focused chemical
            solutions backed by practical service, dependable quality, and
            responsive coordination.
          </p>

          <div
            class="mt-8 flex flex-col items-start gap-3 sm:flex-row sm:flex-wrap"
          >
            <a
              href="/contact"
              class="inline-flex items-center justify-center rounded-xl bg-[#1E3AFF] px-6 py-3 text-sm font-semibold text-white transition duration-300 hover:bg-[#1632E0]"
            >
              Contact Team
            </a>
            <a
              href="/capabilities"
              class="inline-flex items-center justify-center rounded-xl border border-white/18 bg-white/10 px-6 py-3 text-sm font-semibold text-white backdrop-blur-sm transition duration-300 hover:bg-white/16"
            >
              Explore Capabilities
            </a>
          </div>

          <div class="mt-8 flex flex-wrap gap-3">
            <span
              class="inline-flex rounded-full border border-white/16 bg-white/10 px-4 py-2 text-sm font-medium text-white/90 backdrop-blur-sm"
            >
              Trusted Clients
            </span>
            <span
              class="inline-flex rounded-full border border-white/16 bg-white/10 px-4 py-2 text-sm font-medium text-white/90 backdrop-blur-sm"
            >
              Long-Term Supply Relationships
            </span>
            <span
              class="inline-flex rounded-full border border-white/16 bg-white/10 px-4 py-2 text-sm font-medium text-white/90 backdrop-blur-sm"
            >
              Quality-First Supply
            </span>
          </div>
        </div>

        <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-1">
          <div
            class="rounded-[1.75rem] border border-white/14 bg-white/10 p-6 text-white shadow-[0_32px_80px_-56px_rgba(0,0,0,0.85)] backdrop-blur-md"
          >
            <p
              class="text-xs font-semibold tracking-[0.16em] text-white/72 uppercase"
            >
              Industrial strengths
            </p>
            <div class="mt-5 grid gap-4 sm:grid-cols-2 lg:grid-cols-2">
              <div>
                <p class="text-3xl font-extrabold">32+</p>
                <p class="mt-1 text-sm text-white/72">
                  years of industry presence
                </p>
              </div>
              <div>
                <p class="text-3xl font-extrabold">2</p>
                <p class="mt-1 text-sm text-white/72">
                  facilities across key locations
                </p>
              </div>
              <div>
                <p class="text-sm font-semibold text-white">
                  Reliable documentation
                </p>
                <p class="mt-1 text-sm leading-6 text-white/72">
                  Product information and commercial clarity for informed
                  decisions.
                </p>
              </div>
              <div>
                <p class="text-sm font-semibold text-white">
                  Responsive coordination
                </p>
                <p class="mt-1 text-sm leading-6 text-white/72">
                  Practical support from inquiry to supply planning and
                  dispatch.
                </p>
              </div>
            </div>
          </div>

          <div
            class="rounded-[1.75rem] border border-white/14 bg-[#0A1634]/54 p-6 text-white shadow-[0_32px_80px_-56px_rgba(0,0,0,0.85)] backdrop-blur-md"
          >
            <p
              class="text-xs font-semibold tracking-[0.16em] text-white/72 uppercase"
            >
              Operational focus
            </p>
            <ul class="mt-5 space-y-3 text-sm leading-6 text-white/82">
              <li class="flex gap-3">
                <span
                  class="mt-1 h-2.5 w-2.5 shrink-0 rounded-full bg-[#6D89FF]"
                ></span>
                Industrial solutions aligned to application, quality, and supply expectations.
              </li>
              <li class="flex gap-3">
                <span
                  class="mt-1 h-2.5 w-2.5 shrink-0 rounded-full bg-[#6D89FF]"
                ></span>
                Support for recurring requirements and dependable buyer relationships.
              </li>
              <li class="flex gap-3">
                <span
                  class="mt-1 h-2.5 w-2.5 shrink-0 rounded-full bg-[#6D89FF]"
                ></span>
                Responsive commercial coordination from product inquiry to dispatch
                planning.
              </li>
            </ul>
          </div>
        </div>
      </div>
    </div>

    <div
      class="absolute inset-x-0 bottom-0 h-24 bg-linear-to-t from-[#EEF4FF] via-[#EEF4FF]/65 to-transparent"
    >
    </div>
  </section>

  <section
    class="relative z-20 mx-auto -mt-14 max-w-[85rem] px-4 sm:px-6 lg:px-8"
  >
    <div class="grid gap-4 md:grid-cols-3">
      <div
        class="rounded-[1.6rem] border border-[#DCE8FF] bg-white/90 p-6 shadow-[0_28px_70px_-52px_rgba(30,58,255,0.42)] backdrop-blur-sm"
      >
        <p class="text-sm font-semibold text-[#1E3AFF]">Dependable legacy</p>
        <h2 class="mt-2 text-xl font-bold text-neutral-800">
          Over 32 years of trusted industrial support
        </h2>
        <p class="mt-3 text-sm leading-6 text-neutral-600">
          Built on continuity, commercial clarity, and long-term customer
          relationships.
        </p>
      </div>
      <div
        class="rounded-[1.6rem] border border-[#DCE8FF] bg-white/90 p-6 shadow-[0_28px_70px_-52px_rgba(30,58,255,0.42)] backdrop-blur-sm"
      >
        <p class="text-sm font-semibold text-[#1E3AFF]">
          Multi-location operations
        </p>
        <h2 class="mt-2 text-xl font-bold text-neutral-800">
          Stronger reach through strategic facilities
        </h2>
        <p class="mt-3 text-sm leading-6 text-neutral-600">
          Operations across different locations support planning flexibility and
          industrial servicing.
        </p>
      </div>
      <div
        class="rounded-[1.6rem] border border-[#DCE8FF] bg-white/90 p-6 shadow-[0_28px_70px_-52px_rgba(30,58,255,0.42)] backdrop-blur-sm"
      >
        <p class="text-sm font-semibold text-[#1E3AFF]">Customer response</p>
        <h2 class="mt-2 text-xl font-bold text-neutral-800">
          From inquiry to dispatch support
        </h2>
        <p class="mt-3 text-sm leading-6 text-neutral-600">
          Our team focuses on product guidance, documentation, and responsive
          coordination.
        </p>
      </div>
    </div>
  </section>

  <ClientsSection
    title="Trusted Across Industrial Sectors"
    subTitle="Supporting manufacturers, processors, and industrial buyers with dependable supply and responsive service."
    partners={clientLogos}
  />

  <section class="mx-auto max-w-[85rem] px-4 py-10 sm:px-6 lg:px-8 lg:py-14">
    <div class="grid gap-8 lg:grid-cols-[minmax(0,1.05fr)_minmax(0,0.95fr)]">
      <div
        class="rounded-[2rem] border border-[#DCE8FF] bg-white/88 p-6 shadow-[0_30px_80px_-52px_rgba(30,58,255,0.3)] sm:p-8"
      >
        <span
          class="text-sm font-semibold tracking-[0.14em] text-[#1E3AFF] uppercase"
        >
          Built around industrial needs
        </span>
        <h2 class="mt-3 text-3xl font-bold text-balance text-neutral-800">
          A more focused way to support your product and supply requirements
        </h2>
        <p class="mt-4 max-w-3xl text-base leading-7 text-neutral-600">
          Mehta Petro combines product understanding, responsive coordination,
          and dependable commercial support so buyers can move faster with more
          confidence.
        </p>

        <div class="mt-8 grid gap-5 md:grid-cols-2">
          <article
            class="rounded-[1.5rem] border border-[#DCE8FF] bg-[#F8FAFF] p-5"
          >
            <p
              class="text-xs font-semibold tracking-[0.16em] text-[#1E3AFF] uppercase"
            >
              01
            </p>
            <h3 class="mt-2 text-xl font-bold text-neutral-800">
              Discuss your requirement
            </h3>
            <p class="mt-3 text-sm leading-6 text-neutral-600">
              Share your product category, volume expectation, or application
              need with our team.
            </p>
          </article>

          <article
            class="rounded-[1.5rem] border border-[#DCE8FF] bg-[#F8FAFF] p-5"
          >
            <p
              class="text-xs font-semibold tracking-[0.16em] text-[#1E3AFF] uppercase"
            >
              02
            </p>
            <h3 class="mt-2 text-xl font-bold text-neutral-800">
              Receive practical support
            </h3>
            <p class="mt-3 text-sm leading-6 text-neutral-600">
              Get documentation, product information, and commercial guidance
              tailored to your requirement.
            </p>
          </article>

          <article
            class="rounded-[1.5rem] border border-[#DCE8FF] bg-[#F8FAFF] p-5"
          >
            <p
              class="text-xs font-semibold tracking-[0.16em] text-[#1E3AFF] uppercase"
            >
              03
            </p>
            <h3 class="mt-2 text-xl font-bold text-neutral-800">
              Plan with confidence
            </h3>
            <p class="mt-3 text-sm leading-6 text-neutral-600">
              Work with a team focused on clear communication, consistency, and
              ongoing support.
            </p>
          </article>

          <article
            class="rounded-[1.5rem] border border-[#DCE8FF] bg-[#F8FAFF] p-5"
          >
            <p
              class="text-xs font-semibold tracking-[0.16em] text-[#1E3AFF] uppercase"
            >
              04
            </p>
            <h3 class="mt-2 text-xl font-bold text-neutral-800">
              Build long-term continuity
            </h3>
            <p class="mt-3 text-sm leading-6 text-neutral-600">
              Develop a dependable relationship for recurring industrial product
              and supply needs.
            </p>
          </article>
        </div>
      </div>

      <div
        class="rounded-[2rem] border border-[#DCE8FF] bg-[#10245F] p-6 text-white shadow-[0_32px_85px_-55px_rgba(16,36,95,0.8)] sm:p-8"
      >
        <span
          class="text-sm font-semibold tracking-[0.14em] text-white/72 uppercase"
        >
          Why teams choose Mehta Petro
        </span>
        <h2 class="mt-3 text-3xl font-bold text-balance">
          Commercial clarity with operational confidence
        </h2>

        <div class="mt-8 space-y-4">
          <div class="rounded-2xl border border-white/10 bg-white/6 p-5">
            <h3 class="text-lg font-semibold">Quality-conscious supply</h3>
            <p class="mt-2 text-sm leading-6 text-white/72">
              A practical focus on product consistency and suitability for
              industrial applications.
            </p>
          </div>
          <div class="rounded-2xl border border-white/10 bg-white/6 p-5">
            <h3 class="text-lg font-semibold">Clear documentation</h3>
            <p class="mt-2 text-sm leading-6 text-white/72">
              Straightforward product and commercial information that helps
              buyers move faster.
            </p>
          </div>
          <div class="rounded-2xl border border-white/10 bg-white/6 p-5">
            <h3 class="text-lg font-semibold">Responsive commercial support</h3>
            <p class="mt-2 text-sm leading-6 text-white/72">
              Timely communication for product queries, coordination, and
              ongoing requirements.
            </p>
          </div>
          <div class="rounded-2xl border border-white/10 bg-white/6 p-5">
            <h3 class="text-lg font-semibold">
              Long-term relationship mindset
            </h3>
            <p class="mt-2 text-sm leading-6 text-white/72">
              Built around dependable service, continuity, and trust across
              repeat business cycles.
            </p>
          </div>
        </div>

        <div class="mt-8 rounded-[1.5rem] bg-white/10 p-5 backdrop-blur-sm">
          <p class="text-sm font-semibold text-white">
            Need product or capability assistance?
          </p>
          <p class="mt-2 text-sm leading-6 text-white/72">
            Connect with our team for product guidance, documentation, and
            commercial support.
          </p>
          <div class="mt-4 flex flex-col gap-3 sm:flex-row">
            <a
              href="/contact"
              class="inline-flex items-center justify-center rounded-xl bg-white px-5 py-3 text-sm font-semibold text-[#10245F] transition duration-300 hover:bg-[#E7EEFF]"
            >
              Contact Team
            </a>
            <a
              href="/capabilities"
              class="inline-flex items-center justify-center rounded-xl border border-white/16 bg-white/8 px-5 py-3 text-sm font-semibold text-white transition duration-300 hover:bg-white/14"
            >
              View Capabilities
            </a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <FeaturesGeneral
    title="Built for Industrial Reliability"
    subTitle="From sourcing and quality control to dependable dispatch and responsive support, Mehta Petro helps industrial teams keep operations moving with confidence."
    features={features}
  />

  <FeaturesNavs
    title=`Solutions from <span class="text-[#1E3AFF]">Mehta Petro</span> tailored for modern petrochemical and industrial requirements.`
    tabs={[
      {
        heading: 'Specialty Solvents & Base Oils',
        content:
          'Source dependable solvent and base oil solutions backed by consistent specifications, practical support, and reliable commercial coordination.',
        svg: 'tools',
        src: tools,
        alt: 'Industrial product and logistics visual representing solvents and base oils',
        first: true,
      },
      {
        heading: 'Consistent Supply & Logistics',
        content:
          'Plan confidently with dependable dispatch, clear communication, and supply support designed to help your operations avoid unnecessary disruption.',
        svg: 'dashboard',
        src: dashboard,
        alt: 'Supply planning and industrial logistics visual',
        second: true,
      },
      {
        heading: 'Responsive Commercial Support',
        content:
          'Work with a team that values timely responses, transparent coordination, and long-term relationships built on reliability and trust.',
        svg: 'house',
        src: construction,
        alt: 'Industrial partnership and commercial support visual',
      },
    ]}
  />

  <section class="mx-auto max-w-[85rem] px-4 py-10 sm:px-6 lg:px-8 lg:py-14">
    <div
      class="overflow-hidden rounded-[2rem] border border-[#DCE8FF] bg-linear-to-r from-[#10245F] via-[#1632A1] to-[#1E3AFF] p-8 text-white shadow-[0_34px_90px_-56px_rgba(16,36,95,0.82)] md:p-10 lg:p-12"
    >
      <div class="grid gap-8 lg:grid-cols-[minmax(0,1fr)_auto] lg:items-center">
        <div>
          <p
            class="text-sm font-semibold tracking-[0.16em] text-white/72 uppercase"
          >
            Ready to connect?
          </p>
          <h2 class="mt-3 text-3xl font-bold text-balance md:text-4xl">
            Let’s discuss your industrial product and supply requirements.
          </h2>
          <p class="mt-4 max-w-2xl text-base leading-7 text-white/80">
            Whether you need product guidance, documentation, or commercial
            support, our team is ready to help you move forward with clarity.
          </p>
        </div>
        <div class="flex flex-col gap-3 sm:flex-row lg:flex-col">
          <a
            href="/contact"
            class="inline-flex items-center justify-center rounded-xl bg-white px-6 py-3 text-sm font-semibold text-[#10245F] transition duration-300 hover:bg-[#EAF0FF]"
          >
            Contact Team
          </a>
          <a
            href="/about-us"
            class="inline-flex items-center justify-center rounded-xl border border-white/16 bg-white/8 px-6 py-3 text-sm font-semibold text-white transition duration-300 hover:bg-white/14"
          >
            Learn About Us
          </a>
        </div>
      </div>
    </div>
  </section>

  <FAQ title="Frequently<br />asked questions" faqs={faqs} />
</MainLayout>
