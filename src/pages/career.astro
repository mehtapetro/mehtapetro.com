---
import MainLayout from '@/layouts/MainLayout.astro';
import { SITE } from '@data/constants';
import TextInput from '@components/ui/forms/input/TextInput.astro';
import EmailContactInput from '@components/ui/forms/input/EmailContactInput.astro';
import PhoneInput from '@components/ui/forms/input/PhoneInput.astro';
import TextAreaInput from '@components/ui/forms/input/TextAreaInput.astro';
import AuthBtn from '@components/ui/buttons/AuthBtn.astro';

const pageTitle = `Careers | ${SITE.title}`;
const metaDescription =
  'Explore career opportunities at Mehta Petro-Refineries Limited. Join a growing team in petrochemical manufacturing and industrial chemicals.';
const ogTitle = pageTitle;
const RECAPTCHA_SITE_KEY = import.meta.env.PUBLIC_RECAPTCHA_SITE_KEY || '';

const steps = [
  'Fill in your contact details',
  'Attach your resume (PDF or DOC)',
  'Submit — we’ll get back to you',
];
---

<MainLayout
  title={pageTitle}
  customDescription={metaDescription}
  customOgTitle={ogTitle}
  structuredData={{
    '@context': 'https://schema.org',
    '@type': 'WebPage',
    '@id': `${SITE.url}/career`,
    url: `${SITE.url}/career`,
    name: pageTitle,
    description: metaDescription,
    inLanguage: 'en-US',
  }}
>
  <section
    class="mx-auto max-w-[85rem] px-4 py-10 sm:px-6 sm:py-12 lg:px-8 lg:py-16"
  >
    <div class="mx-auto max-w-5xl">
      <div
        class="grid items-start gap-8 lg:grid-cols-[minmax(0,0.9fr)_minmax(0,1.1fr)] lg:gap-12"
      >
        <div class="lg:sticky lg:top-28">
          <p
            class="text-xs font-semibold tracking-[0.18em] text-[#0039E6] uppercase"
          >
            Career
          </p>
          <h1
            class="mt-3 text-3xl font-extrabold tracking-tight text-balance text-[#0A1F4D] sm:text-4xl md:text-5xl"
          >
            Join Our Team
          </h1>
          <p
            class="mt-3 max-w-xl text-sm leading-relaxed text-[#4A5F8C] sm:mt-4 sm:text-base md:text-lg"
          >
            Build your career with a trusted name in the petrochemical industry.
            Share your details and resume — we review every application
            carefully.
          </p>

          <ol
            class="mt-6 grid grid-cols-1 gap-3 sm:grid-cols-3 lg:grid-cols-1 lg:gap-3"
          >
            {
              steps.map((step, index) => (
                <li class="flex items-start gap-3 rounded-xl border border-[#D4E4FF] bg-white/70 px-3.5 py-3 lg:border-0 lg:bg-transparent lg:px-0 lg:py-0">
                  <span
                    class="mt-0.5 flex h-6 w-6 shrink-0 items-center justify-center rounded-full bg-[#E8F0FF] text-xs font-bold text-[#0039E6]"
                    aria-hidden="true"
                  >
                    {index + 1}
                  </span>
                  <span class="text-sm leading-snug text-[#4A5F8C]">
                    {step}
                  </span>
                </li>
              ))
            }
          </ol>
        </div>

        <div
          class="rounded-2xl border border-[#D4E4FF] bg-white shadow-[0_20px_50px_-40px_rgba(10,31,77,0.35)]"
        >
          <div
            class="rounded-t-2xl border-b border-[#E3EBFF] bg-linear-to-br from-[#F7FAFF] via-white to-white px-4 py-4 sm:px-6 sm:py-5"
          >
            <p
              class="text-[11px] font-semibold tracking-[0.16em] text-[#0039E6] uppercase sm:text-xs"
            >
              Apply online
            </p>
            <h2 class="mt-1.5 text-xl font-bold text-[#0A1F4D] sm:text-2xl">
              Submit your application
            </h2>
          </div>

          <form
            id="career-form"
            action="https://usebasin.com/f/6324cbafbb15"
            method="post"
            enctype="multipart/form-data"
            class="flex flex-col gap-4 px-4 py-5 sm:gap-5 sm:px-6 sm:py-6"
            data-success-message="Thank you — your application has been submitted."
            data-error-message="Sorry, we could not submit your application. Please try again."
            data-sending-message="Sending your application…"
            data-recaptcha-sitekey={RECAPTCHA_SITE_KEY}
          >
            <input type="hidden" name="source" value="website-career" />

            <div class="grid grid-cols-1 gap-4 sm:grid-cols-2">
              <TextInput id="career-name" name="name" label="Full name" />
              <EmailContactInput id="career-email" />
            </div>

            <PhoneInput
              id="career-phone"
              countryId="career-phone-country"
              label="Phone number"
              countryLabel="Country code"
              defaultCountryCode="IN"
              required={true}
              minDigits={10}
              maxDigits={10}
            />

            <TextInput
              id="career-position"
              name="position"
              label="Position applied for"
              required={false}
            />

            <TextAreaInput
              id="career-message"
              label="Cover letter / message"
              name="message"
              rows={4}
              maxlength={500}
              showCharCount={true}
              class="min-h-[6.5rem] resize-y sm:min-h-[8rem]"
            />

            <div>
              <label
                for="career-attachments"
                class="mb-2 block text-sm font-semibold text-[#0A1F4D]"
              >
                Resume / attachments
              </label>
              <label
                for="career-attachments"
                data-career-upload-dropzone
                class="flex min-h-[5.5rem] cursor-pointer flex-col items-center justify-center gap-1.5 rounded-xl border border-dashed border-[#C0D6FF] bg-[#F7FAFF] px-4 py-5 text-center transition hover:border-[#0039E6] active:bg-white"
              >
                <span
                  class="text-sm font-semibold text-[#0039E6]"
                  data-career-upload-title
                >
                  Tap to upload resume
                </span>
                <span
                  class="text-xs leading-5 text-[#4A5F8C]"
                  data-career-upload-hint
                >
                  PDF, DOC, DOCX, PNG, or JPG · Max 10 MB
                </span>
                <input
                  id="career-attachments"
                  name="attachments[]"
                  type="file"
                  multiple
                  accept=".pdf,.doc,.docx,.png,.jpg,.jpeg"
                  class="sr-only"
                  data-career-attachments
                />
              </label>
              <div
                class="mt-3 hidden rounded-xl border border-[#C0D6FF] bg-[#F0F6FF] px-4 py-3"
                data-career-upload-feedback
                aria-live="polite"
              >
                <p
                  class="text-sm font-semibold text-[#0A1F4D]"
                  data-career-upload-summary
                >
                </p>
                <ul
                  class="mt-2 space-y-1 text-sm text-[#4A5F8C]"
                  data-career-upload-list
                >
                </ul>
                <button
                  type="button"
                  class="mt-3 text-sm font-semibold text-[#0039E6] transition-colors hover:text-[#0033CC]"
                  data-career-upload-clear
                >
                  Remove files
                </button>
              </div>
            </div>

            <p
              class="hidden min-h-[1.25rem] text-sm leading-6"
              data-form-status
              aria-live="polite"
            >
            </p>

            {
              RECAPTCHA_SITE_KEY && (
                <p class="text-xs leading-5 text-[#4A5F8C]">
                  This site is protected by reCAPTCHA and the Google{' '}
                  <a
                    href="https://policies.google.com/privacy"
                    target="_blank"
                    rel="noopener noreferrer"
                    class="font-medium text-[#0039E6] underline-offset-2 hover:underline"
                  >
                    Privacy Policy
                  </a>{' '}
                  and{' '}
                  <a
                    href="https://policies.google.com/terms"
                    target="_blank"
                    rel="noopener noreferrer"
                    class="font-medium text-[#0039E6] underline-offset-2 hover:underline"
                  >
                    Terms of Service
                  </a>{' '}
                  apply.
                </p>
              )
            }

            <div
              class="sticky bottom-0 -mx-4 border-t border-[#E3EBFF] bg-white/95 px-4 pt-4 pb-[max(1rem,env(safe-area-inset-bottom))] backdrop-blur-sm sm:static sm:mx-0 sm:border-t sm:bg-transparent sm:px-0 sm:pt-4 sm:pb-0 sm:backdrop-blur-none"
            >
              <AuthBtn title="Submit Application" />
            </div>
          </form>
        </div>
      </div>
    </div>
  </section>

  {
    RECAPTCHA_SITE_KEY && (
      <style>
        .grecaptcha-badge {
          visibility: hidden !important;
          opacity: 0 !important;
          pointer-events: none !important;
        }
      </style>
    )
  }
</MainLayout>
