---
import MainLayout from '@/layouts/MainLayout.astro';
import { SITE } from '@data/constants';
import TextInput from '@components/ui/forms/input/TextInput.astro';
import EmailContactInput from '@components/ui/forms/input/EmailContactInput.astro';
import PhoneInput from '@components/ui/forms/input/PhoneInput.astro';
import TextAreaInput from '@components/ui/forms/input/TextAreaInput.astro';
import AuthBtn from '@components/ui/buttons/AuthBtn.astro';

const pageTitle = `Career | ${SITE.title}`;
const metaDescription =
  'Join our team at Mehta Petro-Refineries Limited. Explore career opportunities and become part of our growing family.';
const ogTitle = 'Career | Mehta Petro';
const RECAPTCHA_SITE_KEY = import.meta.env.PUBLIC_RECAPTCHA_SITE_KEY || '';
---

<MainLayout
  title={pageTitle}
  customDescription={metaDescription}
  customOgTitle={ogTitle}
  structuredData={{
    '@context': 'https://schema.org',
    '@type': 'WebPage',
    '@id': 'https://mehtapetro.com/career',
    url: 'https://mehtapetro.com/career',
    name: 'Career | Mehta Petro',
    description: metaDescription,
    inLanguage: 'en-US',
  }}
>
  <section class="mx-auto max-w-[85rem] px-4 py-8 sm:px-6 sm:py-10 lg:px-8 lg:py-14">
    <div class="mx-auto max-w-5xl">
      <div class="mx-auto max-w-3xl text-center">
        <span
          class="inline-flex rounded-full border border-[#C0D6FF] bg-white px-3 py-1 text-[0.7rem] font-semibold tracking-[0.16em] text-[#0039E6] uppercase sm:px-4 sm:text-xs"
        >
          Career
        </span>
        <h1
          class="mt-4 text-3xl font-extrabold tracking-tight text-balance text-[#0A1F4D] sm:mt-5 sm:text-4xl md:text-5xl"
        >
          Join Our Team
        </h1>
        <p
          class="mx-auto mt-3 max-w-2xl text-sm leading-relaxed text-[#4A5F8C] sm:mt-4 sm:text-base md:text-lg"
        >
          Build your career with a trusted name in the petrochemical industry.
          We're always looking for talented individuals who share our commitment
          to quality and innovation.
        </p>
      </div>

      <div class="mt-8 sm:mt-10">
        <div
          class="mx-auto w-full max-w-3xl overflow-hidden rounded-2xl border border-[#D4E4FF] bg-white shadow-lg"
        >
          <div class="border-b border-[#E3EBFF] px-5 py-5 sm:px-8 sm:py-6">
            <p
              class="text-xs font-semibold tracking-[0.16em] text-[#0039E6] uppercase sm:text-sm"
            >
              Apply online
            </p>
            <h2 class="mt-1.5 text-xl font-bold text-[#0A1F4D] sm:mt-2 sm:text-2xl">
              Submit your application
            </h2>
            <p class="mt-2 text-sm leading-6 text-[#4A5F8C]">
              Attach your resume and include a short cover letter. We review every
              application carefully.
            </p>
          </div>

          <form
            id="career-form"
            action="https://usebasin.com/f/6324cbafbb15"
            method="post"
            enctype="multipart/form-data"
            class="flex flex-col gap-4 px-5 py-5 sm:gap-5 sm:px-8 sm:py-6"
            data-success-message="Thank you — your application has been submitted."
            data-error-message="Sorry, we could not submit your application. Please try again."
            data-sending-message="Sending your application…"
            data-recaptcha-sitekey={RECAPTCHA_SITE_KEY}
          >
            <input type="hidden" name="source" value="website-career" />

            <div class="grid grid-cols-1 gap-4 sm:grid-cols-2">
              <TextInput id="career-name" name="name" label="Full name" />
              <EmailContactInput id="career-email" />
            </div>

            <PhoneInput
              id="career-phone"
              countryId="career-phone-country"
              label="Phone number"
              countryLabel="Country code"
              defaultCountryCode="IN"
              minDigits={10}
              maxDigits={10}
            />

            <TextInput
              id="career-position"
              name="position"
              label="Position applied for"
              required={false}
            />

            <TextAreaInput
              id="career-message"
              label="Cover letter / message"
              name="message"
              rows={6}
              maxlength={500}
              showCharCount={true}
              class="min-h-[8.5rem] resize-y sm:min-h-[10rem]"
            />

            <div>
              <label
                for="career-attachments"
                class="mb-2 block text-sm font-semibold text-[#0A1F4D]"
              >
                Attachments
              </label>
              <input
                id="career-attachments"
                name="attachments[]"
                type="file"
                multiple
                accept=".pdf,.doc,.docx,.png,.jpg,.jpeg"
                class="block w-full rounded-lg border border-neutral-200 bg-neutral-50 px-4 py-3 text-sm text-neutral-700 file:mr-3 file:rounded-md file:border-0 file:bg-[#E8F0FF] file:px-3 file:py-1.5 file:text-sm file:font-semibold file:text-[#0039E6]"
              />
              <p class="mt-2 text-xs leading-5 text-[#4A5F8C]">
                Accepted formats: PDF, DOC, DOCX, PNG, JPG. Max 10 MB per file.
              </p>
            </div>

            <p
              class="hidden min-h-[1.25rem] text-sm leading-6"
              data-form-status
              aria-live="polite"
            >
            </p>

            <div>
              <AuthBtn title="Submit Application" />
            </div>
          </form>
        </div>

        <div class="mt-8 space-y-6 sm:mt-10">
          <div
            class="rounded-2xl border border-[#D4E4FF] bg-white p-5 shadow-lg sm:p-8"
          >
            <h2 class="text-xl font-bold text-[#0A1F4D] sm:text-2xl">
              Why Work With Us
            </h2>
            <p class="mt-2 text-sm leading-6 text-[#4A5F8C]">
              At Mehta Petro we value safety, growth, and teamwork.
            </p>

            <div class="mt-5 grid gap-4 sm:grid-cols-2">
              <div class="flex gap-3 sm:gap-4">
                <div
                  class="flex h-10 w-10 shrink-0 items-center justify-center rounded-lg bg-[#E8F0FF]"
                >
                  <svg
                    class="h-5 w-5 text-[#0039E6]"
                    fill="none"
                    viewBox="0 0 24 24"
                    stroke="currentColor"
                    aria-hidden="true"
                  >
                    <path
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      stroke-width="2"
                      d="M13 10V3L4 14h7v7l9-11h-7z"></path>
                  </svg>
                </div>
                <div>
                  <h3 class="font-semibold text-[#0A1F4D]">
                    Growth Opportunities
                  </h3>
                  <p class="mt-1 text-sm leading-6 text-[#4A5F8C]">
                    Learning programs and internal mobility.
                  </p>
                </div>
              </div>

              <div class="flex gap-3 sm:gap-4">
                <div
                  class="flex h-10 w-10 shrink-0 items-center justify-center rounded-lg bg-[#E8F0FF]"
                >
                  <svg
                    class="h-5 w-5 text-[#0039E6]"
                    fill="none"
                    viewBox="0 0 24 24"
                    stroke="currentColor"
                    aria-hidden="true"
                  >
                    <path
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      stroke-width="2"
                      d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0z"
                    ></path>
                  </svg>
                </div>
                <div>
                  <h3 class="font-semibold text-[#0A1F4D]">Experienced Team</h3>
                  <p class="mt-1 text-sm leading-6 text-[#4A5F8C]">
                    Collaborate with industry experts.
                  </p>
                </div>
              </div>

              <div class="flex gap-3 sm:gap-4">
                <div
                  class="flex h-10 w-10 shrink-0 items-center justify-center rounded-lg bg-[#E8F0FF]"
                >
                  <svg
                    class="h-5 w-5 text-[#0039E6]"
                    fill="none"
                    viewBox="0 0 24 24"
                    stroke="currentColor"
                    aria-hidden="true"
                  >
                    <path
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      stroke-width="2"
                      d="M9 12l2 2 4-4"></path>
                  </svg>
                </div>
                <div>
                  <h3 class="font-semibold text-[#0A1F4D]">Safety First</h3>
                  <p class="mt-1 text-sm leading-6 text-[#4A5F8C]">
                    Robust safety protocols and training.
                  </p>
                </div>
              </div>

              <div class="flex gap-3 sm:gap-4">
                <div
                  class="flex h-10 w-10 shrink-0 items-center justify-center rounded-lg bg-[#E8F0FF]"
                >
                  <svg
                    class="h-5 w-5 text-[#0039E6]"
                    fill="none"
                    viewBox="0 0 24 24"
                    stroke="currentColor"
                    aria-hidden="true"
                  >
                    <path
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      stroke-width="2"
                      d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3-.895 3-2-1.343-2-3-2z"
                    ></path>
                  </svg>
                </div>
                <div>
                  <h3 class="font-semibold text-[#0A1F4D]">
                    Competitive Benefits
                  </h3>
                  <p class="mt-1 text-sm leading-6 text-[#4A5F8C]">
                    Competitive pay and benefits.
                  </p>
                </div>
              </div>
            </div>
          </div>

          <div>
            <h2 class="text-lg font-bold text-[#0A1F4D] sm:text-xl">
              Current Openings
            </h2>
            <div class="mt-4 grid gap-4 sm:grid-cols-2">
              <article
                class="rounded-xl border border-[#D4E4FF] bg-white p-4 shadow-sm sm:p-5"
              >
                <h3 class="font-semibold text-[#0A1F4D]">Production Engineer</h3>
                <p class="mt-1 text-sm text-[#4A5F8C]">Full-time • Palghar</p>
                <p class="mt-2 text-sm leading-6 text-[#4A5F8C]">
                  Responsible for overseeing production processes and ensuring
                  quality standards.
                </p>
              </article>

              <article
                class="rounded-xl border border-[#D4E4FF] bg-white p-4 shadow-sm sm:p-5"
              >
                <h3 class="font-semibold text-[#0A1F4D]">
                  Maintenance Technician
                </h3>
                <p class="mt-1 text-sm text-[#4A5F8C]">Full-time • Dahej</p>
                <p class="mt-2 text-sm leading-6 text-[#4A5F8C]">
                  Perform routine maintenance and respond to equipment issues.
                </p>
              </article>
            </div>

            <p class="mt-4 text-sm leading-6 text-[#4A5F8C]">
              Don't see a match? Submit a general application above and we'll keep
              your details on file.
            </p>
          </div>
        </div>
      </div>
    </div>
  </section>
</MainLayout>
