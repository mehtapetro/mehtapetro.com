---
// Simple redirect page for legacy /blog/[id] routes to the new /news routes
import MainLayout from '@/layouts/MainLayout.astro';
import { getCollection } from 'astro:content';
import { SITE } from '@data/constants';

export async function getStaticPaths() {
  const blogPosts = await getCollection('blog', ({ id }) =>
    id.startsWith('en/')
  );
  return blogPosts.map(post => ({
    params: { id: post.id.replace(/^en\//, '') },
    props: { post },
  }));
}

const { post } = Astro.props;
const pageTitle = `${post.data.title} | ${SITE.title}`;
const metaDescription = post.data.description;
const ogTitle = `${post.data.title} | News | ${SITE.title}`;
---

<head>
  <meta
    http-equiv="refresh"
    content={`0;url=/news/${post.id.replace(/^en\//, '')}`}
  />
  <link rel="canonical" href={`/news/${post.id.replace(/^en\//, '')}`} />
</head>

<MainLayout
  title={pageTitle}
  customDescription={metaDescription}
  customOgTitle={ogTitle}
  post={post}
>
  <section class="mx-auto max-w-3xl px-4 pt-16">
    <p class="text-center">
      This article has moved to <a
        href={`/news/${post.id.replace(/^en\//, '')}`}>News</a
      >. Redirecting...
    </p>
  </section>
</MainLayout>
