---
import MainLayout from '@/layouts/MainLayout.astro';
import { SITE } from '@data/constants';
import {
  getAllCategories,
  getProductsForCategory,
  getProduct,
} from '@/lib/productFs';

import ProductCard from '@components/ui/cards/ProductCard.astro';
import ProductInquiryModal from '@components/sections/products/ProductInquiryModal.astro';

export async function getStaticPaths() {
  const categories = getAllCategories();
  const paths = [];
  for (const c of categories) {
    const products = getProductsForCategory(c.slug);
    for (const p of products) {
      paths.push({
        params: { category: c.slug, product: p.slug },
        props: { category: c, product: p },
      });
    }
  }
  return paths;
}
const { category, product } = Astro.props;
const categoryId = category.slug;
const resolvedProduct = getProduct(categoryId, product.slug) || product;
const productsInCategory = getProductsForCategory(categoryId);
const relatedProducts = productsInCategory
  .filter(p => p.slug !== resolvedProduct.slug)
  .slice(0, 3);
const datasheets = resolvedProduct.datasheetUrls?.length
  ? resolvedProduct.datasheetUrls
  : resolvedProduct.datasheetUrl
    ? [resolvedProduct.datasheetUrl]
    : [];
const datasheetCount = datasheets.length;
const heroImage = resolvedProduct.imageUrl || category.coverUrl || null;
const productLead =
  resolvedProduct.description ||
  `Product information for ${resolvedProduct.name} in the ${category.name.toLowerCase()} range.`;
const breadcrumbItems = [
  { label: 'Products', href: '/products/' },
  { label: category.name, href: `/products/${categoryId}/` },
  { label: resolvedProduct.name, href: null },
];

const pageTitle: string = `${resolvedProduct.name} | ${SITE.title}`;
const metaDescription =
  resolvedProduct.description ||
  `${resolvedProduct.name} from Mehta Petro in the ${category.name} range. Request specifications and commercial support.`;
const ogTitle = pageTitle;
---

<MainLayout
  title={pageTitle}
  customDescription={metaDescription}
  customOgTitle={ogTitle}
  structuredData={{
    '@context': 'https://schema.org',
    '@type': 'Product',
    '@id': `${SITE.url}/products/${categoryId}/${resolvedProduct.slug}`,
    name: resolvedProduct.name,
    description: metaDescription,
    brand: {
      '@type': 'Brand',
      name: SITE.legalName,
    },
    category: category.name,
    url: `${SITE.url}/products/${categoryId}/${resolvedProduct.slug}`,
  }}
>
  <!-- Product intro -->
  <section class="bg-[#E8F0FF]">
    <div
      class="mx-auto max-w-[85rem] px-4 py-10 sm:px-6 sm:py-14 lg:px-8 lg:py-20"
    >
      <nav
        class="mb-6 flex flex-wrap items-center gap-x-2 gap-y-1 text-xs text-[#4A5F8C] sm:mb-8 sm:text-sm"
      >
        {
          breadcrumbItems.map((item, index) => (
            <>
              {item.href ? (
                <a
                  href={item.href}
                  class="font-semibold text-[#0039E6] transition hover:text-[#0033CC]"
                >
                  {item.label}
                </a>
              ) : (
                <span>{item.label}</span>
              )}
              {index < breadcrumbItems.length - 1 && (
                <span aria-hidden="true">/</span>
              )}
            </>
          ))
        }
      </nav>

      <div class="grid items-center gap-8 lg:grid-cols-2 lg:gap-16">
        <div class="order-2 lg:order-none">
          <p
            class="text-xs font-semibold tracking-[0.18em] text-[#0039E6] uppercase"
          >
            Product detail
          </p>
          <h1
            class="mt-3 max-w-3xl text-3xl font-extrabold tracking-tight text-[#0A1F4D] sm:text-4xl md:text-5xl"
          >
            {resolvedProduct.name}
          </h1>
          <p
            class="mt-4 max-w-2xl text-sm leading-relaxed text-[#4A5F8C] sm:mt-5 sm:text-base md:text-lg"
          >
            {productLead}
          </p>

          <div
            class="mt-6 flex flex-wrap gap-x-4 gap-y-2 border-y border-[#C0D6FF]/70 py-4 text-sm text-[#4A5F8C]"
          >
            <span class="font-semibold text-[#0A1F4D]">{category.name}</span>
            <span aria-hidden="true">•</span>
            <span
              >{
                datasheetCount
                  ? `${datasheetCount} datasheet${datasheetCount === 1 ? '' : 's'}`
                  : 'No datasheets yet'
              }</span
            >
            <span aria-hidden="true">•</span>
            <span>{productsInCategory.length} products in range</span>
          </div>

          <div class="mt-6">
            <button
              type="button"
              data-product-inquiry-open
              aria-controls="product-inquiry-modal"
              class="inline-flex min-h-11 w-full items-center justify-center rounded-xl bg-[#0039E6] px-6 py-3 text-sm font-semibold text-white transition duration-300 hover:bg-[#0033CC] sm:w-auto"
            >
              Request Product Information
            </button>
          </div>
        </div>

        <div class="order-1 overflow-hidden rounded-2xl lg:order-none">
          {
            heroImage ? (
              <button
                type="button"
                class="group relative block h-full w-full cursor-zoom-in"
                data-product-image-open
                aria-label={`Open large image for ${resolvedProduct.name}`}
              >
                <img
                  src={heroImage}
                  alt={resolvedProduct.name}
                  class="aspect-[4/3] h-full w-full object-cover transition duration-300 group-hover:scale-[1.02]"
                  loading="eager"
                />
              </button>
            ) : (
              <div class="flex aspect-[4/3] w-full items-center justify-center bg-white text-center">
                <div>
                  <p class="text-xs font-semibold tracking-[0.18em] text-[#0039E6] uppercase">
                    Product image
                  </p>
                  <p class="mt-3 text-2xl font-bold text-[#0A1F4D]">
                    {resolvedProduct.name}
                  </p>
                </div>
              </div>
            )
          }
        </div>
      </div>
    </div>
  </section>

  <!-- Overview + datasheets + help -->
  <section class="border-y border-[#C0D6FF]/70 bg-white">
    <div
      class="mx-auto max-w-[85rem] px-4 py-10 sm:px-6 sm:py-14 lg:px-8 lg:py-20"
    >
      <div class="grid gap-10 lg:grid-cols-[1.15fr_0.85fr] lg:gap-16">
        <div>
          <p
            class="text-xs font-semibold tracking-[0.18em] text-[#0039E6] uppercase"
          >
            Overview
          </p>
          <h2
            class="mt-3 text-2xl font-bold tracking-tight text-[#0A1F4D] sm:text-3xl"
          >
            Short technical summary
          </h2>
          <p
            class="mt-4 max-w-2xl text-sm leading-relaxed text-[#4A5F8C] sm:text-base md:text-lg"
          >
            {productLead}
          </p>

          <div class="mt-10">
            <p
              class="text-xs font-semibold tracking-[0.18em] text-[#0039E6] uppercase"
            >
              Datasheets
            </p>
            <div
              class="mt-4 divide-y divide-[#C0D6FF]/70 border-y border-[#C0D6FF]/70"
            >
              {
                datasheets.length ? (
                  datasheets.map(url => {
                    const fileName = url.split('/').pop();
                    const label = fileName
                      ? decodeURIComponent(fileName)
                      : 'Datasheet';

                    return (
                      <a
                        href={url}
                        target="_blank"
                        rel="noopener noreferrer"
                        class="flex items-center justify-between py-3.5 text-sm font-semibold text-[#0039E6] transition hover:text-[#0033CC]"
                      >
                        <span>{label}</span>
                        <span aria-hidden="true">↗</span>
                      </a>
                    );
                  })
                ) : (
                  <p class="py-3.5 text-sm text-[#4A5F8C]">
                    No datasheets are available for this product yet.
                  </p>
                )
              }
            </div>
          </div>
        </div>

        <div
          class="border-t border-[#C0D6FF]/70 pt-8 lg:border-t-0 lg:border-l lg:pt-0 lg:pl-10"
        >
          <p
            class="text-xs font-semibold tracking-[0.18em] text-[#0039E6] uppercase"
          >
            Need help?
          </p>
          <h3
            class="mt-3 text-xl font-bold tracking-tight text-[#0A1F4D] sm:text-2xl"
          >
            Talk to our team
          </h3>
          <p class="mt-4 text-sm leading-relaxed text-[#4A5F8C] sm:text-base">
            Share the application, destination, or volume and we will help
            narrow the product selection.
          </p>
          <button
            type="button"
            data-product-inquiry-open
            aria-controls="product-inquiry-modal"
            class="mt-6 inline-flex min-h-11 w-full items-center justify-center rounded-xl bg-[#0039E6] px-5 py-3 text-sm font-semibold text-white transition duration-300 hover:bg-[#0033CC] sm:w-auto"
          >
            Contact our team
          </button>
        </div>
      </div>
    </div>
  </section>

  <!-- Related products -->
  <section class="bg-[#E8F0FF]">
    <div
      class="mx-auto max-w-[85rem] px-4 py-10 sm:px-6 sm:py-14 lg:px-8 lg:py-20"
    >
      <div class="max-w-3xl">
        <p
          class="text-xs font-semibold tracking-[0.18em] text-[#0039E6] uppercase"
        >
          Related products
        </p>
        <h2
          class="mt-3 text-2xl font-bold tracking-tight text-[#0A1F4D] sm:text-3xl md:text-4xl"
        >
          Other products in this range
        </h2>
      </div>

      <div class="mt-8 grid gap-4 sm:mt-12 sm:grid-cols-2 xl:grid-cols-3">
        {
          relatedProducts.length ? (
            relatedProducts.map(p => (
              <ProductCard product={p} categorySlug={categoryId} />
            ))
          ) : (
            <div class="border-t border-[#C0D6FF]/70 pt-6 text-sm text-[#4A5F8C] sm:col-span-2 xl:col-span-3">
              No related products available in this category.
            </div>
          )
        }
      </div>
    </div>
  </section>

  {
    heroImage && (
      <div
        class="fixed inset-0 z-50 hidden items-center justify-center bg-[#E8F0FF]/70 p-4 backdrop-blur-2xl"
        data-product-image-modal
        aria-hidden="true"
      >
        <button
          type="button"
          class="absolute inset-0 cursor-default"
          data-product-image-close
          aria-label="Close image preview"
        />
        <div class="relative z-10 w-full max-w-3xl overflow-hidden rounded-2xl border border-[#C0D6FF]/70 bg-white shadow-[0_24px_80px_rgba(34,83,171,0.14)]">
          <button
            type="button"
            class="absolute top-4 right-4 z-20 inline-flex h-10 w-10 items-center justify-center rounded-full border border-[#C0D6FF] bg-white text-[#0A1F4D] transition hover:bg-[#F7FAFF]"
            data-product-image-close
            aria-label="Close image preview"
          >
            <span aria-hidden="true" class="text-2xl leading-none">
              ×
            </span>
          </button>
          <div class="p-3 sm:p-4">
            <img
              src={heroImage}
              alt={resolvedProduct.name}
              class="max-h-[72vh] w-full rounded-xl object-contain"
            />
          </div>
        </div>
      </div>
    )
  }

  <ProductInquiryModal
    modalId="product-inquiry-modal"
    title="Send inquiry"
    subtitle={`Get a quick response from our team about ${resolvedProduct.name}.`}
    subject="New product enquiry from Mehta Petro website"
    fromName="Mehta Petro Product Inquiry"
    source={Astro.url.pathname}
    productName={resolvedProduct.name}
    categoryName={category.name}
  />
</MainLayout>
