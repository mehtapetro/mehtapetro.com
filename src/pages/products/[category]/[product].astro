---
import MainLayout from '@/layouts/MainLayout.astro';
import { SITE } from '@data/constants';
import {
  getAllCategories,
  getProductsForCategory,
  getProduct,
} from '@/lib/productFs';

import ProductCard from '@components/ui/cards/ProductCard.astro';
import ProductInquiryModal from '@components/sections/products/ProductInquiryModal.astro';

export async function getStaticPaths() {
  const categories = getAllCategories();
  const paths = [];
  for (const c of categories) {
    const products = getProductsForCategory(c.slug);
    for (const p of products) {
      paths.push({
        params: { category: c.slug, product: p.slug },
        props: { category: c, product: p },
      });
    }
  }
  return paths;
}
const { category, product } = Astro.props;
const categoryId = category.slug;
const resolvedProduct = getProduct(categoryId, product.slug) || product;
const productsInCategory = getProductsForCategory(categoryId);
const relatedProducts = productsInCategory
  .filter(p => p.slug !== resolvedProduct.slug)
  .slice(0, 3);
const datasheets = resolvedProduct.datasheetUrls?.length
  ? resolvedProduct.datasheetUrls
  : resolvedProduct.datasheetUrl
    ? [resolvedProduct.datasheetUrl]
    : [];
const datasheetCount = datasheets.length;
const heroImage = resolvedProduct.imageUrl || category.coverUrl || null;
const productLead =
  resolvedProduct.description ||
  `Product information for ${resolvedProduct.name} in the ${category.name.toLowerCase()} range.`;
const breadcrumbItems = [
  { label: 'Products', href: '/products/' },
  { label: category.name, href: `/products/${categoryId}/` },
  { label: resolvedProduct.name, href: null },
];

const pageTitle: string = `${resolvedProduct.name} | ${SITE.title}`;
const metaDescription = resolvedProduct.description;
const ogTitle = `${resolvedProduct.name} | Products | Mehta Petro`;
---

<MainLayout
  title={pageTitle}
  customDescription={metaDescription}
  customOgTitle={ogTitle}
  structuredData={{
    '@context': 'https://schema.org',
    '@type': 'Product',
    '@id': `${SITE.url}/products/${categoryId}/${resolvedProduct.slug}`,
    name: resolvedProduct.name,
    description: resolvedProduct.description,
    brand: {
      '@type': 'Brand',
      name: 'Mehta Petro',
    },
    category: category.description || '',
  }}
>
  <div class="text-[#0A1F4D]">
    <section class="mx-auto max-w-[85rem] px-4 py-8 sm:px-6 sm:py-12 lg:px-8 lg:py-16">
      <nav
        class="mb-4 flex flex-wrap items-center gap-x-2 gap-y-1 text-xs text-[#4A5F8C] sm:text-sm"
      >
        {
          breadcrumbItems.map((item, index) => (
            <>
              {item.href ? (
                <a
                  href={item.href}
                  class="font-semibold text-[#0039E6] transition hover:text-[#0033CC]"
                >
                  {item.label}
                </a>
              ) : (
                <span>{item.label}</span>
              )}
              {index < breadcrumbItems.length - 1 && (
                <span aria-hidden="true">/</span>
              )}
            </>
          ))
        }
      </nav>

      <div
        class="grid gap-8 lg:grid-cols-[1.05fr_0.95fr] lg:items-center lg:gap-16"
      >
        <div class="order-2 space-y-6 sm:space-y-8 lg:order-none">
          <div class="space-y-4 sm:space-y-5">
            <span
              class="inline-flex rounded-full border border-[#C0D6FF] bg-white px-3 py-1 text-[11px] font-semibold tracking-[0.18em] text-[#0039E6] uppercase sm:px-4 sm:text-xs"
            >
              Product detail
            </span>
            <h1
              class="max-w-3xl text-3xl font-extrabold tracking-tight text-[#0A1F4D] sm:text-4xl md:text-5xl"
            >
              {resolvedProduct.name}
            </h1>
            <p class="max-w-2xl text-sm leading-7 text-[#4A5F8C] sm:text-base sm:leading-8 md:text-lg">
              {productLead}
            </p>
          </div>

          <div class="flex flex-wrap items-center gap-4 text-sm text-[#4A5F8C]">
            <span class="font-semibold text-[#0A1F4D]">{category.name}</span>
            <span aria-hidden="true">•</span>
            <span
              >{
                datasheetCount
                  ? `${datasheetCount} datasheet${datasheetCount === 1 ? '' : 's'}`
                  : 'No datasheets yet'
              }</span
            >
            <span aria-hidden="true">•</span>
            <span>{productsInCategory.length} products in range</span>
          </div>

          <div class="flex flex-col gap-3 sm:flex-row sm:flex-wrap">
            <button
              type="button"
              data-product-inquiry-open
              aria-controls="product-inquiry-modal"
              class="inline-flex min-h-11 w-full items-center justify-center rounded-xl bg-[#0039E6] px-6 py-3 text-sm font-semibold text-white transition duration-300 hover:bg-[#0033CC] sm:w-auto"
            >
              Request Product Information
            </button>
          </div>
        </div>

        <div
          class="relative order-1 overflow-hidden rounded-2xl shadow-[0_24px_80px_rgba(10,31,77,0.12)] sm:rounded-[2rem] lg:order-none"
        >
          {
            heroImage ? (
              <button
                type="button"
                class="group relative z-10 block h-full w-full cursor-zoom-in"
                data-product-image-open
                aria-label={`Open large image for ${resolvedProduct.name}`}
              >
                <img
                  src={heroImage}
                  alt={resolvedProduct.name}
                  class="h-52 w-full object-cover transition duration-300 group-hover:scale-[1.02] sm:h-64 lg:h-[26rem]"
                  loading="lazy"
                />
              </button>
            ) : (
              <div class="flex h-52 w-full items-center justify-center bg-[#F5F9FF] text-center text-[#0A1F4D] sm:h-64 lg:h-[26rem]">
                <div>
                  <p class="text-xs font-semibold tracking-[0.18em] text-[#0039E6] uppercase">
                    Product image
                  </p>
                  <p class="mt-3 text-2xl font-bold">{resolvedProduct.name}</p>
                </div>
              </div>
            )
          }
          <div
            class="pointer-events-none absolute inset-0 bg-linear-to-t from-[#0A1F4D]/45 via-transparent to-transparent"
          >
          </div>
        </div>
      </div>

      <div class="mt-10 grid gap-8 sm:mt-14 sm:gap-10 lg:grid-cols-[1fr_0.8fr] lg:items-start">
        <section>
          <div class="flex flex-wrap items-end justify-between gap-3">
            <div>
              <p
                class="text-xs font-semibold tracking-[0.18em] text-[#0039E6] uppercase sm:text-sm"
              >
                Overview
              </p>
              <h2 class="mt-1 text-2xl font-bold text-[#0A1F4D] sm:mt-2 sm:text-3xl">
                Short technical summary
              </h2>
            </div>
          </div>
          <p class="mt-3 max-w-2xl text-sm leading-7 text-[#4A5F8C] sm:mt-4 sm:text-base sm:leading-8">
            {productLead}
          </p>

          <div class="mt-8">
            <p
              class="text-sm font-semibold tracking-[0.18em] text-[#0039E6] uppercase"
            >
              Datasheets
            </p>
            <div class="mt-4">
              {
                datasheets.length ? (
                  <ul class="space-y-3">
                    {datasheets.map(url => {
                      const fileName = url.split('/').pop();
                      const label = fileName
                        ? decodeURIComponent(fileName)
                        : 'Datasheet';

                      return (
                        <li>
                          <a
                            href={url}
                            target="_blank"
                            rel="noopener noreferrer"
                            class="flex items-center justify-between border-b border-[#D4E4FF] py-3 text-sm font-semibold text-[#0039E6] transition hover:text-[#0033CC]"
                          >
                            <span>{label}</span>
                            <span aria-hidden="true">↗</span>
                          </a>
                        </li>
                      );
                    })}
                  </ul>
                ) : (
                  <div class="border-b border-[#D4E4FF] py-3 text-sm text-[#4A5F8C]">
                    No datasheets are available for this product yet.
                  </div>
                )
              }
            </div>
          </div>
        </section>

        <section>
          <div class="flex items-end justify-between gap-3">
            <div>
              <p
                class="text-sm font-semibold tracking-[0.18em] text-[#0039E6] uppercase"
              >
                Need help?
              </p>
              <h3 class="mt-1 text-xl font-bold text-[#0A1F4D] sm:mt-2 sm:text-2xl">
                Talk to our team
              </h3>
            </div>
          </div>
          <p class="mt-4 text-sm leading-7 text-[#4A5F8C]">
            Share the application, destination, or volume and we will help
            narrow the product selection.
          </p>
          <button
            type="button"
            data-product-inquiry-open
            aria-controls="product-inquiry-modal"
            class="mt-5 inline-flex min-h-11 w-full items-center justify-center rounded-xl bg-[#0039E6] px-5 py-3 text-sm font-semibold text-white transition duration-300 hover:bg-[#0033CC] sm:mt-6 sm:w-auto"
          >
            Contact our team
          </button>
        </section>
      </div>

      <section class="mt-10 sm:mt-14">
        <div
          class="flex flex-col gap-2 sm:flex-row sm:items-end sm:justify-between sm:gap-3"
        >
          <div>
            <p
              class="text-xs font-semibold tracking-[0.18em] text-[#0039E6] uppercase sm:text-sm"
            >
              Related products
            </p>
            <h2 class="mt-1 text-2xl font-bold text-[#0A1F4D] sm:mt-2 sm:text-3xl md:text-4xl">
              Other products in this range
            </h2>
          </div>
        </div>

        <div class="mt-6 grid gap-4 sm:mt-8 sm:grid-cols-2 xl:grid-cols-3">
          {
            relatedProducts.length ? (
              relatedProducts.map(p => (
                <ProductCard product={p} categorySlug={categoryId} />
              ))
            ) : (
              <div class="border-t border-[#D4E4FF] pt-6 text-sm text-[#4A5F8C] sm:col-span-2 xl:col-span-3">
                No related products available in this category.
              </div>
            )
          }
        </div>
      </section>

      {
        heroImage && (
          <div
            class="fixed inset-0 z-50 hidden items-center justify-center bg-[#E8F0FF]/70 p-4 backdrop-blur-2xl"
            data-product-image-modal
            aria-hidden="true"
          >
            <button
              type="button"
              class="absolute inset-0 cursor-default"
              data-product-image-close
              aria-label="Close image preview"
            />
            <div class="relative z-10 w-full max-w-3xl overflow-hidden rounded-[1.75rem] border border-[#D4E4FF]/70 bg-[#F8FBFF]/45 shadow-[0_24px_80px_rgba(34,83,171,0.14)] backdrop-blur-2xl">
              <button
                type="button"
                class="absolute top-4 right-4 z-20 inline-flex h-10 w-10 items-center justify-center rounded-full border border-[#D4E4FF]/80 bg-white/40 text-[#0A1F4D] shadow-sm backdrop-blur-md transition hover:bg-white/60"
                data-product-image-close
                aria-label="Close image preview"
              >
                <span aria-hidden="true" class="text-2xl leading-none">
                  ×
                </span>
              </button>
              <div class="bg-[#F8FBFF]/30 p-3 sm:p-4">
                <img
                  src={heroImage}
                  alt={resolvedProduct.name}
                  class="max-h-[72vh] w-full rounded-[1.25rem] object-contain"
                />
              </div>
            </div>
          </div>
        )
      }
    </section>
  </div>

  <ProductInquiryModal
    modalId="product-inquiry-modal"
    title="Send inquiry"
    subtitle={`Get a quick response from our team about ${resolvedProduct.name}.`}
    subject="New product enquiry from Mehta Petro website"
    fromName="Mehta Petro Product Inquiry"
    source={Astro.url.pathname}
    productName={resolvedProduct.name}
    categoryName={category.name}
  />
</MainLayout>
