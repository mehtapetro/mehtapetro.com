---
import MainLayout from '@/layouts/MainLayout.astro';
import { SITE } from '@data/constants';
import { getAllCategories, getProductsForCategory } from '@/lib/productFs';
import ProductCard from '@components/ui/cards/ProductCard.astro';
import ProductInquiryModal from '@components/sections/products/ProductInquiryModal.astro';

export async function getStaticPaths() {
  const categories = getAllCategories();
  return categories.map(c => ({
    params: { id: c.slug },
    props: { category: c },
  }));
}
const { category } = Astro.props;
const categoryId = category.slug;
const items = getProductsForCategory(categoryId);
const productCount = items.length;
const featuredProduct = items[0];
const heroImage = featuredProduct?.imageUrl || category.coverUrl || null;

const pageTitle: string = `${category.name} | ${SITE.title}`;
const metaDescription =
  category.description ||
  `Explore ${category.name} from Mehta Petro — product grades, specifications, and enquiry support for industrial applications.`;
const ogTitle = pageTitle;
---

<MainLayout
  title={pageTitle}
  customDescription={metaDescription}
  customOgTitle={ogTitle}
  structuredData={{
    '@context': 'https://schema.org',
    '@type': 'CollectionPage',
    '@id': `${SITE.url}/products/${categoryId}`,
    url: `${SITE.url}/products/${categoryId}`,
    name: pageTitle,
    description: metaDescription,
    isPartOf: {
      '@type': 'WebSite',
      url: SITE.url,
      name: SITE.legalName,
    },
    inLanguage: 'en-US',
  }}
>
  <!-- Category intro -->
  <section class="bg-[#E8F0FF]">
    <div
      class="mx-auto max-w-[85rem] px-4 py-10 sm:px-6 sm:py-14 lg:px-8 lg:py-20"
    >
      <nav
        class="mb-6 flex flex-wrap items-center gap-2 text-xs text-[#4A5F8C] sm:mb-8 sm:text-sm"
      >
        <a
          href="/products/"
          class="font-semibold text-[#0039E6] transition hover:text-[#0033CC]"
          >Products</a
        >
        <span aria-hidden="true">/</span>
        <span>{category.name}</span>
      </nav>

      <div class="grid items-center gap-8 lg:grid-cols-2 lg:gap-16">
        <div class="order-2 lg:order-none">
          <p
            class="text-xs font-semibold tracking-[0.18em] text-[#0039E6] uppercase"
          >
            Product category
          </p>
          <h1
            class="mt-3 max-w-3xl text-3xl font-extrabold tracking-tight text-[#0A1F4D] sm:text-4xl md:text-5xl"
          >
            {category.name}
          </h1>
          <p
            class="mt-4 max-w-2xl text-sm leading-relaxed text-[#4A5F8C] sm:mt-5 sm:text-base md:text-lg"
          >
            {category.description}
          </p>

          <div
            class="mt-6 flex flex-wrap gap-x-4 gap-y-2 border-y border-[#C0D6FF]/70 py-4 text-sm text-[#4A5F8C]"
          >
            <span class="font-semibold text-[#0A1F4D]"
              >{productCount} products</span
            >
            <span aria-hidden="true">•</span>
            <span>Industrial supply</span>
            <span aria-hidden="true">•</span>
            <span>Datasheets available</span>
          </div>

          <div class="mt-6 flex flex-col gap-3 sm:flex-row sm:flex-wrap">
            <button
              type="button"
              data-product-inquiry-open
              aria-controls="category-inquiry-modal"
              class="inline-flex min-h-11 w-full items-center justify-center rounded-xl bg-[#0039E6] px-6 py-3 text-sm font-semibold text-white transition duration-300 hover:bg-[#0033CC] sm:w-auto"
            >
              Request Product Information
            </button>
            <a
              href="#products"
              class="inline-flex min-h-11 w-full items-center justify-center rounded-xl border border-[#C0D6FF] bg-white px-6 py-3 text-sm font-semibold text-[#0039E6] transition duration-300 hover:border-[#0039E6] hover:bg-[#F7FAFF] sm:w-auto"
            >
              Browse products
            </a>
          </div>
        </div>

        <div class="order-1 overflow-hidden rounded-2xl lg:order-none">
          {
            heroImage ? (
              <img
                src={heroImage}
                alt={featuredProduct?.name ?? category.name}
                class="aspect-[4/3] h-full w-full object-cover"
                loading="eager"
              />
            ) : (
              <div class="flex aspect-[4/3] w-full items-center justify-center bg-white text-center">
                <div>
                  <p class="text-xs font-semibold tracking-[0.18em] text-[#0039E6] uppercase">
                    Product overview
                  </p>
                  <p class="mt-3 text-2xl font-bold text-[#0A1F4D]">
                    {category.name}
                  </p>
                </div>
              </div>
            )
          }
        </div>
      </div>
    </div>
  </section>

  <!-- Product list -->
  <section id="products" class="bg-[#E8F0FF]">
    <div
      class="mx-auto max-w-[85rem] px-4 py-10 sm:px-6 sm:py-14 lg:px-8 lg:py-20"
    >
      <div class="max-w-3xl border-t border-[#C0D6FF]/70 pt-10 sm:pt-12">
        <p
          class="text-xs font-semibold tracking-[0.18em] text-[#0039E6] uppercase"
        >
          Products
        </p>
        <h2
          class="mt-3 text-2xl font-bold tracking-tight text-[#0A1F4D] sm:text-3xl md:text-4xl"
        >
          Choose the right product for your application
        </h2>
        <p
          class="mt-4 text-sm leading-relaxed text-[#4A5F8C] sm:mt-5 sm:text-base md:text-lg"
        >
          Open any product for quick technical details, then reach out when you
          are ready to move forward.
        </p>
      </div>

      <div
        class="mt-8 grid gap-4 sm:mt-12 sm:grid-cols-2 sm:gap-6 xl:grid-cols-3"
      >
        {
          items.map(item => (
            <ProductCard product={item} categorySlug={categoryId} />
          ))
        }
      </div>

      {
        items.length === 0 && (
          <div class="mt-10 border-t border-[#C0D6FF]/70 pt-8 text-center text-[#4A5F8C]">
            No products are currently listed in this category.
          </div>
        )
      }
    </div>
  </section>

  <!-- Guidance CTA -->
  <section class="bg-[#E8F0FF]">
    <div
      class="mx-auto max-w-[85rem] px-4 py-10 sm:px-6 sm:py-14 lg:px-8 lg:py-16"
    >
      <div
        class="flex flex-col gap-6 border-y border-[#C0D6FF]/70 py-8 sm:flex-row sm:items-center sm:justify-between sm:gap-10 sm:py-10"
      >
        <div class="max-w-2xl">
          <p
            class="text-xs font-semibold tracking-[0.18em] text-[#0039E6] uppercase"
          >
            Need guidance?
          </p>
          <h3
            class="mt-3 text-xl font-bold tracking-tight text-[#0A1F4D] sm:text-2xl"
          >
            Tell us your target use and we will narrow the range quickly.
          </h3>
        </div>
        <button
          type="button"
          data-product-inquiry-open
          aria-controls="category-inquiry-modal"
          class="inline-flex min-h-11 w-full shrink-0 items-center justify-center rounded-xl bg-[#0039E6] px-6 py-3 text-sm font-semibold text-white transition duration-300 hover:bg-[#0033CC] sm:w-auto"
        >
          Contact our team
        </button>
      </div>
    </div>
  </section>

  <ProductInquiryModal
    modalId="category-inquiry-modal"
    subtitle={`Send us your enquiry for ${category.name}.`}
    subject="New product category enquiry from Mehta Petro website"
    fromName="Mehta Petro Product Category Inquiry"
    source={Astro.url.pathname}
    categoryName={category.name}
  />
</MainLayout>
