---
import MainLayout from '@/layouts/MainLayout.astro';
import ProductCategory from '@components/sections/products/ProductCategory.astro';
import { getCollection } from 'astro:content';
import { SITE } from '@data/constants';
import { getProductCatalog } from '@data/productCatalog';

export async function getStaticPaths() {
  const productEntries = await getCollection('products', ({ id }) =>
    id.startsWith('en/')
  );
  return productEntries.map(product => {
    const idWithoutLang = product.id.replace(/^en\//, '');
    return {
      params: { id: idWithoutLang },
      props: { product },
    };
  });
}

const { product } = Astro.props;
const categoryId = product.id.replace(/^en\//, '');
const items = getProductCatalog('en', categoryId);

const pageTitle: string = `${product.data.description} | ${SITE.title}`;
const metaDescription = product.data.main.content;
const ogTitle = `${product.data.description} | Products | Mehta Petro`;
---

<MainLayout
  title={pageTitle}
  customDescription={metaDescription}
  customOgTitle={ogTitle}
  structuredData={{
    '@context': 'https://schema.org',
    '@type': 'CollectionPage',
    '@id': `${SITE.url}/products/${categoryId}`,
    name: product.data.description,
    description: product.data.main.content,
    isPartOf: {
      '@type': 'WebSite',
      url: SITE.url,
      name: 'Mehta Petro',
    },
  }}
>
  <ProductCategory category={product} items={items} />
</MainLayout>
