---
import MainLayout from '@/layouts/MainLayout.astro';
import { SITE } from '@data/constants';
import { getAllCategories, getProductsForCategory } from '@/lib/productFs';
import PhoneInput from '@components/ui/forms/input/PhoneInput.astro';
import { WEB3FORMS_ACCESS_KEY } from '@/data/web3forms';

const iconMap: Record<string, string> = {
  'aromatic-hydrocarbon-solvents':
    'M9.75 17L9 20l-1 1h8l-1-1-.75-3M3 13h18M5 17h14a2 2 0 002-2V5a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z',
  'aliphatic-hydrocarbon-solvents':
    'M19.428 15.428a2 2 0 00-1.022-.547l-2.387-.477a6 6 0 00-3.86.517l-.318.158a6 6 0 01-3.86.517L6.05 15.21a2 2 0 00-1.806.547M8 4h8l-1 1v5.172a2 2 0 00.586 1.414l5 5c1.26 1.26.367 3.414-1.415 3.414H4.828c-1.782 0-2.674-2.154-1.414-3.414l5-5A2 2 0 009 10.172V5L8 4z',
  'dearomatized-hydrocarbon-fluids':
    'M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z',
  'petroleum-ethers':
    'M19.428 15.428a2 2 0 00-1.022-.547l-2.387-.477a6 6 0 00-3.86.517l-.318.158a6 6 0 01-3.86.517L6.05 15.21a2 2 0 00-1.806.547M8 4h8l-1 1v5.172a2 2 0 00.586 1.414l5 5c1.26 1.26.367 3.414-1.415 3.414H4.828c-1.782 0-2.674-2.154-1.414-3.414l5-5A2 2 0 009 10.172V5L8 4z',
  'rubber-process-oil':
    'M12 6V4m0 2a2 2 0 100 4m0-4a2 2 0 110 4m-6 8a2 2 0 100-4m0 4a2 2 0 110-4m0 4v2m0-6V4m6 6v10m6-2a2 2 0 100-4m0 4a2 2 0 110-4m0 4v2m0-6V4',
  glycols:
    'M3 6l3 1m0 0l-3 9a5.002 5.002 0 006.001 0M6 7l3 9M6 7l6-2m6 2l3-1m-3 1l-3 9a5.002 5.002 0 006.001 0M18 7l3 9m-3-9l-6-2m0-2v2m0 16V5m0 16H9m3 0h3',
  'base-oils':
    'M9.663 17h4.673M12 3v1m6.364 1.636l-.707.707M21 12h-1M4 12H3m3.343-5.657l-.707-.707m2.828 9.9a5 5 0 117.072 0l-.548.547A3.374 3.374 0 0014 18.469V19a2 2 0 11-4 0v-.531c0-.895-.356-1.754-.988-2.386l-.548-.547z',
  'printing-ink-coating-oils':
    'M7 21a4 4 0 01-4-4V5a2 2 0 012-2h4a2 2 0 012 2v12a4 4 0 01-4 4zm0 0h12a2 2 0 002-2v-4a2 2 0 00-2-2h-2.343M11 7.343l1.657-1.657a2 2 0 012.828 0l2.829 2.829a2 2 0 010 2.828l-8.486 8.485M7 17h.01',
  'industrial-greases-esters':
    'M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.065 2.572c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.572 1.065c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.065-2.572c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z M15 12a3 3 0 11-6 0 3 3 0 016 0z',
  'drilling-fluids': 'M13 10V3L4 14h7v7l9-11h-7z',
  'esters-derivatives':
    'M11 4a2 2 0 114 0v1a1 1 0 001 1h3a1 1 0 011 1v3a1 1 0 01-1 1h-1a2 2 0 100 4h1a1 1 0 011 1v3a1 1 0 01-1 1h-3a1 1 0 01-1-1v-1a2 2 0 10-4 0v1a1 1 0 01-1 1H7a1 1 0 01-1-1v-3a1 1 0 00-1-1H4a2 2 0 110-4h1a1 1 0 001-1V7a1 1 0 011-1h3a1 1 0 001-1V4z',
  'acid-corrosion-inhibitors':
    'M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z',
  'trading-solvents': 'M8 7h12m0 0l-4-4m4 4l-4 4m0 6H4m0 0l4 4m-4-4l4-4',
};

const categories = getAllCategories();

const categoryCards = categories.map(cat => ({
  id: cat.slug,
  title: cat.name,
  subTitle: cat.name,
  description: cat.description,
  image: cat.coverUrl,
  imageAlt: cat.name,
  href: `/products/${cat.slug}/`,
  productCount: getProductsForCategory(cat.slug).length,
  slug: cat.slug,
  icon: iconMap[cat.slug] ?? '',
}));

const totalProducts = categoryCards.reduce(
  (sum, category) => sum + category.productCount,
  0
);
const featuredCategory = categoryCards[0];
const productInquiryGateKey = 'mehta-petro-product-contact-completed';

const pageTitle: string = `Products | ${SITE.title}`;
const metaDescription =
  'Browse Mehta Petro petrochemical solvents, specialty base oils, rubber process oils, glycols, and industrial chemicals manufactured since 1993.';
const ogTitle = pageTitle;
---

<MainLayout
  title={pageTitle}
  customDescription={metaDescription}
  customOgTitle={ogTitle}
  structuredData={{
    '@context': 'https://schema.org',
    '@type': 'CollectionPage',
    '@id': `${SITE.url}/products`,
    url: `${SITE.url}/products`,
    name: pageTitle,
    description: metaDescription,
    inLanguage: 'en-US',
  }}
>
  <section
    id="products-contact-gate"
    class="fixed inset-0 z-50 hidden items-end justify-center p-0 sm:items-center sm:p-4 sm:p-6"
    aria-hidden="true"
    role="dialog"
    aria-modal="true"
    aria-labelledby="products-gate-title"
  >
    <div
      class="absolute inset-0 bg-[#0A1F4D]/60 backdrop-blur-sm"
      aria-hidden="true"
    >
    </div>
    <button
      type="button"
      class="absolute inset-0 cursor-not-allowed"
      aria-label="Complete the form to continue browsing products"
      disabled></button>

    <div
      data-products-gate-panel
      class="relative z-10 flex max-h-[92dvh] w-full max-w-2xl flex-col overflow-hidden rounded-t-2xl border border-[#D4E4FF] bg-white shadow-[0_30px_80px_-40px_rgba(10,31,77,0.45)] sm:max-h-[92vh] sm:rounded-2xl"
    >
      <div
        class="shrink-0 border-b border-[#E3EBFF] bg-linear-to-br from-[#F7FAFF] via-white to-white px-4 py-4 sm:px-8 sm:py-6"
      >
        <span
          class="inline-flex rounded-full border border-[#C0D6FF] bg-white px-3 py-1 text-[0.65rem] font-semibold tracking-[0.14em] text-[#0039E6] uppercase sm:text-xs"
        >
          Before you continue
        </span>
        <h2
          id="products-gate-title"
          class="mt-3 text-xl font-bold text-[#0A1F4D] sm:mt-4 sm:text-2xl"
        >
          Request product details
        </h2>
        <p class="mt-2 text-sm leading-6 text-[#4A5F8C]">
          Share your contact details once to browse products and receive the
          right technical follow-up.
        </p>
      </div>

      <form
        class="flex min-h-0 flex-1 flex-col gap-3 overflow-y-auto overscroll-contain px-4 py-4 pb-[max(1rem,env(safe-area-inset-bottom))] sm:gap-4 sm:px-8 sm:py-6"
        data-contact-form
        data-success-storage-key={productInquiryGateKey}
        action="https://api.web3forms.com/submit"
        method="post"
        data-success-message="Thanks. We have received your request."
        data-error-message="We could not send your request right now. Please try again."
        data-sending-message="Sending your request…"
      >
        <input type="hidden" name="access_key" value={WEB3FORMS_ACCESS_KEY} />
        <input
          type="hidden"
          name="subject"
          value="New product inquiry from Mehta Petro website"
        />
        <input
          type="hidden"
          name="from_name"
          value="Mehta Petro Product Inquiry"
        />
        <input type="hidden" name="source" value={Astro.url.pathname} />
        <input type="hidden" name="product_name" value="Products page" />
        <input
          type="checkbox"
          name="botcheck"
          class="hidden"
          style="display: none;"
          tabindex="-1"
          autocomplete="off"
        />

        <div class="grid grid-cols-1 gap-4 sm:grid-cols-2">
          <div>
            <label for="products-gate-first-name" class="sr-only"
              >First name</label
            >
            <input
              id="products-gate-first-name"
              name="firstName"
              type="text"
              required
              autocomplete="given-name"
              class="block min-h-11 w-full rounded-lg border border-neutral-200 bg-neutral-50 px-4 py-3 text-base text-neutral-700 placeholder:text-neutral-500 focus:border-[#B8CEFF] focus:ring-3 focus:ring-[#DDE9FF] focus:outline-hidden sm:text-sm"
              placeholder="First name"
            />
          </div>
          <div>
            <label for="products-gate-last-name" class="sr-only"
              >Last name</label
            >
            <input
              id="products-gate-last-name"
              name="lastName"
              type="text"
              autocomplete="family-name"
              class="block min-h-11 w-full rounded-lg border border-neutral-200 bg-neutral-50 px-4 py-3 text-base text-neutral-700 placeholder:text-neutral-500 focus:border-[#B8CEFF] focus:ring-3 focus:ring-[#DDE9FF] focus:outline-hidden sm:text-sm"
              placeholder="Last name"
            />
          </div>
        </div>

        <div>
          <label for="products-gate-email" class="sr-only">Email</label>
          <input
            id="products-gate-email"
            name="email"
            type="email"
            required
            autocomplete="email"
            class="block min-h-11 w-full rounded-lg border border-neutral-200 bg-neutral-50 px-4 py-3 text-base text-neutral-700 placeholder:text-neutral-500 focus:border-[#B8CEFF] focus:ring-3 focus:ring-[#DDE9FF] focus:outline-hidden sm:text-sm"
            placeholder="Email address"
          />
        </div>

        <PhoneInput
          id="products-gate-phone"
          countryId="products-gate-country-code"
          label="Phone number"
          countryLabel="Country"
          defaultCountryCode="IN"
          required={true}
          minDigits={10}
          maxDigits={10}
        />

        <div>
          <label for="products-gate-company" class="sr-only">Company</label>
          <input
            id="products-gate-company"
            name="company"
            type="text"
            class="block min-h-11 w-full rounded-lg border border-neutral-200 bg-neutral-50 px-4 py-3 text-base text-neutral-700 placeholder:text-neutral-500 focus:border-[#B8CEFF] focus:ring-3 focus:ring-[#DDE9FF] focus:outline-hidden sm:text-sm"
            placeholder="Company name"
          />
        </div>

        <div>
          <label for="products-gate-message" class="sr-only">Message</label>
          <textarea
            id="products-gate-message"
            name="message"
            rows="3"
            class="block min-h-[5.5rem] w-full resize-y rounded-lg border border-neutral-200 bg-neutral-50 px-4 py-3 text-base text-neutral-700 placeholder:text-neutral-500 focus:border-[#B8CEFF] focus:ring-3 focus:ring-[#DDE9FF] focus:outline-hidden sm:min-h-[6rem] sm:text-sm"
            placeholder="Tell us what product range you need"></textarea>
        </div>

        <p
          data-form-status
          class="hidden min-h-[1.25rem] text-sm leading-6"
          aria-live="polite"
        >
        </p>

        <div class="mt-auto flex flex-col gap-3 border-t border-[#E3EBFF] pt-4">
          <div
            class="flex flex-col gap-3 sm:flex-row sm:items-center sm:justify-end"
          >
            <a
              href="/"
              class="inline-flex min-h-11 w-full items-center justify-center rounded-xl border border-[#D4E4FF] bg-white px-6 py-3 text-sm font-semibold text-[#0A1F4D] transition hover:border-[#0039E6] hover:bg-[#F5F9FF] sm:w-auto"
            >
              Go to home
            </a>
            <button
              type="submit"
              class="inline-flex min-h-11 w-full shrink-0 items-center justify-center rounded-xl bg-[#0039E6] px-6 py-3 text-sm font-semibold text-white shadow-[0_20px_45px_-25px_rgba(0,57,230,0.95)] transition duration-300 hover:bg-[#0033CC] sm:w-auto"
            >
              Submit & continue
            </button>
          </div>
          <p class="text-center text-xs leading-5 text-[#4A5F8C] sm:text-left">
            Product browsing unlocks after you submit. Or return home without
            viewing the catalog.
          </p>
        </div>
      </form>
    </div>
  </section>

  <section
    class="mx-auto mt-6 max-w-[85rem] px-4 py-8 sm:mt-10 sm:px-6 sm:py-10 lg:px-8 lg:py-14"
  >
    <div class="grid items-center gap-8 lg:grid-cols-[1fr_0.9fr] lg:gap-14">
      <div>
        <p
          class="text-xs font-semibold tracking-[0.18em] text-[#0039E6] uppercase"
        >
          Our Products
        </p>
        <h1
          class="mt-3 max-w-4xl text-3xl font-extrabold tracking-tight text-balance text-[#0A1F4D] sm:text-4xl md:text-5xl"
        >
          Industrial Products for Reliable Supply and Performance
        </h1>
        <p
          class="mt-4 max-w-3xl text-sm leading-relaxed text-[#4A5F8C] sm:mt-5 sm:text-base md:text-lg"
        >
          Explore solvents, base oils, glycols, rubber process oils, and
          specialty chemicals, organized for quick product selection and
          enquiries.
        </p>

        <div
          class="mt-6 grid grid-cols-2 gap-3 sm:mt-8 sm:gap-4 lg:grid-cols-3"
        >
          <div
            class="rounded-2xl border border-[#D4E4FF] bg-white p-4 shadow-lg sm:p-5"
          >
            <div class="text-2xl font-extrabold text-[#0039E6] sm:text-3xl">
              {categoryCards.length}
            </div>
            <p
              class="mt-1 text-xs font-semibold text-[#0A1F4D] sm:mt-2 sm:text-sm"
            >
              Product Categories
            </p>
          </div>
          <div
            class="rounded-2xl border border-[#D4E4FF] bg-white p-4 shadow-lg sm:p-5"
          >
            <div class="text-2xl font-extrabold text-[#0039E6] sm:text-3xl">
              {totalProducts}
            </div>
            <p
              class="mt-1 text-xs font-semibold text-[#0A1F4D] sm:mt-2 sm:text-sm"
            >
              Products Listed
            </p>
          </div>
        </div>
      </div>

      {
        featuredCategory && (
          <div class="order-first overflow-hidden rounded-2xl border border-[#D4E4FF] bg-white shadow-lg lg:order-none">
            <div class="relative">
              {featuredCategory.image ? (
                <img
                  src={featuredCategory.image}
                  alt={featuredCategory.imageAlt}
                  class="h-44 w-full object-cover sm:h-64 lg:h-80"
                  loading="lazy"
                />
              ) : (
                <div class="h-44 w-full bg-neutral-100 sm:h-64 lg:h-80" />
              )}
              <div class="absolute inset-0 bg-linear-to-t from-[#0A1F4D]/78 via-[#0A1F4D]/30 to-transparent" />
              <div class="absolute inset-x-0 bottom-0 p-4 sm:p-6 lg:p-7">
                <p class="text-[11px] font-semibold tracking-wide text-white/80 uppercase sm:text-xs">
                  Featured Category
                </p>
                <h2 class="mt-1 text-xl font-bold text-white sm:mt-2 sm:text-2xl">
                  {featuredCategory.title}
                </h2>
                <p class="mt-1 max-w-lg text-xs leading-relaxed text-white/85 sm:mt-2 sm:text-sm">
                  {featuredCategory.subTitle}
                </p>
              </div>
            </div>
            <div class="flex flex-col gap-4 p-4 sm:flex-row sm:flex-wrap sm:items-center sm:justify-between sm:p-6">
              <p class="text-sm leading-relaxed text-[#4A5F8C]">
                {featuredCategory.productCount} products available in this
                category.
              </p>
              <a
                href={featuredCategory.href}
                class="inline-flex min-h-11 w-full items-center justify-center rounded-xl bg-[#0039E6] px-5 py-3 text-sm font-semibold text-white transition-colors hover:bg-[#0033CC] sm:w-auto"
              >
                View Category
              </a>
            </div>
          </div>
        )
      }
    </div>
  </section>

  <section
    class="mx-auto max-w-[85rem] px-4 py-4 sm:px-6 sm:py-6 lg:px-8 lg:py-10"
  >
    <h2 class="mb-4 text-xl font-bold text-[#0A1F4D] sm:mb-6 sm:text-2xl">
      Browse by category
    </h2>
    <div class="grid gap-4 sm:grid-cols-2 sm:gap-6 xl:grid-cols-3">
      {
        categoryCards.map(category => (
          <a
            href={category.href}
            class="group overflow-hidden rounded-2xl border border-[#D4E4FF] bg-white shadow-lg transition-colors hover:border-[#0039E6]"
          >
            <div class="relative overflow-hidden border-b border-[#E5EEFF] bg-[#F5F9FF]">
              {category.image ? (
                <img
                  src={category.image}
                  alt={category.imageAlt}
                  class="h-40 w-full object-cover sm:h-52"
                  loading="lazy"
                />
              ) : (
                <div class="h-40 w-full bg-neutral-100 sm:h-52" />
              )}
              <div class="absolute inset-0 bg-linear-to-t from-[#0A1F4D]/65 via-[#0A1F4D]/20 to-transparent" />
              <div class="absolute right-4 bottom-4 rounded-full bg-white/92 px-3 py-1 text-xs font-semibold text-[#0A1F4D] backdrop-blur-sm">
                {category.productCount} products
              </div>
            </div>

            <div class="p-4 sm:p-6">
              <p class="text-[11px] font-semibold tracking-wide text-[#0039E6] uppercase sm:text-xs">
                {category.subTitle}
              </p>
              <h3 class="mt-1 text-lg font-bold text-[#0A1F4D] group-hover:text-[#0039E6] sm:mt-2 sm:text-xl">
                {category.title}
              </h3>
              <p class="mt-2 line-clamp-3 text-sm leading-relaxed text-[#4A5F8C] sm:mt-3">
                {category.description}
              </p>
              <div class="mt-4 text-sm font-semibold text-[#0039E6] group-hover:text-[#0033CC] sm:mt-5">
                Explore products
              </div>
            </div>
          </a>
        ))
      }
    </div>
  </section>

  <section
    class="mx-auto max-w-[85rem] px-4 py-8 sm:px-6 sm:py-10 lg:px-8 lg:py-14"
  >
    <div
      class="rounded-2xl border border-[#D4E4FF] bg-white p-5 shadow-lg sm:p-8 lg:p-10"
    >
      <div class="grid gap-6 lg:grid-cols-[1fr_auto] lg:items-center lg:gap-8">
        <div>
          <h2 class="text-xl font-bold text-[#0A1F4D] sm:text-2xl md:text-3xl">
            Need specifications, COA, or product guidance?
          </h2>
          <p
            class="mt-3 max-w-3xl text-sm leading-relaxed text-[#4A5F8C] sm:mt-4 sm:text-base"
          >
            If you already know the category you need, open it and review the
            available products. If you want help selecting the right material,
            our team can share technical details and respond to your requirement
            directly.
          </p>
        </div>
        <div class="flex flex-col gap-3">
          <a
            href="/contact"
            class="inline-flex min-h-11 w-full items-center justify-center rounded-xl bg-[#0039E6] px-6 py-3 text-sm font-semibold text-white transition-colors hover:bg-[#0033CC] sm:w-auto"
          >
            Request Product Information
          </a>
          <a
            href="/capabilities"
            class="inline-flex min-h-11 w-full items-center justify-center rounded-xl border border-[#D4E4FF] bg-[#F5F9FF] px-6 py-3 text-sm font-semibold text-[#0039E6] transition-colors hover:border-[#0039E6] hover:bg-white sm:w-auto"
          >
            View Our Facilities
          </a>
        </div>
      </div>
    </div>
  </section>

  <script>
    import {
      focusFirstField,
      lockPageScroll,
      trapFocus,
      unlockPageScroll,
    } from '@scripts/dialogFocus.js';

    function initProductsContactGate() {
      const gate = document.querySelector('#products-contact-gate');
      if (!(gate instanceof HTMLElement) || gate.dataset.gateBound === 'true') {
        return;
      }

      gate.dataset.gateBound = 'true';
      const gateStorageKey = 'mehta-petro-product-contact-completed';
      const panel = gate.querySelector('[data-products-gate-panel]');

      const openGate = () => {
        gate.classList.remove('hidden');
        gate.classList.add('flex');
        gate.setAttribute('aria-hidden', 'false');
        lockPageScroll();
        window.requestAnimationFrame(() => {
          if (panel instanceof HTMLElement) focusFirstField(panel);
        });
      };

      const closeGate = () => {
        gate.classList.add('hidden');
        gate.classList.remove('flex');
        gate.setAttribute('aria-hidden', 'true');
        unlockPageScroll();
      };

      let hasCompletedGate = false;
      try {
        hasCompletedGate =
          window.localStorage.getItem(gateStorageKey) === 'true';
      } catch {
        hasCompletedGate = false;
      }

      if (!hasCompletedGate) {
        window.setTimeout(openGate, 120);
      }

      let gateCloseTimeoutId = 0;

      gate.addEventListener('contact-form:success', () => {
        if (gateCloseTimeoutId) {
          window.clearTimeout(gateCloseTimeoutId);
        }

        try {
          window.localStorage.setItem(gateStorageKey, 'true');
        } catch {
          // Ignore storage failures and keep the gate behavior intact.
        }

        gateCloseTimeoutId = window.setTimeout(() => {
          closeGate();
          gateCloseTimeoutId = 0;
        }, 1800);
      });

      gate.addEventListener('keydown', event => {
        if (gate.classList.contains('hidden')) return;

        // Keep the gate mandatory — Escape cannot unlock the catalog.
        if (event.key === 'Escape') {
          event.preventDefault();
          event.stopPropagation();
          return;
        }

        if (panel instanceof HTMLElement) {
          trapFocus(panel, event);
        }
      });
    }

    initProductsContactGate();
    document.addEventListener('astro:page-load', initProductsContactGate);
  </script>
</MainLayout>
