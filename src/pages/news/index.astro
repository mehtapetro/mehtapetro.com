---
import MainLayout from '@/layouts/MainLayout.astro';
import CardBlog from '@components/ui/cards/CardBlog.astro';
import { getCollection } from 'astro:content';
import type { CollectionEntry } from 'astro:content';
import { SITE } from '@data/constants';

const englishBlogEntries = await getCollection('blog', ({ id }) => {
  return id.startsWith('en/');
});

const blogPosts: CollectionEntry<'blog'>[] = englishBlogEntries.sort(
  (a: CollectionEntry<'blog'>, b: CollectionEntry<'blog'>) =>
    b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);

const title = 'Newsroom';
const subTitle =
  'Latest news, updates, and insights from Mehta Petro.';

const pageTitle = `News | ${SITE.title}`;
const metaDescription =
  'Latest news, product updates, and company developments from Mehta Petro-Refineries Limited.';
const ogTitle = pageTitle;
---

<MainLayout
  title={pageTitle}
  customDescription={metaDescription}
  customOgTitle={ogTitle}
  structuredData={{
    '@context': 'https://schema.org',
    '@type': 'CollectionPage',
    '@id': `${SITE.url}/news`,
    url: `${SITE.url}/news`,
    name: pageTitle,
    description: metaDescription,
    isPartOf: {
      '@type': 'WebSite',
      url: SITE.url,
      name: SITE.legalName,
    },
    inLanguage: 'en-US',
  }}
>
  <section
    class="mx-auto max-w-[85rem] px-4 py-10 sm:px-6 sm:py-12 lg:px-8 lg:py-16"
  >
    <div
      class="grid grid-cols-1 gap-10 lg:grid-cols-12 lg:items-start lg:gap-12"
    >
      <div class="lg:col-span-7">
        <div class="max-w-3xl">
          <p
            class="text-xs font-semibold tracking-[0.18em] text-[#0039E6] uppercase"
          >
            Company news
          </p>
          <h1
            class="mt-3 text-3xl font-extrabold tracking-tight text-balance text-[#0A1F4D] sm:text-4xl md:text-5xl"
          >
            {title}
          </h1>
          <p
            class="mt-3 text-sm leading-relaxed text-[#4A5F8C] sm:mt-4 sm:text-base md:text-lg"
          >
            {subTitle}
          </p>
        </div>

        <div class="mt-8 sm:mt-10">
          {
            blogPosts.length === 0 ? (
              <div class="border-y border-[#D4E4FF] py-10 text-center">
                <p class="text-sm text-[#4A5F8C] sm:text-base">
                  No articles are available yet.
                </p>
              </div>
            ) : (
              <div class="flex flex-col gap-3 sm:gap-4">
                {blogPosts.map(blogEntry => (
                  <CardBlog blogEntry={blogEntry} />
                ))}
              </div>
            )
          }
        </div>
      </div>

      <aside class="hidden lg:sticky lg:top-28 lg:col-span-5 lg:block">
        <div
          class="flex min-h-[580px] w-full justify-center overflow-hidden rounded-2xl border border-[#D4E4FF] bg-white"
          data-facebook-embed
          data-facebook-href="https://www.facebook.com/mehtapetro"
          data-facebook-height="580"
          data-facebook-state="idle"
          aria-label="Mehta Petro Facebook page"
        >
          <div
            class="flex min-h-[580px] w-full flex-col items-center justify-center gap-3 px-4 text-center"
            data-facebook-placeholder
          >
            <span
              class="inline-flex h-8 w-8 animate-spin rounded-full border-2 border-[#1877F2]/25 border-t-[#1877F2]"
              aria-hidden="true"></span
            >
            <p class="text-sm font-medium text-[#4A5F8C]">
              Loading Facebook feed…
            </p>
          </div>
        </div>
      </aside>
    </div>
  </section>
</MainLayout>
