---
import MainLayout from '@/layouts/MainLayout.astro';
import AvatarBlogLarge from '@components/ui/avatars/AvatarBlogLarge.astro';
import SocialShare from '@components/ui/buttons/SocialShare.astro';
import { Image } from 'astro:assets';
import { capitalize, formatDate } from '@utils/utils';
import { getCollection, render } from 'astro:content';
import { SITE } from '@data/constants';

// Update getStaticPaths for English posts
export async function getStaticPaths() {
  const blogPosts = await getCollection('blog', ({ id }) =>
    id.startsWith('en/')
  );
  return blogPosts.map(post => {
    const idWithoutLang = post.id.replace(/^en\//, ''); // Remove the "en/" prefix
    return {
      params: { id: idWithoutLang },
      props: { post },
    };
  });
}

// Get the current post's data
const { post } = Astro.props;
const { Content } = await render(post);

const newsSlug = post.id.replace(/^en\//, '');
const pageTitle: string = `${post.data.title} | ${SITE.title}`;
const metaDescription = post.data.description;
const ogTitle = pageTitle;
const articleUrl = `${SITE.url}/news/${newsSlug}`;
---

<MainLayout
  title={pageTitle}
  customDescription={metaDescription}
  customOgTitle={ogTitle}
  post={post}
  ogImage={post.data.cardImage}
  ogImageAlt={post.data.cardImageAlt}
  structuredData={{
    '@context': 'https://schema.org',
    '@type': 'NewsArticle',
    headline: post.data.title,
    description: metaDescription,
    datePublished: post.data.pubDate.toISOString(),
    author: {
      '@type': 'Organization',
      name: post.data.author,
    },
    publisher: {
      '@type': 'Organization',
      name: SITE.legalName,
      logo: {
        '@type': 'ImageObject',
        url: `${SITE.url}/favicon.ico`,
      },
    },
    mainEntityOfPage: {
      '@type': 'WebPage',
      '@id': articleUrl,
    },
    url: articleUrl,
  }}
>
  <section
    class="mx-auto max-w-3xl px-4 pt-8 pb-10 sm:px-6 sm:pt-10 sm:pb-12 lg:px-8 lg:pt-14"
  >
    <a
      href="/news"
      class="mb-6 inline-flex min-h-10 items-center gap-2 text-sm font-semibold text-[#0039E6] transition hover:text-[#0033CC]"
    >
      <svg
        class="h-4 w-4"
        xmlns="http://www.w3.org/2000/svg"
        fill="none"
        viewBox="0 0 24 24"
        stroke="currentColor"
        aria-hidden="true"
      >
        <path
          stroke-linecap="round"
          stroke-linejoin="round"
          stroke-width="2"
          d="M15 19l-7-7 7-7"></path>
      </svg>
      Back to news
    </a>

    <div class="mx-auto max-w-2xl">
      <div class="mb-6 flex items-start sm:mb-8">
        <div class="flex w-full items-start gap-3 sm:items-center sm:gap-4">
          <AvatarBlogLarge blogEntry={post} />
          <div class="min-w-0 flex-1">
            <span class="block text-sm font-bold text-[#0A1F4D] sm:text-base">
              {post.data.author}
            </span>
            <ul
              class="mt-1 flex flex-wrap items-center gap-x-2 gap-y-1 text-xs text-[#4A5F8C]"
            >
              <li>{formatDate(post.data.pubDate)}</li>
              <li aria-hidden="true">•</li>
              <li>{post.data.readTime} min read</li>
            </ul>
          </div>
        </div>
      </div>
      <h1
        class="mb-4 text-2xl font-extrabold tracking-tight text-balance text-[#0A1F4D] sm:mb-5 sm:text-3xl md:text-4xl"
      >
        {post.data.title}
      </h1>
      <Image
        class="mb-6 w-full rounded-xl object-cover sm:mb-8 sm:rounded-2xl"
        src={post.data.cardImage}
        alt={post.data.cardImageAlt}
        draggable={'false'}
        format={'avif'}
      />
      <article
        class="prose prose-base prose-neutral prose-headings:text-[#0A1F4D] prose-a:text-[#0039E6] sm:prose-lg mb-6 max-w-none text-pretty sm:mb-8"
      >
        <Content />
      </article>
      <div
        class="flex flex-col gap-4 border-t border-[#E3EBFF] pt-5 sm:flex-row sm:items-center sm:justify-between sm:pt-6"
      >
        <div class="flex flex-wrap gap-2">
          {
            post.data.tags?.map((tag: string) => (
              <span class="inline-flex items-center gap-x-1.5 rounded-full border border-[#D4E4FF] bg-[#F5F9FF] px-3 py-1.5 text-xs font-semibold text-[#0039E6]">
                {capitalize(tag)}
              </span>
            ))
          }
        </div>
        <div class="flex items-center sm:justify-end">
          <SocialShare pageTitle={post.data.title} />
        </div>
      </div>
    </div>
  </section>
</MainLayout>
