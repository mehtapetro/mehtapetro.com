---
import MainLayout from '@/layouts/MainLayout.astro';
import { Image } from 'astro:assets';
import { SITE } from '@data/constants';
import manufacturingHero from '@images/construction-image.avif';
import productionImage from '@images/progress-building.avif';
import supportImage from '@images/dashboard-image.avif';

const pageTitle = `Manufacturing | ${SITE.title}`;
const metaDescription =
  'Discover the manufacturing capability of Mehta Petro-Refineries Limited, built around process discipline, quality consistency, and dependable industrial supply.';
const ogTitle = 'Manufacturing | Mehta Petro';

const pillars = [
  {
    title: 'Process Discipline',
    description:
      'Structured operating practices designed to maintain consistency across production activity and output handling.',
  },
  {
    title: 'Quality Consistency',
    description:
      'A manufacturing mindset that values stable specifications, dependable execution, and customer confidence.',
  },
  {
    title: 'Dispatch Readiness',
    description:
      'Commercial and operational coordination that supports practical turnaround and dependable supply planning.',
  },
  {
    title: 'Customer Focus',
    description:
      'Manufacturing aligned with real industrial requirements, responsive communication, and long-term business relationships.',
  },
];
---

<MainLayout
  title={pageTitle}
  customDescription={metaDescription}
  customOgTitle={ogTitle}
  structuredData={{
    '@context': 'https://schema.org',
    '@type': 'WebPage',
    '@id': 'https://mehtapetro.com/capabilities/manufacturing',
    url: 'https://mehtapetro.com/capabilities/manufacturing',
    name: 'Manufacturing | Mehta Petro',
    description: metaDescription,
    inLanguage: 'en-US',
  }}
>
  <section
    class="mx-auto mt-10 max-w-[85rem] px-4 py-10 sm:px-6 lg:px-8 lg:py-14"
  >
    <div
      class="grid items-center gap-10 lg:grid-cols-[minmax(0,1.05fr)_minmax(0,0.95fr)] lg:gap-14"
    >
      <div>
        <span
          class="inline-flex rounded-full border border-[#C0D6FF] bg-white px-4 py-1 text-xs font-semibold tracking-[0.18em] text-[#0039E6] uppercase"
        >
          Manufacturing
        </span>
        <h1
          class="mt-5 text-4xl font-extrabold tracking-tight text-balance text-[#10245F] md:text-5xl"
        >
          Manufacturing capability that supports reliable industrial
          performance.
        </h1>
        <p class="mt-5 max-w-2xl text-lg leading-8 text-[#5B6785]">
          Mehta Petro-Refineries Limited approaches manufacturing with a focus
          on process discipline, practical quality control, and dependable
          supply support for industrial customers.
        </p>
      </div>
      <div
        class="overflow-hidden rounded-[2rem] border border-[#D4E4FF] bg-white p-3 shadow-[0_28px_70px_-48px_rgba(10,31,77,0.35)]"
      >
        <Image
          src={manufacturingHero}
          alt="Manufacturing capability at Mehta Petro"
          class="h-full w-full rounded-[1.5rem] object-cover"
          format="avif"
        />
      </div>
    </div>
  </section>

  <section class="mx-auto max-w-[85rem] px-4 py-8 sm:px-6 lg:px-8 lg:py-12">
    <div class="grid gap-4 sm:grid-cols-2 xl:grid-cols-4">
      {
        pillars.map(item => (
          <div class="rounded-[1.5rem] border border-[#D4E4FF] bg-white p-5 shadow-[0_18px_44px_-38px_rgba(10,31,77,0.22)]">
            <h2 class="text-lg font-bold text-[#0A1F4D]">{item.title}</h2>
            <p class="mt-3 text-sm leading-7 text-[#4A5F8C]">
              {item.description}
            </p>
          </div>
        ))
      }
    </div>
  </section>

  <section class="mx-auto max-w-[85rem] px-4 py-8 sm:px-6 lg:px-8 lg:py-12">
    <div
      class="grid items-center gap-8 rounded-[2rem] border border-[#D4E4FF] bg-white p-6 shadow-[0_24px_60px_-46px_rgba(10,31,77,0.28)] sm:p-8 lg:grid-cols-2 lg:p-10"
    >
      <div>
        <p
          class="text-sm font-semibold tracking-[0.18em] text-[#1E3AFF] uppercase"
        >
          What This Means
        </p>
        <h2 class="mt-3 text-3xl font-bold text-[#10245F] md:text-4xl">
          A practical production approach centered on consistency and
          accountability.
        </h2>
        <p class="mt-5 text-base leading-8 text-[#5B6785]">
          Our manufacturing outlook is built around maintaining disciplined
          processes, supporting reliable output, and helping customers source
          products with greater confidence. We understand that industrial buyers
          depend on continuity, clarity, and timely coordination—not only
          product availability.
        </p>
        <p class="mt-4 text-base leading-8 text-[#5B6785]">
          That is why our capability is designed to support dependable order
          execution, careful commercial follow-through, and responsiveness
          aligned with practical business requirements.
        </p>
      </div>
      <div
        class="overflow-hidden rounded-[1.75rem] border border-[#E3EBFF] bg-[#F5F9FF] p-3 shadow-[0_18px_40px_-34px_rgba(10,31,77,0.28)]"
      >
        <Image
          src={productionImage}
          alt="Production and operational discipline"
          class="h-full w-full rounded-[1.35rem] object-cover"
          format="avif"
        />
      </div>
    </div>
  </section>

  <section class="mx-auto max-w-[85rem] px-4 py-8 sm:px-6 lg:px-8 lg:py-12">
    <div
      class="grid items-center gap-8 rounded-[2rem] border border-[#D4E4FF] bg-[#F5F9FF] p-6 shadow-[0_24px_60px_-46px_rgba(10,31,77,0.22)] sm:p-8 lg:grid-cols-[minmax(0,0.9fr)_minmax(0,1.1fr)] lg:p-10"
    >
      <div
        class="overflow-hidden rounded-[1.75rem] border border-white/80 bg-white p-3 shadow-[0_18px_40px_-34px_rgba(16,36,95,0.35)]"
      >
        <Image
          src={supportImage}
          alt="Commercial coordination and dispatch support"
          class="h-full w-full rounded-[1.35rem] object-cover"
          format="avif"
        />
      </div>
      <div>
        <p
          class="text-sm font-semibold tracking-[0.18em] text-[#1E3AFF] uppercase"
        >
          Enquiry to Dispatch
        </p>
        <h2 class="mt-3 text-3xl font-bold text-[#10245F] md:text-4xl">
          Manufacturing backed by responsive support.
        </h2>
        <p class="mt-5 text-base leading-8 text-[#5B6785]">
          Beyond production capability, our team works to provide clear
          communication, commercial responsiveness, and dependable coordination
          that help customers move from enquiry to dispatch with fewer
          uncertainties.
        </p>
        <p class="mt-4 text-base leading-8 text-[#5B6785]">
          If you would like to discuss requirements, volumes, or supply
          expectations, our team is ready to connect and support your next
          enquiry.
        </p>
        <a
          href="/contact"
          class="mt-6 inline-flex rounded-xl bg-[#0039E6] px-5 py-3 text-sm font-semibold text-white transition duration-300 hover:bg-[#0033CC]"
        >
          Contact Our Team
        </a>
      </div>
    </div>
  </section>
</MainLayout>
