---
import MainLayout from '@/layouts/MainLayout.astro';
import { Image } from 'astro:assets';
import { SITE } from '@data/constants';
import palgharImage from '@images/palghar.jpg';
import dahejImage from '@images/dahej.jpeg';

const pageTitle = `Capabilities | ${SITE.title}`;
const metaDescription =
  'Explore Mehta Petro manufacturing capabilities across Palghar and Dahej — distillation, catalytic processes, storage, and quality-focused industrial supply.';
const ogTitle = pageTitle;

const proofPoints = [
  {
    value: '2',
    label: 'Manufacturing Facilities',
    detail: 'Maharashtra & Gujarat',
  },
  {
    value: '6400+',
    label: 'KL Monthly Capacity',
    detail: 'Distillation & processing',
  },
  {
    value: '6000',
    label: 'KL Storage',
    detail: 'Overhead & underground tanks',
  },
];

const facilities = [
  {
    id: 'palghar',
    title: 'Palghar Facility',
    location: 'Palghar, Maharashtra',
    image: palgharImage,
    alt: 'Manufacturing facility at Palghar, Maharashtra',
    highlights: [
      '1400 KL/Month continuous distillation plant',
      '600 KL/Month reaction vessel with vacuum facilities',
      '10 lakh KCAL/HRS thermic fluid heater',
      '1500 KL storage facilities',
    ],
  },
  {
    id: 'dahej',
    title: 'Dahej Facility',
    location: 'Dahej, Gujarat',
    image: dahejImage,
    alt: 'Manufacturing facility at Dahej, Gujarat',
    highlights: [
      '5000 KL/Month continuous distillation plant under vacuum',
      '1200 KL/Month catalytic process plant',
      '20 lakh KCAL/HRS coal fire thermic fluid heater',
      'SCADA integrated plant operations',
    ],
  },
];
---

<MainLayout
  title={pageTitle}
  customDescription={metaDescription}
  customOgTitle={ogTitle}
  fullWidth
  overlayNav
  structuredData={{
    '@context': 'https://schema.org',
    '@type': 'WebPage',
    '@id': `${SITE.url}/capabilities`,
    url: `${SITE.url}/capabilities`,
    name: pageTitle,
    description: metaDescription,
    inLanguage: 'en-US',
  }}
>
  <!-- Hero -->
  <section
    class="relative flex min-h-[560px] flex-col overflow-hidden bg-[#07142F] sm:min-h-[640px] lg:min-h-[720px]"
  >
    <Image
      src={dahejImage}
      alt=""
      class="absolute inset-0 h-full w-full object-cover"
      widths={[960, 1440, 1920]}
      sizes="100vw"
      loading="eager"
      fetchpriority="high"
      aria-hidden="true"
    />
    <div
      class="pointer-events-none absolute inset-0 bg-[#061022]/45"
      aria-hidden="true"
    >
    </div>

    <div
      class="relative z-10 mx-auto flex w-full max-w-[85rem] flex-1 flex-col justify-end px-4 pt-28 pb-16 sm:px-6 sm:pt-32 sm:pb-20 lg:px-8 lg:pb-24"
    >
      <p
        class="text-xs font-semibold tracking-[0.2em] text-[#8EC5FF] uppercase sm:text-sm"
      >
        Capabilities
      </p>
      <h1
        class="mt-4 max-w-4xl text-4xl font-extrabold tracking-tight text-balance text-white sm:text-5xl md:text-6xl"
      >
        Two Manufacturing Facilities Ready to Serve
      </h1>
      <p
        class="mt-5 max-w-2xl text-base leading-relaxed text-white/86 sm:text-lg"
      >
        Modern plants in Palghar and Dahej—equipped with distillation, storage,
        and process control to deliver petrochemical products reliably.
      </p>
    </div>

    <div
      class="pointer-events-none absolute inset-x-0 bottom-0 h-20 bg-linear-to-t from-[#E8F0FF] to-transparent"
      aria-hidden="true"
    >
    </div>
  </section>

  <!-- Capacity proof -->
  <section class="bg-[#E8F0FF]">
    <div
      class="mx-auto max-w-[85rem] px-4 py-10 sm:px-6 sm:py-14 lg:px-8 lg:py-20"
    >
      <div data-reveal class="max-w-3xl">
        <p
          class="text-xs font-semibold tracking-[0.18em] text-[#0039E6] uppercase"
        >
          Capacity
        </p>
        <h2
          class="mt-3 text-2xl font-bold tracking-tight text-[#0A1F4D] sm:text-3xl md:text-4xl"
        >
          Built for Industrial Scale
        </h2>
        <p
          class="mt-4 text-sm leading-relaxed text-[#4A5F8C] sm:mt-5 sm:text-base md:text-lg"
        >
          Combined capacity across Palghar and Dahej supports steady output,
          dependable storage, and quality-focused supply for industrial buyers.
        </p>
      </div>

      <div
        data-reveal-group
        class="mt-8 divide-y divide-[#C0D6FF]/70 border-y border-[#C0D6FF]/70 sm:mt-12 sm:grid sm:grid-cols-3 sm:gap-0 sm:divide-x sm:divide-y-0 sm:divide-[#C0D6FF]/70 sm:py-10"
      >
        {
          proofPoints.map(point => (
            <div
              data-reveal
              class="py-6 sm:px-8 sm:py-0 first:sm:pl-0 last:sm:pr-0"
            >
              <p class="text-4xl font-extrabold tracking-tight text-[#0039E6] sm:text-5xl">
                {point.value}
              </p>
              <p class="mt-2 text-base font-bold text-[#0A1F4D] sm:mt-3">
                {point.label}
              </p>
              <p class="mt-1 text-sm text-[#4A5F8C]">{point.detail}</p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <!-- Facilities -->
  <section class="border-y border-[#C0D6FF]/70 bg-white">
    <div
      class="mx-auto max-w-[85rem] px-4 py-10 sm:px-6 sm:py-14 lg:px-8 lg:py-20"
    >
      <div data-reveal class="max-w-3xl">
        <p
          class="text-xs font-semibold tracking-[0.18em] text-[#0039E6] uppercase"
        >
          Sites
        </p>
        <h2
          class="mt-3 text-2xl font-bold tracking-tight text-[#0A1F4D] sm:text-3xl md:text-4xl"
        >
          Our Facilities
        </h2>
        <p
          class="mt-4 text-sm leading-relaxed text-[#4A5F8C] sm:mt-5 sm:text-base md:text-lg"
        >
          Each site is equipped with modern process equipment, safety systems,
          and quality control for consistent industrial delivery.
        </p>
      </div>

      <div class="mt-10 space-y-14 sm:mt-12 lg:space-y-20">
        {
          facilities.map((facility, facilityIndex) => (
            <article
              id={facility.id}
              data-reveal
              class:list={[
                'grid items-center gap-8 border-t border-[#C0D6FF]/70 pt-10 sm:gap-10 sm:pt-12 lg:grid-cols-2 lg:gap-16',
                facilityIndex % 2 === 1 && 'lg:[&>*:first-child]:order-2',
              ]}
            >
              <div class="overflow-hidden rounded-2xl">
                <Image
                  src={facility.image}
                  alt={facility.alt}
                  class="aspect-[4/3] h-full w-full object-cover"
                  widths={[640, 960, 1280]}
                  sizes="(min-width: 1024px) 42vw, 90vw"
                  loading="lazy"
                />
              </div>

              <div>
                <p class="text-xs font-semibold tracking-[0.18em] text-[#0039E6] uppercase">
                  Facility {String(facilityIndex + 1).padStart(2, '0')}
                </p>
                <h3 class="mt-3 text-2xl font-bold tracking-tight text-[#0A1F4D] sm:text-3xl">
                  {facility.title}
                </h3>
                <p class="mt-2 text-base font-medium text-[#4A5F8C]">
                  {facility.location}
                </p>

                <ul class="mt-8 divide-y divide-[#C0D6FF]/70 border-y border-[#C0D6FF]/70">
                  {facility.highlights.map(highlight => (
                    <li class="py-3.5 text-sm leading-relaxed text-[#4A5F8C] sm:text-base">
                      {highlight}
                    </li>
                  ))}
                </ul>

                <p class="mt-6 text-sm leading-relaxed text-[#4A5F8C] sm:text-base">
                  Built for steady output, safety, and dependable industrial
                  supply.
                </p>
              </div>
            </article>
          ))
        }
      </div>
    </div>
  </section>
</MainLayout>
