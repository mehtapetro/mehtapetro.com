---
import MainLayout from '@/layouts/MainLayout.astro';
import { Image } from 'astro:assets';
import { SITE } from '@data/constants';
import facilityImageOne from '@images/dahej.jpeg';
import facilityImageTwo from '@images/dahej_2.jpeg';

const pageTitle = `Capabilities | ${SITE.title}`;
const metaDescription =
  'Explore the core capabilities of Mehta Petro-Refineries Limited, including manufacturing, quality-focused supply, and reliable industrial support.';
const ogTitle = 'Capabilities | Mehta Petro';

const facilities = [
  {
    id: 'palghar',
    title: 'Palghar Facility',
    location: 'Palghar, Maharashtra',
    image: facilityImageOne,
    alt: 'Manufacturing facility at Palghar, Maharashtra',
    summary:
      'Our Palghar facility handles distillation, blending, and storage with comprehensive safety systems and utility infrastructure.',
    points: [
      '1400 KL/Month continuous distillation plant',
      '600 KL/Month reaction vessel with vacuum facilities',
      '10 lakh KCAL/HRS thermic fluid heater',
      '04 lakh KCAL/HRS thermic fluid heater',
      'Cooling tower for condensation',
      'Blending tank with high speed stirrer',
      'Water softener & compressor',
      'Diesel generator set',
      'Fire hydrant system with 2 lakh liters water storage',
      '1500 KL storage facilities with overhead & underground tanks',
    ],
  },
  {
    id: 'dahej',
    title: 'Dahej Facility',
    location: 'Dahej, Gujarat',
    image: facilityImageTwo,
    alt: 'Manufacturing facility at Dahej, Gujarat',
    summary:
      'Our Dahej facility features high-capacity vacuum distillation, catalytic processing, and SCADA-integrated operations.',
    points: [
      '5000 KL/Month continuous distillation plant under vacuum',
      '1200 KL/Month catalytic process plant',
      '20 lakh KCAL/HRS coal fire thermic fluid heater',
      'Blending facility — 06 units (10 KL each)',
      'Water softener & cooling tower',
      'Compressor & fire hydrant system',
      '4500 KL storage facilities with overhead tanks',
      '100 MT fully electronic weigh bridge',
      'SCADA integrated plant operations',
    ],
  },
];
---

<MainLayout
  title={pageTitle}
  customDescription={metaDescription}
  customOgTitle={ogTitle}
  structuredData={{
    '@context': 'https://schema.org',
    '@type': 'WebPage',
    '@id': 'https://mehtapetro.com/capabilities',
    url: 'https://mehtapetro.com/capabilities',
    name: 'Capabilities | Mehta Petro',
    description: metaDescription,
    inLanguage: 'en-US',
  }}
>
  <!-- Hero Section -->
  <section
    class="mx-auto mt-10 max-w-[85rem] px-4 py-10 sm:px-6 lg:px-8 lg:py-14"
  >
    <div class="text-center">
      <span
        class="inline-flex rounded-full border border-[#C0D6FF] bg-white px-4 py-1 text-xs font-semibold tracking-wider text-[#0039E6] uppercase"
      >
        Capabilities
      </span>
      <h1
        class="mx-auto mt-6 max-w-4xl text-4xl font-extrabold tracking-tight text-balance text-[#0A1F4D] md:text-5xl"
      >
        Two Manufacturing Facilities Ready to Serve Your Industrial Needs
      </h1>
      <p class="mx-auto mt-5 max-w-3xl text-base sm:text-lg leading-relaxed text-[#4A5F8C]">
        We operate modern facilities in Palghar, Maharashtra and Dahej, Gujarat—equipped with distillation plants, storage infrastructure, and process control systems to deliver petrochemical products reliably.
      </p>

      <!-- Stats Cards -->
      <div class="mx-auto mt-10 grid max-w-4xl gap-6 sm:grid-cols-2 lg:grid-cols-3">
        <div class="rounded-2xl border border-[#D4E4FF] bg-white p-6 shadow-lg">
          <div class="text-5xl font-extrabold text-[#0039E6]">2</div>
          <p class="mt-3 text-base font-bold text-[#0A1F4D]">
            Manufacturing Facilities
          </p>
          <p class="mt-2 text-sm text-[#4A5F8C]">
            Strategic locations in Maharashtra & Gujarat
          </p>
        </div>

        <div class="rounded-2xl border border-[#D4E4FF] bg-white p-6 shadow-lg">
          <div class="text-5xl font-extrabold text-[#0039E6]">6400+</div>
          <p class="mt-3 text-base font-bold text-[#0A1F4D]">
            KL Monthly Capacity
          </p>
          <p class="mt-2 text-sm text-[#4A5F8C]">
            Combined distillation and processing
          </p>
        </div>

        <div class="rounded-2xl border border-[#D4E4FF] bg-white p-6 shadow-lg sm:col-span-2 lg:col-span-1">
          <div class="text-5xl font-extrabold text-[#0039E6]">6000</div>
          <p class="mt-3 text-base font-bold text-[#0A1F4D]">
            KL Storage
          </p>
          <p class="mt-2 text-sm text-[#4A5F8C]">
            Overhead and underground tank facilities
          </p>
        </div>
      </div>

      <div class="mt-10">
        <a
          href="/contact"
          class="inline-flex items-center justify-center rounded-xl bg-[#0039E6] px-7 py-4 text-base font-semibold text-white shadow-lg transition-all hover:bg-[#0033CC] hover:shadow-xl"
        >
          Contact Our Team
        </a>
      </div>
    </div>
  </section>

  <!-- Facilities Details -->
  <section class="mx-auto max-w-[85rem] px-4 py-10 sm:px-6 lg:px-8 lg:py-14">
    <div class="mb-10 text-center">
      <h2 class="text-3xl font-bold text-[#0A1F4D] md:text-4xl">
        Our Facilities
      </h2>
      <p class="mx-auto mt-4 max-w-2xl text-base leading-relaxed text-[#4A5F8C]">
        Each facility is equipped with modern equipment, safety systems, and quality control to ensure consistent product delivery.
      </p>
    </div>

    <div class="grid gap-8 lg:grid-cols-2">
      {
        facilities.map((facility, facilityIndex) => (
          <article
            id={facility.id}
            class="overflow-hidden rounded-2xl border border-[#D4E4FF] bg-white shadow-lg"
          >
            <div class="overflow-hidden">
              <Image
                src={facility.image}
                alt={facility.alt}
                class="h-72 w-full object-cover"
              />
            </div>
            <div class="p-6 sm:p-8">
              <div class="flex flex-wrap items-center gap-3">
                <span class="text-xs font-semibold tracking-wider text-[#0039E6] uppercase">
                  Facility {facilityIndex + 1}
                </span>
                <span class="inline-flex rounded-full bg-[#E8F0FF] px-3 py-1 text-xs font-semibold text-[#0A1F4D]">
                  {facility.points.length} Key Installations
                </span>
              </div>
              <h3 class="mt-4 text-2xl font-bold text-[#0A1F4D]">
                {facility.title}
              </h3>
              <p class="mt-1 text-base font-medium text-[#4A5F8C]">
                {facility.location}
              </p>
              <p class="mt-4 text-base leading-relaxed text-[#4A5F8C]">
                {facility.summary}
              </p>

              <div class="mt-6 space-y-3">
                {facility.points.map((point, index) => (
                  <div class="flex items-start gap-3 border-t border-[#E8F0FF] pt-3 first:border-t-0 first:pt-0">
                    <span class="inline-flex h-8 w-8 shrink-0 items-center justify-center rounded-full bg-[#E8F0FF] text-xs font-bold text-[#0039E6]">
                      {String(index + 1).padStart(2, '0')}
                    </span>
                    <span class="pt-1 text-sm leading-relaxed text-[#4A5F8C]">
                      {point}
                    </span>
                  </div>
                ))}
              </div>
            </div>
          </article>
        ))
      }
    </div>

    <div class="mt-10 text-center">
      <a
        href="/contact"
        class="inline-flex items-center justify-center rounded-xl border-2 border-[#D4E4FF] bg-white px-7 py-4 text-base font-semibold text-[#0039E6] transition-all hover:border-[#0039E6] hover:bg-[#F5F9FF]"
      >
        Enquire About Our Facilities
      </a>
    </div>
  </section>
</MainLayout>
