---
import MainLayout from '@/layouts/MainLayout.astro';
import { Image } from 'astro:assets';
import { SITE } from '@data/constants';
import aboutImage from '@images/about.jpeg';
import directorImage from '@images/md/vinodmehta.avif';
import ecovadisUrl from '@images/Ecovadis.png?url';

const pageTitle = `About Us | ${SITE.title}`;
const metaDescription =
  'Learn about Mehta Petro-Refineries Limited — our mission, vision, values, and leadership since 1993 in petrochemical solvents and specialty base oils.';
const ogTitle = pageTitle;

const proofPoints = [
  {
    value: '33+',
    label: 'Years of Experience',
    detail: 'Trusted since 1993',
  },
  {
    value: '2',
    label: 'Manufacturing Units',
    detail: 'Palghar & Dahej',
  },
  {
    value: 'ISO',
    label: 'Quality Certified',
    detail: 'ISO 9001:2015',
  },
];

const principles = [
  {
    title: 'Our Mission',
    body: 'Serving society through science by delivering quality chemical solutions that support industrial progress and sustainable development.',
  },
  {
    title: 'Our Vision',
    body: 'To be a leading sustainable chemistry solutions company recognized for innovation, reliability, and responsible operations.',
  },
  {
    title: 'Our Values',
    body: 'Safety, Passion, Integrity, Care, and Excellence guide everything we do.',
  },
];

const sustainabilityFocus = [
  {
    title: 'Climate Action',
    body: 'Reducing greenhouse gas emissions',
  },
  {
    title: 'Energy Efficiency',
    body: 'Optimizing operational energy use',
  },
  {
    title: 'Water Stewardship',
    body: 'Responsible water usage & treatment',
  },
  {
    title: 'Waste Management',
    body: 'Reduction, reuse, and recycling',
  },
  {
    title: 'Air Quality',
    body: 'Monitoring & controlling emissions',
  },
  {
    title: 'Community Care',
    body: 'Supporting local wellbeing',
  },
];
---

<MainLayout
  title={pageTitle}
  customDescription={metaDescription}
  customOgTitle={ogTitle}
  fullWidth
  overlayNav
  structuredData={{
    '@context': 'https://schema.org',
    '@type': 'AboutPage',
    '@id': `${SITE.url}/about-us`,
    url: `${SITE.url}/about-us`,
    name: pageTitle,
    description: metaDescription,
    inLanguage: 'en-US',
  }}
>
  <!-- Hero -->
  <section
    class="relative flex min-h-[560px] flex-col overflow-hidden bg-[#07142F] sm:min-h-[640px] lg:min-h-[720px]"
  >
    <Image
      src={aboutImage}
      alt=""
      class="absolute inset-0 h-full w-full object-cover"
      widths={[960, 1440, 1920]}
      sizes="100vw"
      loading="eager"
      fetchpriority="high"
      aria-hidden="true"
    />
    <div
      class="pointer-events-none absolute inset-0 bg-linear-to-br from-[#061022]/70 via-[#091126]/55 to-[#0C1C4C]/50"
      aria-hidden="true"
    >
    </div>
    <div
      class="pointer-events-none absolute inset-0 bg-[radial-gradient(circle_at_top_left,rgba(255,255,255,0.14),transparent_36%),radial-gradient(circle_at_bottom_right,rgba(0,57,230,0.28),transparent_30%)]"
      aria-hidden="true"
    >
    </div>

    <div
      class="relative z-10 mx-auto flex w-full max-w-[85rem] flex-1 flex-col justify-end px-4 pt-28 pb-16 sm:px-6 sm:pt-32 sm:pb-20 lg:px-8 lg:pb-24"
    >
      <p
        class="text-xs font-semibold tracking-[0.2em] text-[#8EC5FF] uppercase sm:text-sm"
      >
        About Us
      </p>
      <h1
        class="mt-4 max-w-4xl text-4xl font-extrabold tracking-tight text-balance text-white sm:text-5xl md:text-6xl"
      >
        Serving Society through Science
      </h1>
      <p
        class="mt-5 max-w-2xl text-base leading-relaxed text-white/86 sm:text-lg"
      >
        Since 1993, we've delivered quality petrochemical products to industries
        across India—built on experience, integrity, and commitment to our
        customers.
      </p>
    </div>

    <div
      class="pointer-events-none absolute inset-x-0 bottom-0 h-20 bg-linear-to-t from-[#E8F0FF] to-transparent"
      aria-hidden="true"
    >
    </div>
  </section>

  <!-- Who We Are -->
  <section class="mx-auto max-w-[85rem] px-4 py-14 sm:px-6 lg:px-8 lg:py-20">
    <div class="max-w-3xl">
      <h2 class="text-3xl font-bold tracking-tight text-[#0A1F4D] md:text-4xl">
        Who We Are
      </h2>
      <p class="mt-5 text-base leading-relaxed text-[#4A5F8C] sm:text-lg">
        Mehta Petro-Refineries Limited operates modern manufacturing facilities
        at Palghar (Maharashtra) and Dahej II (Gujarat). We supply petrochemical
        solvents, specialty base oils, n-paraffins, olefins, and specialty
        chemicals to diverse industries.
      </p>
    </div>

    <div
      class="mt-12 grid gap-8 border-y border-[#C0D6FF]/70 py-10 sm:grid-cols-3 sm:gap-0 sm:divide-x sm:divide-[#C0D6FF]/70"
    >
      {
        proofPoints.map(point => (
          <div class="sm:px-8 first:sm:pl-0 last:sm:pr-0">
            <p class="text-4xl font-extrabold tracking-tight text-[#0039E6] sm:text-5xl">
              {point.value}
            </p>
            <p class="mt-3 text-base font-bold text-[#0A1F4D]">{point.label}</p>
            <p class="mt-1 text-sm text-[#4A5F8C]">{point.detail}</p>
          </div>
        ))
      }
    </div>
  </section>

  <!-- Mission / Vision / Values -->
  <section class="bg-white/60">
    <div class="mx-auto max-w-[85rem] px-4 py-14 sm:px-6 lg:px-8 lg:py-20">
      <h2 class="text-3xl font-bold tracking-tight text-[#0A1F4D] md:text-4xl">
        What Guides Us
      </h2>
      <p
        class="mt-3 max-w-2xl text-base leading-relaxed text-[#4A5F8C] sm:text-lg"
      >
        Our mission, vision, and values shape how we manufacture, partner, and
        grow.
      </p>

      <div
        class="mt-12 grid gap-10 md:grid-cols-3 md:gap-0 md:divide-x md:divide-[#D4E4FF]"
      >
        {
          principles.map(item => (
            <div class="md:px-8 first:md:pl-0 last:md:pr-0">
              <h3 class="text-xl font-bold text-[#0A1F4D]">{item.title}</h3>
              <p class="mt-4 text-base leading-relaxed text-[#4A5F8C]">
                {item.body}
              </p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <!-- Leadership -->
  <section class="mx-auto max-w-[85rem] px-4 py-14 sm:px-6 lg:px-8 lg:py-20">
    <div
      class="grid items-center gap-10 lg:grid-cols-[minmax(0,0.85fr)_minmax(0,1.15fr)] lg:gap-16"
    >
      <div class="overflow-hidden rounded-2xl">
        <Image
          src={directorImage}
          alt="Mr. Vinod I. Mehta, Chairman & Director"
          class="aspect-[4/5] h-full w-full object-cover object-top sm:aspect-[3/4]"
          format="avif"
          widths={[480, 720, 960]}
          sizes="(min-width: 1024px) 36vw, 90vw"
          loading="lazy"
        />
      </div>

      <div>
        <p
          class="text-xs font-semibold tracking-[0.18em] text-[#0039E6] uppercase"
        >
          Leadership
        </p>
        <h2
          class="mt-3 text-3xl font-bold tracking-tight text-[#0A1F4D] md:text-4xl"
        >
          Mr. Vinod I. Mehta
        </h2>
        <p class="mt-2 text-base font-medium text-[#4A5F8C]">
          Chairman & Director
        </p>

        <p class="mt-6 text-base leading-relaxed text-[#4A5F8C] sm:text-lg">
          With over 45 years of experience in the petrochemicals industry, Mr.
          Mehta has led Mehta Petro-Refineries Limited since its incorporation.
          His entrepreneurial vision, dedication, and high ethical standards
          have guided the company through decades of growth and industry
          evolution.
        </p>
        <p class="mt-4 text-base leading-relaxed text-[#4A5F8C] sm:text-lg">
          Under his leadership, the company entered manufacturing over 30 years
          ago and successfully established products in the paints, inks, and
          agro industries—building lasting relationships with customers and
          suppliers alike.
        </p>

        <blockquote
          class="mt-8 border-l-2 border-[#0039E6] pl-5 text-lg leading-snug font-semibold text-[#0A1F4D]"
        >
          Strong values and ethical business practices are the foundation of how
          we work.
        </blockquote>
      </div>
    </div>
  </section>

  <!-- Sustainability -->
  <section class="bg-white/60">
    <div class="mx-auto max-w-[85rem] px-4 py-14 sm:px-6 lg:px-8 lg:py-20">
      <div
        class="flex flex-col gap-8 lg:flex-row lg:items-end lg:justify-between"
      >
        <div class="max-w-2xl">
          <h2
            class="text-3xl font-bold tracking-tight text-[#0A1F4D] md:text-4xl"
          >
            Sustainability
          </h2>
          <p class="mt-4 text-base leading-relaxed text-[#4A5F8C] sm:text-lg">
            We're committed to responsible operations through measurable
            environmental action across climate, energy, water, and waste
            management.
          </p>
        </div>
        <img
          src={ecovadisUrl}
          alt="EcoVadis certification badge"
          class="h-20 w-auto object-contain sm:h-24 lg:h-28"
          loading="lazy"
        />
      </div>

      <div class="mt-12 grid gap-x-10 gap-y-8 sm:grid-cols-2 lg:grid-cols-3">
        {
          sustainabilityFocus.map(item => (
            <div class="border-t border-[#D4E4FF] pt-5">
              <h3 class="text-base font-bold text-[#0A1F4D]">{item.title}</h3>
              <p class="mt-2 text-sm leading-relaxed text-[#4A5F8C]">
                {item.body}
              </p>
            </div>
          ))
        }
      </div>
    </div>
  </section>
</MainLayout>
