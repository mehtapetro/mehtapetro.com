---
import MainLayout from '@/layouts/MainLayout.astro';
import { Image } from 'astro:assets';
import { SITE } from '@data/constants';
import aboutImage from '@images/about.jpeg';
import directorImage from '@images/md/vinodmehta.avif';
import ecovadisUrl from '@images/Ecovadis.png?url';

const pageTitle = `About Us | ${SITE.title}`;
const metaDescription =
  "Learn more about Mehta Petro-Refineries Limited, including who we are, our mission, our vision, our values, and the director's message.";
const ogTitle = 'About Us | Mehta Petro';
---

<MainLayout
  title={pageTitle}
  customDescription={metaDescription}
  customOgTitle={ogTitle}
  structuredData={{
    '@context': 'https://schema.org',
    '@type': 'AboutPage',
    '@id': 'https://mehtapetro.com/about-us',
    url: 'https://mehtapetro.com/about-us',
    name: 'About Us | Mehta Petro',
    description: metaDescription,
    inLanguage: 'en-US',
  }}
>
  <!-- Hero Section -->
  <section
    class="mx-auto mt-10 max-w-[85rem] px-4 py-12 sm:px-6 lg:px-8 lg:py-16"
  >
    <div
      class="grid items-center gap-12 lg:grid-cols-2 lg:gap-16"
    >
      <div>
        <span
          class="inline-flex rounded-full border border-[#C0D6FF] bg-white px-4 py-1 text-xs font-semibold tracking-wider text-[#0039E6] uppercase"
        >
          About Us
        </span>
        <h1
          class="mt-6 text-4xl font-extrabold tracking-tight text-balance text-[#0A1F4D] md:text-5xl lg:text-5xl"
        >
          Serving Society through Science
        </h1>
        <p class="mt-6 max-w-2xl text-base sm:text-lg leading-relaxed text-[#4A5F8C]">
          Since 1993, we've been delivering quality petrochemical products to industries across India—built on decades of experience, integrity, and a commitment to our customers.
        </p>
      </div>
      <div
        class="overflow-hidden rounded-2xl border border-[#D4E4FF] bg-white p-3 shadow-lg"
      >
        <Image
          src={aboutImage}
          alt="Mehta Petro-Refineries Limited facility"
          class="h-full w-full rounded-xl object-cover"
        />
      </div>
    </div>
  </section>

  <!-- Who We Are -->
  <section class="mx-auto max-w-[85rem] px-4 py-10 sm:px-6 lg:px-8 lg:py-14">
    <div
      class="rounded-2xl border border-[#D4E4FF] bg-white p-6 shadow-lg sm:p-8 lg:p-10"
    >
      <div>
        <h2 class="text-3xl font-bold text-[#0A1F4D] md:text-4xl">Who We Are</h2>
        <p class="mt-4 max-w-3xl text-lg leading-relaxed text-[#4A5F8C]">
          Mehta Petro-Refineries Limited operates modern manufacturing facilities at Palghar (Maharashtra) and Dahej II (Gujarat). We supply petrochemical solvents, specialty base oils, n-paraffins, olefins, and specialty chemicals to diverse industries.
        </p>

        <div class="mt-10 grid gap-6 sm:grid-cols-3">
          <div class="rounded-2xl border border-[#D4E4FF] bg-white p-6 shadow-sm">
            <div class="text-5xl font-extrabold text-[#0039E6]">33+</div>
            <p class="mt-4 text-base font-bold text-[#0A1F4D]">Years of Experience</p>
            <p class="mt-2 text-sm text-[#4A5F8C]">Trusted since 1993</p>
          </div>
          <div class="rounded-2xl border border-[#D4E4FF] bg-white p-6 shadow-sm">
            <div class="text-5xl font-extrabold text-[#0039E6]">2</div>
            <p class="mt-4 text-base font-bold text-[#0A1F4D]">Manufacturing Units</p>
            <p class="mt-2 text-sm text-[#4A5F8C]">Palghar & Dahej facilities</p>
          </div>
          <div class="rounded-2xl border border-[#D4E4FF] bg-white p-6 shadow-sm">
            <div class="flex items-center gap-2">
              <svg class="h-8 w-8 text-[#0039E6]" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" />
              </svg>
              <span class="text-3xl font-extrabold text-[#0039E6]">ISO</span>
            </div>
            <p class="mt-4 text-base font-bold text-[#0A1F4D]">Quality Certified</p>
            <p class="mt-2 text-sm text-[#4A5F8C]">ISO 9001:2015</p>
          </div>
        </div>

        <div class="mt-12 border-t border-[#E3EBFF] pt-10">
          <div class="grid gap-8 md:grid-cols-3">
            <div>
              <h3 class="text-xl font-bold text-[#0A1F4D]">Our Mission</h3>
              <p class="mt-3 text-base leading-relaxed text-[#4A5F8C]">
                Serving society through science by delivering quality chemical solutions that support industrial progress and sustainable development.
              </p>
            </div>
            <div>
              <h3 class="text-xl font-bold text-[#0A1F4D]">Our Vision</h3>
              <p class="mt-3 text-base leading-relaxed text-[#4A5F8C]">
                To be a leading sustainable chemistry solutions company recognized for innovation, reliability, and responsible operations.
              </p>
            </div>
            <div>
              <h3 class="text-xl font-bold text-[#0A1F4D]">Our Values</h3>
              <p class="mt-3 text-base leading-relaxed text-[#4A5F8C]">
                Safety, Passion, Integrity, Care, and Excellence guide everything we do.
              </p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Director's Message -->
  <section class="mx-auto max-w-[85rem] px-4 py-10 sm:px-6 lg:px-8 lg:py-14">
    <div
      class="grid items-center gap-8 rounded-2xl border border-[#D4E4FF] bg-white p-6 shadow-lg sm:p-8 lg:grid-cols-[minmax(0,0.7fr)_minmax(0,1.3fr)] lg:gap-10 lg:p-10"
    >
      <div
        class="overflow-hidden rounded-2xl border border-[#D4E4FF] bg-white p-2 shadow-md"
      >
        <Image
          src={directorImage}
          alt="Mr. Vinod I. Mehta, Chairman & Director"
          class="h-full w-full rounded-xl object-cover"
          format="avif"
        />
      </div>
      <div>
        <span class="text-xs font-semibold tracking-wider text-[#0039E6] uppercase">
          Leadership
        </span>
        <h2 class="mt-3 text-3xl font-bold text-[#0A1F4D] md:text-4xl lg:text-4xl">
          Mr. Vinod I. Mehta
        </h2>
        <p class="mt-2 text-base font-medium text-[#4A5F8C]">
          Chairman & Director
        </p>
        
        <p class="mt-5 text-base leading-relaxed text-[#4A5F8C]">
          With over 45 years of experience in the petrochemicals industry, Mr. Mehta has led Mehta Petro-Refineries Limited since its incorporation. His entrepreneurial vision, dedication, and high ethical standards have guided the company through decades of growth and industry evolution.
        </p>
        <p class="mt-4 text-base leading-relaxed text-[#4A5F8C]">
          Under his leadership, the company entered manufacturing over 30 years ago and successfully established products in the paints, inks, and agro industries—building lasting relationships with customers and suppliers alike.
        </p>

        <div class="mt-6 flex items-center gap-3 rounded-xl border border-[#D4E4FF] bg-[#F5F9FF] p-4">
          <svg class="h-6 w-6 shrink-0 text-[#0039E6]" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4M7.835 4.697a3.42 3.42 0 001.946-.806 3.42 3.42 0 014.438 0 3.42 3.42 0 001.946.806 3.42 3.42 0 013.138 3.138 3.42 3.42 0 00.806 1.946 3.42 3.42 0 010 4.438 3.42 3.42 0 00-.806 1.946 3.42 3.42 0 01-3.138 3.138 3.42 3.42 0 00-1.946.806 3.42 3.42 0 01-4.438 0 3.42 3.42 0 00-1.946-.806 3.42 3.42 0 01-3.138-3.138 3.42 3.42 0 00-.806-1.946 3.42 3.42 0 010-4.438 3.42 3.42 0 00.806-1.946 3.42 3.42 0 013.138-3.138z" />
          </svg>
          <div>
            <p class="text-sm font-semibold text-[#0A1F4D]">Core Principle</p>
            <p class="mt-0.5 text-sm text-[#4A5F8C]">Strong values and ethical business practices</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Sustainability -->
  <section class="mx-auto max-w-[85rem] px-4 py-10 sm:px-6 lg:px-8 lg:py-14">
    <div class="rounded-2xl border border-[#D4E4FF] bg-white p-6 shadow-lg sm:p-8 lg:p-10">
      <div class="flex flex-col gap-6 sm:flex-row sm:items-start sm:justify-between">
        <div class="max-w-2xl">
          <h2 class="text-3xl font-bold text-[#0A1F4D] md:text-4xl lg:text-4xl">Sustainability</h2>
          <p class="mt-4 text-base sm:text-lg leading-relaxed text-[#4A5F8C]">
            We're committed to responsible operations through measurable environmental action across climate, energy, water, and waste management.
          </p>
        </div>
        <div class="shrink-0">
          <img src={ecovadisUrl} alt="EcoVadis certification badge" class="h-24 w-auto object-contain sm:h-28 lg:h-32" loading="lazy" />
        </div>
      </div>

      <div class="mt-10 grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
        <div class="flex gap-4 rounded-xl border border-[#D4E4FF] bg-white p-5 shadow-sm">
          <svg class="h-6 w-6 shrink-0 text-[#0039E6]" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <circle cx="12" cy="12" r="4" stroke-width="2"></circle>
            <path stroke-width="2" d="M12 2.5v3M12 18.5v3M21.5 12h-3M5.5 12h-3M18.72 5.28l-2.12 2.12M7.4 16.6l-2.12 2.12M18.72 18.72l-2.12-2.12M7.4 7.4L5.28 5.28"></path>
          </svg>
          <div>
            <p class="text-sm font-semibold text-[#0A1F4D]">Climate Action</p>
            <p class="mt-1 text-sm text-[#4A5F8C]">Reducing greenhouse gas emissions</p>
          </div>
        </div>

        <div class="flex gap-4 rounded-xl border border-[#D4E4FF] bg-white p-5 shadow-sm">
          <svg class="h-6 w-6 shrink-0 text-[#0039E6]" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-width="2" d="M13 3L4 14h7v7l9-11h-7V3z"/>
          </svg>
          <div>
            <p class="text-sm font-semibold text-[#0A1F4D]">Energy Efficiency</p>
            <p class="mt-1 text-sm text-[#4A5F8C]">Optimizing operational energy use</p>
          </div>
        </div>

        <div class="flex gap-4 rounded-xl border border-[#D4E4FF] bg-white p-5 shadow-sm">
          <svg class="h-6 w-6 shrink-0 text-[#0039E6]" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-width="2" d="M12 2s5 4 5 8a5 5 0 11-10 0c0-4 5-8 5-8z"/>
          </svg>
          <div>
            <p class="text-sm font-semibold text-[#0A1F4D]">Water Stewardship</p>
            <p class="mt-1 text-sm text-[#4A5F8C]">Responsible water usage & treatment</p>
          </div>
        </div>

        <div class="flex gap-4 rounded-xl border border-[#D4E4FF] bg-white p-5 shadow-sm">
          <svg class="h-6 w-6 shrink-0 text-[#0039E6]" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-width="2" d="M3 8h12M7 12h11M5 16h9"/>
          </svg>
          <div>
            <p class="text-sm font-semibold text-[#0A1F4D]">Waste Management</p>
            <p class="mt-1 text-sm text-[#4A5F8C]">Reduction, reuse, and recycling</p>
          </div>
        </div>

        <div class="flex gap-4 rounded-xl border border-[#D4E4FF] bg-white p-5 shadow-sm">
          <svg class="h-6 w-6 shrink-0 text-[#0039E6]" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-width="2" d="M8 7h8l2 3-2 3H8L6 10l2-3zm-3 8h14m-12 3h10"/>
          </svg>
          <div>
            <p class="text-sm font-semibold text-[#0A1F4D]">Air Quality</p>
            <p class="mt-1 text-sm text-[#4A5F8C]">Monitoring & controlling emissions</p>
          </div>
        </div>

        <div class="flex gap-4 rounded-xl border border-[#D4E4FF] bg-white p-5 shadow-sm">
          <svg class="h-6 w-6 shrink-0 text-[#0039E6]" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-width="2" d="M4.318 6.318a4.5 4.5 0 016.364 0L12 7.636l1.318-1.318a4.5 4.5 0 116.364 6.364L12 20.682l-7.682-7.999a4.5 4.5 0 010-6.365z"/>
          </svg>
          <div>
            <p class="text-sm font-semibold text-[#0A1F4D]">Community Care</p>
            <p class="mt-1 text-sm text-[#4A5F8C]">Supporting local wellbeing</p>
          </div>
        </div>
      </div>
    </div>
  </section>
</MainLayout>
